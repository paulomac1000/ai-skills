{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-skills:contracts:adoption-assessment:1",
  "title": "AI Skills adoption assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "verification_mode", "assessment_id", "generated_at",
    "prepared_by", "repository", "skill", "scope", "compatibility_claims",
    "applicability", "behavior", "waivers", "artifact_verification",
    "compatibility_results", "extensions", "rollback", "residual_risks", "decision"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "verification_mode": {"enum": ["structural-attestation", "provider-backed"]},
    "assessment_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "generated_at": {"type": "string", "format": "date-time"},
    "prepared_by": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/actor"}
    },
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "revision", "source_branch"],
      "properties": {
        "name": {"$ref": "#/$defs/repositoryName"},
        "revision": {"$ref": "#/$defs/revision"},
        "source_branch": {"type": "string", "minLength": 1}
      }
    },
    "skill": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "maturity"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
        "maturity": {"enum": ["stable", "candidate", "experimental", "deprecated"]}
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["included", "excluded", "exclusion_rationale"],
      "properties": {
        "included": {"$ref": "#/$defs/stringArray"},
        "excluded": {"$ref": "#/$defs/stringArray"},
        "exclusion_rationale": {"$ref": "#/$defs/stringArray"}
      }
    },
    "rule_context": {
      "type": "object", "additionalProperties": false,
      "required": ["target_level", "profiles", "capabilities"],
      "properties": {
        "target_level": {"enum": ["L1", "L2", "L3", "L4"]},
        "profiles": {"$ref": "#/$defs/tokenArray"},
        "capabilities": {"$ref": "#/$defs/tokenArray"}
      }
    },
    "compatibility_claims": {
      "type": "object", "additionalProperties": false,
      "required": ["combinations"],
      "properties": {"combinations": {"type": "array", "items": {"$ref": "#/$defs/compatibility"}}}
    },
    "applicability": {
      "type": "array",
      "items": {"$ref": "#/$defs/ruleAssessment"}
    },
    "behavior": {
      "type": "object", "additionalProperties": false,
      "required": ["preserved", "intentionally_changed", "removed_legacy"],
      "properties": {
        "preserved": {"$ref": "#/$defs/stringArray"},
        "intentionally_changed": {"$ref": "#/$defs/stringArray"},
        "removed_legacy": {"$ref": "#/$defs/stringArray"}
      }
    },
    "waivers": {"type": "array", "items": {"$ref": "#/$defs/waiver"}},
    "artifact_verification": {
      "type": "object", "additionalProperties": false,
      "required": ["exact_revision", "artifacts"],
      "properties": {
        "exact_revision": {"$ref": "#/$defs/revision"},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}
      }
    },
    "compatibility_results": {"type": "array", "items": {"$ref": "#/$defs/compatibilityResult"}},
    "extensions": {"type": "object", "additionalProperties": true},
    "rollback": {
      "type": "object", "additionalProperties": false,
      "required": ["trigger_conditions", "procedure", "data_recovery"],
      "properties": {
        "trigger_conditions": {"$ref": "#/$defs/stringArray"},
        "procedure": {"$ref": "#/$defs/stringArray"},
        "data_recovery": {"$ref": "#/$defs/stringArray"}
      }
    },
    "residual_risks": {"type": "array", "items": {"type": ["string", "object"]}},
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "rationale", "reviewer"],
      "properties": {
        "status": {"enum": ["approve", "request-changes", "reject"]},
        "rationale": {"type": "string", "minLength": 1},
        "reviewer": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/reviewer"}]}
      }
    }
  },
  "$defs": {
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "repositoryName": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "stringArray": {"type": "array", "items": {"type": "string"}},
    "tokenArray": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}
    },
    "actor": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "login", "id"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "login": {"type": "string", "minLength": 1},
        "id": {"type": "integer", "minimum": 1}
      }
    },
    "reviewer": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "repository", "pull_request", "review_id", "login", "id", "revision", "state"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "repository": {"$ref": "#/$defs/repositoryName"},
        "pull_request": {"type": "integer", "minimum": 1},
        "review_id": {"type": "integer", "minimum": 1},
        "login": {"type": "string", "minLength": 1},
        "id": {"type": "integer", "minimum": 1},
        "revision": {"$ref": "#/$defs/revision"},
        "state": {"enum": ["APPROVED", "CHANGES_REQUESTED", "COMMENTED", "DISMISSED", "PENDING"]}
      }
    },
    "implementation": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "symbol"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "symbol": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": true,
      "required": ["provider", "repository", "revision"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "repository": {"$ref": "#/$defs/repositoryName"},
        "revision": {"$ref": "#/$defs/revision"},
        "report_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "provider_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["command", "evidence", "result"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "evidence": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/evidence"}]},
        "result": {"enum": ["passed", "failed", "not-run", "not-applicable"]}
      }
    },
    "ruleAssessment": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "status", "rationale", "implementation", "verification", "waiver_id"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["applicable", "not-applicable", "deferred"]},
        "rationale": {"type": "string", "minLength": 1},
        "implementation": {"type": "array", "items": {"$ref": "#/$defs/implementation"}},
        "verification": {"type": "array", "items": {"$ref": "#/$defs/verification"}},
        "waiver_id": {"type": ["string", "null"]}
      }
    },
    "waiver": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "rule_id", "owner", "expires", "compensating_controls", "removal_condition"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "rule_id": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "expires": {"type": "string", "format": "date"},
        "compensating_controls": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "removal_condition": {"type": "string", "minLength": 1}
      }
    },
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["operating_system", "architecture", "runtime", "version", "lane"],
      "properties": {
        "operating_system": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "runtime": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "lane": {"type": "string", "minLength": 1}
      }
    },
    "compatibilityResult": {
      "allOf": [
        {"$ref": "#/$defs/compatibility"},
        {
          "type": "object",
          "required": ["command", "evidence", "result"],
          "properties": {
            "command": {"type": "string", "minLength": 1},
            "evidence": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/evidence"}]},
            "result": {"enum": ["passed", "failed", "not-run", "not-applicable"]}
          }
        }
      ]
    },
    "artifact": {
      "type": "object", "additionalProperties": true,
      "required": ["kind", "identity", "path", "digest", "commands", "evidence", "result"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "identity": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "commands": {"$ref": "#/$defs/stringArray"},
        "evidence": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/evidence"}]},
        "result": {"enum": ["passed", "failed", "not-run", "not-applicable"]}
      }
    }
  }
}
