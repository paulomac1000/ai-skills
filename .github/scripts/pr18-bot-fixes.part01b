,
+    )
+    args = parser.parse_args()
+    findings = audit_repository(args.repository_root)
+    if findings:
+        for finding in findings:
+            print(f"ERROR: {finding.render()}")
+        return 1
+    print("GitHub Actions policy: PASS")
+    return 0
 
 
 if __name__ == "__main__":
