schema_version: 1
policy_id: __POLICY_ID__
slots:
  - id: primary
    provider: __PROVIDER__
    principal_scope: __PRINCIPAL_SCOPE__
    priority: 10
fallback:
  max_transitions: 1
  allowed_failure_classes: [rate-limit, quota-exhausted, credential-unavailable]
  forbidden_failure_classes: [authorization-denied, policy-denied, safety-denied, target-forbidden, delivery-unknown]
  require_equivalent_principal_scope: true
  require_same_target: true
  require_replay_safe: true
provider_model_substitution:
  enabled: false
  policy_revision_required: true
secrets:
  persist_values: false
  expose_to_model: false
