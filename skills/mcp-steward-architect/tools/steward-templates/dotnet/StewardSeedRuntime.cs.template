internal sealed class SeedPolicy
{
    public required int ProfileRevision { get; init; }
    public required string RecipeId { get; init; }
    public required int ProofRevision { get; init; }
    public required IReadOnlyList<SeedRequirement> Requirements { get; init; }
    public required IReadOnlyDictionary<string, SeedProducer> Producers { get; init; }
    public required IReadOnlyDictionary<string, SeedMutationEffect> Effects { get; init; }
    public required SeedCapability Capability { get; init; }
    public required string RecipeDigest { get; init; }
    public required bool SupervisedRequired { get; init; }
    public StewardParentContractSnapshot? ConfiguredParentContract { get; init; }

    private static string CapabilityDigest(JsonElement capability)
    {
        if (capability.ValueKind != JsonValueKind.Object || !capability.TryGetProperty("contract", out var contractElement))
            throw new InvalidOperationException("capability contract is required");
        if (contractElement.ValueKind != JsonValueKind.Object
            || !contractElement.TryGetProperty("digest_semantics", out var semanticsElement)
            || semanticsElement.ValueKind != JsonValueKind.String
            || !string.Equals(semanticsElement.GetString(), "capability-semantic-v1", StringComparison.Ordinal))
            throw new InvalidOperationException("capability digest semantics version is unsupported");
        using var stream = new MemoryStream();
        using (var writer = new Utf8JsonWriter(stream, new JsonWriterOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping }))
            WriteCapabilityCanonical(writer, capability, insideContract: false);
        return "sha256:" + Convert.ToHexStringLower(SHA256.HashData(stream.ToArray()));
    }

    internal static string CapabilityDigestForVectors(JsonElement capability) => CapabilityDigest(capability);

    private static StewardParentContractSnapshot? ParseConfiguredParentContract(JsonElement profile)
    {
        if (!profile.TryGetProperty("parent_contract", out var configured) || configured.ValueKind != JsonValueKind.Object) return null;
        var budget = configured.GetProperty("budget");
        return new StewardParentContractSnapshot(
            "supervised",
            configured.GetProperty("system_id").GetString()!,
            configured.GetProperty("work_id").GetString()!,
            configured.GetProperty("run_id").GetString()!,
            configured.GetProperty("generation").GetInt64(),
            $"{configured.GetProperty("system_id").GetString()}:{configured.GetProperty("work_id").GetString()}",
            configured.GetProperty("contract_revision").GetInt64().ToString(System.Globalization.CultureInfo.InvariantCulture),
            configured.GetProperty("contract_digest").GetString()!,
            configured.GetProperty("delegated_capabilities").EnumerateArray().Select(item => item.GetString()!).ToArray(),
            configured.GetProperty("forbidden_capabilities").EnumerateArray().Select(item => item.GetString()!).ToArray(),
            configured.GetProperty("parent_completion_authority").GetString()!,
            configured.GetProperty("authority_ceiling").GetString()!,
            configured.GetProperty("deadline_at").GetDateTimeOffset());
    }

    private static string CriterionDigest(JsonElement criterion)
    {
        using var stream = new MemoryStream();
        using (var writer = new Utf8JsonWriter(stream, new JsonWriterOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping }))
        {
            writer.WriteStartObject();
            writer.WritePropertyName("approved_producers");
            writer.WriteStartArray();
            foreach (var item in criterion.GetProperty("approved_producers").EnumerateArray()) writer.WriteStringValue(item.GetString());
            writer.WriteEndArray();
            writer.WritePropertyName("binding_requirements");
            writer.WriteStartArray();
            foreach (var item in criterion.GetProperty("binding_requirements").EnumerateArray()) writer.WriteStringValue(item.GetString());
            writer.WriteEndArray();
            foreach (var (name, kind) in new[] { ("canonical_claim", JsonValueKind.String), ("candidate_binding_required", JsonValueKind.True), ("coverage_semantics", JsonValueKind.String), ("freshness_seconds", JsonValueKind.Number), ("required_authority", JsonValueKind.String) })
            {
                if (!criterion.TryGetProperty(name, out var value)) continue;
                writer.WritePropertyName(name);
                if (value.ValueKind == JsonValueKind.True || value.ValueKind == JsonValueKind.False) writer.WriteBooleanValue(value.GetBoolean());
                else if (value.ValueKind == JsonValueKind.Number) writer.WriteNumberValue(value.GetRawText().Contains('.') ? value.GetDouble() : value.GetInt64());
                else value.WriteTo(writer);
            }
            writer.WriteEndObject();
        }
        return "sha256:" + Convert.ToHexStringLower(SHA256.HashData(stream.ToArray()));
    }

    private static void WriteCapabilityCanonical(Utf8JsonWriter writer, JsonElement value, bool insideContract)
    {
        if (value.ValueKind == JsonValueKind.Object)
        {
            writer.WriteStartObject();
            foreach (var property in value.EnumerateObject().OrderBy(item => item.Name, StringComparer.Ordinal))
            {
                if (insideContract && property.NameEquals("digest")) continue;
                writer.WritePropertyName(property.Name);
                WriteCapabilityCanonical(writer, property.Value, property.NameEquals("contract"));
            }
            writer.WriteEndObject();
            return;
        }
        if (value.ValueKind == JsonValueKind.Array)
        {
            writer.WriteStartArray();
            foreach (var item in value.EnumerateArray()) WriteCapabilityCanonical(writer, item, insideContract: false);
            writer.WriteEndArray();
            return;
        }
        value.WriteTo(writer);
    }

    public static SeedPolicy Load(string profilePath, string proofPath)
    {
        var root = Path.GetDirectoryName(Path.GetFullPath(profilePath)) ?? throw new InvalidOperationException("profile path has no directory");
        var mutationPath = Path.Combine(root, "steward_mutation_policy.json");
        var upstreamPath = Path.Combine(root, "steward_upstream_capability.json");
        using var profile = JsonDocument.Parse(File.ReadAllText(profilePath));
        using var proof = JsonDocument.Parse(File.ReadAllText(proofPath));
        using var mutation = JsonDocument.Parse(File.ReadAllText(mutationPath));
        using var upstream = JsonDocument.Parse(File.ReadAllText(upstreamPath));
        var producerMap = proof.RootElement.GetProperty("producers").EnumerateArray().ToDictionary(
            item => item.GetProperty("producer_id").GetString()!,
            item => new SeedProducer(
                item.GetProperty("producer_id").GetString()!, item.GetProperty("authority_ceiling").GetString()!,
                item.GetProperty("binding_requirements").EnumerateArray().Select(value => value.GetString()!).ToHashSet(StringComparer.Ordinal),
                item.GetProperty("subject_dimensions").EnumerateArray().Select(value => value.GetString()!).ToHashSet(StringComparer.Ordinal)),
            StringComparer.Ordinal);
        var criteria = proof.RootElement.GetProperty("criteria").EnumerateArray().ToDictionary(item => item.GetProperty("criterion_id").GetString()!, item => item.Clone(), StringComparer.Ordinal);
        var requirements = new List<SeedRequirement>();
        foreach (var obligation in profile.RootElement.GetProperty("completion").GetProperty("obligations").EnumerateArray())
        {
            var id = obligation.GetProperty("id").GetString()!;
            if (!criteria.TryGetValue(id, out var criterion)) throw new InvalidOperationException($"proof recipe has no criterion for obligation {id}");
            requirements.Add(new(
                id, obligation.GetProperty("required").GetBoolean(), obligation.GetProperty("evidence_class").GetString()!,
                criterion.GetProperty("canonical_claim").GetString()!, criterion.GetProperty("required_authority").GetString()!,
                criterion.GetProperty("freshness_seconds").GetInt32(),
                criterion.GetProperty("approved_producers").EnumerateArray().Select(item => item.GetString()!).ToHashSet(StringComparer.Ordinal),
                criterion.GetProperty("binding_requirements").EnumerateArray().Select(item => item.GetString()!).ToArray(),
                criterion.GetProperty("coverage_semantics").GetString()!,
                CriterionDigest(criterion)));
        }
        var effects = mutation.RootElement.GetProperty("effects").EnumerateArray().ToDictionary(
            item => item.GetProperty("id").GetString()!,
            item => {
                var effectContract = item.GetProperty("capability_contract");
                var pinned = new SeedCapability(
                    effectContract.GetProperty("id").GetString()!, effectContract.GetProperty("source").GetString()!,
                    effectContract.GetProperty("revision").GetString()!, effectContract.GetProperty("digest").GetString()!);
                return new SeedMutationEffect(
                    item.GetProperty("id").GetString()!, item.GetProperty("operation_kind").GetString()!,
                    item.GetProperty("authority_source").GetString()!, item.GetProperty("lease_required").GetBoolean(),
                    item.GetProperty("candidate_required").GetBoolean(), item.GetProperty("capability_ref").GetString()!, pinned,
                    item.GetProperty("durable_operation_required").GetBoolean(), item.GetProperty("minimum_budget_ms").GetInt32(),
                    item.GetProperty("finalization_reserve_ms").GetInt32());
            }, StringComparer.Ordinal);
        var contract = upstream.RootElement.GetProperty("contract");
        var capability = new SeedCapability(
            upstream.RootElement.GetProperty("capability_id").GetString()!, contract.GetProperty("source").GetString()!,
            contract.GetProperty("revision").GetString()!, contract.GetProperty("digest").GetString()!);
        if (!string.Equals(contract.GetProperty("id").GetString(), capability.Id, StringComparison.Ordinal)
            || !string.Equals(CapabilityDigest(upstream.RootElement), capability.Digest, StringComparison.Ordinal))
            throw new InvalidOperationException("reviewed upstream capability semantic digest is invalid");
        var revision = proof.RootElement.GetProperty("revision").GetInt32();
        using var recipeStream = new MemoryStream();
        using (var recipeWriter = new Utf8JsonWriter(recipeStream, new JsonWriterOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping }))
            WriteCapabilityCanonical(recipeWriter, proof.RootElement, insideContract: false);
        var recipeDigest = "sha256:" + Convert.ToHexStringLower(SHA256.HashData(recipeStream.ToArray()));
        return new() {
            ProfileRevision = profile.RootElement.GetProperty("steward").GetProperty("contract_revision").GetInt32(),
            RecipeId = $"{proof.RootElement.GetProperty("recipe_id").GetString()}@{revision}", ProofRevision = revision,
            Requirements = requirements, Producers = producerMap, Effects = effects, Capability = capability,
            RecipeDigest = recipeDigest,
            SupervisedRequired = string.Equals(profile.RootElement.GetProperty("authority").GetProperty("parent_completion").GetString(), "explicit-contract-only", StringComparison.Ordinal),
            ConfiguredParentContract = ParseConfiguredParentContract(profile.RootElement),
        };
    }
}

public sealed class StewardSeedRuntime : IDisposable
{
    /// <summary>
    /// Canonical capability semantic digest (contract v1) used for golden-vector and
    /// cross-runtime agreement checks. The digest binds the complete reviewed capability
    /// document except contract.digest.
    /// </summary>
    public static string CapabilitySemanticDigest(JsonElement capability) => SeedPolicy.CapabilityDigestForVectors(capability);

    private static readonly HashSet<string> Terminal = ["completed", "completed-with-gaps", "failed", "cancelled", "superseded"];
    private static readonly HashSet<string> Runnable = ["queued", "reconciling", "waiting-external", "cancelling", "finalizing"];
    private static readonly Dictionary<string, int> AuthorityRank = new(StringComparer.Ordinal) { ["advisory"] = 0, ["observed"] = 1, ["verified"] = 2, ["independent"] = 3 };
    private static readonly HashSet<string> ObservationGrades = ["declared", "observed", "observed-effective", "functional-ready", "verified"];
    private readonly object _gate = new();
    private readonly string _snapshotPath;
    private readonly FileStream _ownerLock;
    private readonly ISeedClock _clock;
    private readonly ISeedProvider _provider;
    private readonly SeedFaultInjector _faults;
    private readonly SeedPolicy _policy;
    private StewardSeedState _state;
    private long _reconcileTick;

    public StewardSeedRuntime(ISeedClock clock, ISeedProvider provider, SeedFaultInjector faults)
        : this(Environment.GetEnvironmentVariable("STEWARD_STATE_DIR") ?? Path.Combine(AppContext.BaseDirectory, ".steward-state"), clock, provider, faults,
            Path.Combine(AppContext.BaseDirectory, "steward_profile.json"), Path.Combine(AppContext.BaseDirectory, "steward_proof_recipe.json")) { }

    public StewardSeedRuntime(string stateDirectory, ISeedClock clock, ISeedProvider provider, SeedFaultInjector faults, string profilePath, string proofPath)
    {
        Directory.CreateDirectory(stateDirectory);
        _snapshotPath = Path.Combine(stateDirectory, "steward-state.json");
        // Single-owner store ownership: a second server process on this directory is a
        // deployment topology mismatch and must be diagnosable as such, not surface as an
        // ordinary provider/application failure (#105).
        try
        {
            _ownerLock = new FileStream(Path.Combine(stateDirectory, "steward-state.lock"), FileMode.OpenOrCreate, FileAccess.ReadWrite, FileShare.None);
        }
        catch (IOException exc)
        {
            throw new InvalidOperationException("STORE_LOCKED / ownership conflict: another server process owns this single-owner store (topology mismatch)", exc);
        }
        _clock = clock; _provider = provider; _faults = faults;
        try
        {
            _policy = SeedPolicy.Load(profilePath, proofPath);
            _state = LoadOrQuarantine();
        }
        catch
        {
            // A constructor that fails closed must still release the single-owner lock.
            // Otherwise the failed instance can strand the state directory on Windows
            // even though no usable Steward runtime was ever returned to the caller.
            _ownerLock.Dispose();
            throw;
        }
    }

    public StewardAdmission Submit(string subjectId, string? subjectRevision, string idempotencyKey)
    {
        // The public tool surface passes no parent contract; a supervised profile binds
        // its CONFIGURED contract so public submissions are not blanket-rejected (#95).
        var configured = _policy.SupervisedRequired ? _policy.ConfiguredParentContract : null;
        if (_policy.SupervisedRequired && configured is null)
            throw new InvalidOperationException("ParentContractUnsupported: profile requires an admitted parent contract");
        return Submit(subjectId, subjectRevision, idempotencyKey, configured);
    }

    public StewardAdmission Submit(string subjectId, string? subjectRevision, string idempotencyKey, StewardParentContractSnapshot? parentContract)
    {
        if (string.IsNullOrWhiteSpace(idempotencyKey)) throw new ArgumentException("idempotencyKey is required", nameof(idempotencyKey));
        if (_policy.SupervisedRequired && parentContract is null)
            throw new InvalidOperationException("ParentContractUnsupported: profile requires an admitted parent contract");
        if (!_policy.SupervisedRequired && parentContract is not null)
            throw new InvalidOperationException("ParentContractUnsupported: standalone profile rejects a parent contract");
        if (parentContract is not null && parentContract.Mode != "supervised")
            throw new InvalidOperationException("ParentContractUnsupported: admitted parent contract must be supervised");
        if (parentContract is not null)
        {
            // Build one fully copied snapshot FIRST, then compute its digest from the
            // copy: a caller thread mutating its lists during admission can otherwise
            // make the persisted contract fail its own validation (#95).
            var copied = parentContract with
            {
                DelegatedCapabilities = parentContract.DelegatedCapabilities.ToArray(),
                ForbiddenCapabilities = parentContract.ForbiddenCapabilities.ToArray(),
            };
            parentContract = copied with { ContractDigest = ParentContractDigest(copied) };
        }
        var subject = new StewardSubject("target", subjectId, subjectRevision);
        var candidateBase = new { type = "subject-snapshot", id = subjectId, revision = subjectRevision };
        var candidate = new StewardCandidate("subject-snapshot", subjectId, subjectRevision, Digest(candidateBase));
        var requestDigest = Digest(new { subject, candidate });
        var lineageId = "lineage-" + Sha256Hex(JsonSerializer.SerializeToUtf8Bytes(new { type = subject.Type, id = subject.Id }))[..24];
        var obligationSet = BuildObligationSnapshot();
        lock (_gate)
        {
            var priorState = JsonSerializer.Deserialize<StewardSeedState>(JsonSerializer.Serialize(_state))
                ?? throw new InvalidOperationException("cannot snapshot Steward state");
            if (_state.Idempotency.TryGetValue(idempotencyKey, out var existing))
            {
                if (!string.Equals(existing.RequestDigest, requestDigest, StringComparison.Ordinal)) throw new InvalidOperationException("idempotency key is bound to a different request digest");
                var priorJob = _state.Jobs.GetValueOrDefault(existing.JobId);
                var priorParent = priorJob?.ParentContract?.ContractDigest;
                var wantedParent = parentContract?.ContractDigest;
                if (!string.Equals(priorParent ?? "", wantedParent ?? "", StringComparison.Ordinal))
                    throw new InvalidOperationException("ReAdmissionRequired: idempotency key is bound to a different parent contract generation");
                return new(existing.JobId, true);
            }
            var lineage = _state.Lineages.GetValueOrDefault(lineageId);
            var generation = (lineage?.CurrentGeneration ?? 0) + 1;
            var jobId = $"job-{Guid.NewGuid():N}";
            var now = _clock.UtcNow;
            if (lineage is not null && _state.Jobs.TryGetValue(lineage.CurrentJobId, out var previous) && !Terminal.Contains(previous.Status))
            {
                previous = Advance(previous with { CancellationCause = "parent_superseded" }, "superseded", "superseded", "superseded", cancellation: previous.Cancellation);
                _state.Jobs[previous.JobId] = previous;
                foreach (var opId in previous.ExternalOperationRefs)
                    if (_state.Operations.TryGetValue(opId, out var op) && op.State == "reserved" && op.Delivery == "not-delivered") _state.Operations[opId] = op with { State = "abandoned", ObservedAt = now, CancellationCause = "parent_superseded" };
                AuditLocked(previous.JobId, "superseded", new Dictionary<string, string> { ["byJobId"] = jobId, ["cause"] = "parent_superseded" });
            }
            var attemptId = $"attempt-{Guid.NewGuid():N}";
            // A supervised Steward may narrow the inherited budget, never enlarge it (#95).
            var deadline = now.AddMinutes(15);
            if (parentContract?.AbsoluteDeadline is { } inherited && inherited < deadline) deadline = inherited;
            var lease = new StewardLease($"steward-runtime:{attemptId}", generation, deadline);
            var job = new StewardSeedJob(jobId, lineageId, generation, attemptId, 0, subject, candidate, requestDigest,
                "queued", "admitted", "none", null, now, now, now, now, 1, "admitted", deadline, null, lease, [], [],
                parentContract, obligationSet, null, parentContract?.ContractDigest, obligationSet.Digest, 2, []);
            _state.Jobs[jobId] = job;
            _state.Lineages[lineageId] = new(jobId, generation, subject, candidate, (lineage?.Version ?? -1) + 1);
            _state.Idempotency[idempotencyKey] = new(requestDigest, jobId);
            AuditLocked(jobId, "admitted", new Dictionary<string, string> { ["generation"] = generation.ToString(System.Globalization.CultureInfo.InvariantCulture), ["candidate"] = candidate.Digest, ["obligationSetDigest"] = obligationSet.Digest });
            try { SaveLocked(); }
            catch { _state = priorState; throw; }
            return new(jobId, false);
        }
    }

    private StewardObligationSnapshot BuildObligationSnapshot()
    {
        var obligations = _policy.Requirements.Select(item => new StewardObligationSnapshotItem(item.Id, item.Required, item.EvidenceClass, item.CriterionDigest)).ToArray();
        var revision = _policy.ProfileRevision;
        var digest = Digest(new { revision, proofRecipeDigest = _policy.RecipeDigest, obligations });
        return new(revision, digest, _policy.RecipeDigest, obligations);
    }

