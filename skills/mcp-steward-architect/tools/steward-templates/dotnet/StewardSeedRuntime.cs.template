    private void PromoteOrBlockLocked(StewardSeedJob job, StewardOperation operation, JsonElement payload)
    {
        var added = false;
        if (!PayloadSubjectMatches(payload, job.Subject)
            || !payload.TryGetProperty("observation", out var observation)
            || observation.ValueKind != JsonValueKind.Object
            || !observation.TryGetProperty("producerId", out var producerIdElement)
            || !observation.TryGetProperty("authorityClass", out var authorityElement)
            || !observation.TryGetProperty("observationGrade", out var gradeElement)
            || !observation.TryGetProperty("binding", out var bindingElement)
            || !observation.TryGetProperty("coverage", out var coverageElement)
            || producerIdElement.ValueKind != JsonValueKind.String
            || authorityElement.ValueKind != JsonValueKind.String
            || gradeElement.ValueKind != JsonValueKind.String
            || bindingElement.ValueKind != JsonValueKind.Object
            || coverageElement.ValueKind != JsonValueKind.Object)
        {
            BlockObservationLocked(job); return;
        }
        var producerId = producerIdElement.GetString() ?? string.Empty;
        if (!string.Equals(producerId, _provider.ProducerId, StringComparison.Ordinal) || !_policy.Producers.TryGetValue(producerId, out var producer))
        {
            BlockObservationLocked(job); return;
        }
        var claimedAuthority = authorityElement.GetString() ?? string.Empty;
        if (!AuthorityRank.TryGetValue(claimedAuthority, out var claimedRank) || !AuthorityRank.TryGetValue(producer.AuthorityCeiling, out var ceilingRank))
        {
            BlockObservationLocked(job); return;
        }
        var actualAuthority = AuthorityRank.First(item => item.Value == Math.Min(claimedRank, ceilingRank)).Key;
        var observationGrade = gradeElement.GetString();
        if (observationGrade is null || !ObservationGrades.Contains(observationGrade)) { BlockObservationLocked(job); return; }
        if (!bindingElement.TryGetProperty("satisfied", out var satisfiedElement)
            || satisfiedElement.ValueKind != JsonValueKind.Array
            || satisfiedElement.EnumerateArray().Any(item => item.ValueKind != JsonValueKind.String)
            || !coverageElement.TryGetProperty("required", out var requiredElement)
            || !coverageElement.TryGetProperty("observed", out var observedElement)
            || !requiredElement.TryGetInt32(out var requiredCoverage)
            || !observedElement.TryGetInt32(out var observedCoverage))
        {
            BlockObservationLocked(job); return;
        }
        var observedSatisfied = satisfiedElement.EnumerateArray().Select(item => item.GetString()!).ToHashSet(StringComparer.Ordinal);
        if (operation.CandidateDigest == job.Candidate.Digest) observedSatisfied.Add("candidate");
        if (requiredCoverage < 1 || observedCoverage < 0 || observedCoverage > requiredCoverage) { BlockObservationLocked(job); return; }
        var coverageState = observedCoverage >= requiredCoverage ? "complete" : observedCoverage > 0 ? "partial" : "unknown";
        // Derived evidence binds to the admitted obligation snapshot (#107); a snapshot
        // obligation whose live proof-recipe criterion drifted away cannot be proven.
        var recipeDrifted = job.ObligationSet is { } driftCheck && driftCheck.ProofRecipeDigest != _policy.RecipeDigest;
        var snapshotRequirements = !recipeDrifted && job.ObligationSet is { } set
            ? set.Obligations.Select(item => (snapshot: item, req: _policy.Requirements.FirstOrDefault(candidate => candidate.Id == item.Id)))
                .Where(pair => pair.req is not null && pair.req.CriterionDigest == pair.snapshot.CriterionDigest)
                .Select(pair => pair.req!)
            : Enumerable.Empty<SeedRequirement>();
        foreach (var req in snapshotRequirements)
        {
            if (req.ApprovedProducers.Count > 0 && !req.ApprovedProducers.Contains(producerId)) continue;
            var observed = operation.ObservedAt; var id = $"evidence-{Guid.NewGuid():N}";
            var satisfied = req.BindingRequirements.Where(observedSatisfied.Contains).ToArray();
            var bindingStatus = req.BindingRequirements.All(observedSatisfied.Contains) ? "complete" : satisfied.Length > 0 ? "partial" : "unknown";
            var binding = new StewardBinding(req.BindingRequirements, satisfied, bindingStatus);
            var evidence = new StewardEvidence(id, job.JobId, job.LineageId, job.Generation, job.Subject, job.Candidate, req.Id, req.CanonicalClaim,
                req.EvidenceClass, observationGrade, actualAuthority, producerId, _policy.RecipeId, binding,
                new StewardCoverage(coverageState, requiredCoverage, observedCoverage), observed, observed.AddSeconds(req.FreshnessSeconds), Digest(payload));
            _state.Evidence[id] = evidence; job = job with { EvidenceRefs = job.EvidenceRefs.Concat([id]).ToArray() }; added = true;
            AuditLocked(job.JobId, "evidence-persisted", new Dictionary<string, string> { ["evidenceId"] = id, ["claimId"] = req.CanonicalClaim,
                ["authorityClass"] = actualAuthority, ["bindingStatus"] = bindingStatus, ["coverageState"] = coverageState });
        }
        _state.Jobs[job.JobId] = added ? Advance(job, "finalizing", "evidence-persisted", "evidence-persisted", cancellation: job.Cancellation)
            : Advance(job, "blocked", "blocked", "blocked:terminal-observation-insufficient-authority", cancellation: job.Cancellation, blockedReason: "terminal-observation-insufficient-authority");
        if (!added) AuditLocked(job.JobId, "blocked", new Dictionary<string, string> { ["reason"] = "terminal-observation-insufficient-authority" });
    }

    private static bool PayloadSubjectMatches(JsonElement payload, StewardSubject subject)
    {
        if (!payload.TryGetProperty("subject", out var element) || element.ValueKind != JsonValueKind.Object) return false;
        try { return element.Deserialize<StewardSubject>() is { } observed && observed == subject; }
        catch (JsonException) { return false; }
    }

    private void BlockObservationLocked(StewardSeedJob job)
    {
        _state.Jobs[job.JobId] = Advance(job, "blocked", "blocked", "blocked:terminal-observation-insufficient-authority", cancellation: job.Cancellation, blockedReason: "terminal-observation-insufficient-authority");
        AuditLocked(job.JobId, "blocked", new Dictionary<string, string> { ["reason"] = "terminal-observation-insufficient-authority" });
    }

    private StewardCompletionEvaluation EvaluateCompletionLocked(StewardSeedJob job)
    {
        RequireCurrentLocked(job); var lineage = _state.Lineages[job.LineageId];
        if (lineage.Subject != job.Subject || lineage.Candidate != job.Candidate) throw new InvalidOperationException("stale subject/candidate identity");
        var unresolved = _state.Operations.Values.Where(item => _state.Jobs.TryGetValue(item.JobId, out var owner) && owner.LineageId == job.LineageId && item.State is not ("captured" or "abandoned" or "failed")).Select(item => item.OperationId).Order(StringComparer.Ordinal).ToArray();
        var cancelUnresolved = _state.Operations.Values.Where(item => item.JobId == job.JobId && item.OperationKind == "cancel" && item.State is not ("captured" or "abandoned" or "failed")).Select(item => item.OperationId).ToArray();
        var blocked = unresolved.Length > 0 || cancelUnresolved.Length > 0; var obligations = new List<StewardCompletionObligation>();
        var parentRef = job.ParentContract is { } parent ? new StewardParentContractRef(parent.Mode, parent.ContractDigest, parent.ParentWorkId, parent.ParentGeneration) : null;
        if (job.ObligationSet is null || job.ObligationSet.Obligations.Count == 0)
        {
            // Completion without an admitted obligation snapshot fails closed (#107).
            return new(2, $"completion-{Guid.NewGuid():N}", job.JobId, job.LineageId, job.Generation, job.Subject, job.Candidate,
                new Dictionary<string, object> { ["generation"] = job.Generation, ["profileRevision"] = _policy.ProfileRevision, ["proofRecipeRevision"] = _policy.ProofRevision, ["subjectRevision"] = job.Subject.Revision ?? "none", ["candidateDigest"] = job.Candidate.Digest },
                "blocked", obligations, unresolved, cancelUnresolved, _clock.UtcNow, null, parentRef);
        }
        if (job.ObligationSet.ProofRecipeDigest != _policy.RecipeDigest)
        {
            // Producer/criterion/aggregation semantics changed after admission; the job
            // must be re-admitted rather than evaluated under mutated live policy (#107).
            obligations.AddRange(job.ObligationSet.Obligations.Select(item => new StewardCompletionObligation(item.Id, "unsatisfied", [])));
            if (job.ObligationSet.Obligations.Any(item => item.Required)) blocked = true;
            return new(2, $"completion-{Guid.NewGuid():N}", job.JobId, job.LineageId, job.Generation, job.Subject, job.Candidate,
                new Dictionary<string, object> { ["generation"] = job.Generation, ["profileRevision"] = _policy.ProfileRevision, ["proofRecipeRevision"] = _policy.ProofRevision, ["subjectRevision"] = job.Subject.Revision ?? "none", ["candidateDigest"] = job.Candidate.Digest },
                "blocked", obligations, unresolved, cancelUnresolved, _clock.UtcNow, job.ObligationSet.Digest, parentRef);
        }
        foreach (var snapshot in job.ObligationSet.Obligations)
        {
            var req = _policy.Requirements.FirstOrDefault(item => item.Id == snapshot.Id);
            if (req is null || req.CriterionDigest != snapshot.CriterionDigest)
            {
                // Admitted obligation whose live proof-recipe criterion drifted away or whose
                // authority-affecting semantics changed after admission fails closed (#107).
                obligations.Add(new(snapshot.Id, "unsatisfied", []));
                if (snapshot.Required) blocked = true;
                continue;
            }
            var refs = _state.Evidence.Values.Where(item => EvidenceSatisfies(job, req, item)).Select(item => item.EvidenceId).Order(StringComparer.Ordinal).ToArray();
            if (snapshot.Required && refs.Length == 0) blocked = true;
            obligations.Add(new(snapshot.Id, refs.Length == 0 ? "unsatisfied" : "satisfied", refs));
        }
        return new(2, $"completion-{Guid.NewGuid():N}", job.JobId, job.LineageId, job.Generation, job.Subject, job.Candidate,
            new Dictionary<string, object> { ["generation"] = job.Generation, ["profileRevision"] = _policy.ProfileRevision, ["proofRecipeRevision"] = _policy.ProofRevision, ["subjectRevision"] = job.Subject.Revision ?? "none", ["candidateDigest"] = job.Candidate.Digest },
            blocked ? "blocked" : "eligible", obligations, unresolved, cancelUnresolved, _clock.UtcNow, job.ObligationSet.Digest, parentRef);
    }

    private bool EvidenceSatisfies(StewardSeedJob job, SeedRequirement req, StewardEvidence ev)
    {
        if (ev.JobId != job.JobId || ev.Generation != job.Generation || ev.LineageId != job.LineageId || ev.Subject != job.Subject || ev.Candidate != job.Candidate) return false;
        if (!ObservationGrades.Contains(ev.ObservationGrade)) return false;
        if (ev.CriterionId != req.Id || ev.ClaimId != req.CanonicalClaim || ev.EvidenceClass != req.EvidenceClass || ev.ProofRecipeId != _policy.RecipeId) return false;
        if (req.ApprovedProducers.Count > 0 && !req.ApprovedProducers.Contains(ev.ProducerId)) return false;
        if (!_policy.Producers.TryGetValue(ev.ProducerId, out var producer)) return false;
        var evidenceRank = AuthorityRank.GetValueOrDefault(ev.AuthorityClass, -1);
        if (evidenceRank > AuthorityRank.GetValueOrDefault(producer.AuthorityCeiling, -1)) return false;
        if (evidenceRank < AuthorityRank.GetValueOrDefault(req.RequiredAuthority, int.MaxValue)) return false;
        if (ev.Binding.Status != "complete" || !req.BindingRequirements.All(ev.Binding.Satisfied.Contains)) return false;
        if ((req.CoverageSemantics is "all-required" or "complete-negative-coverage") && (ev.Coverage.State != "complete" || ev.Coverage.Observed < ev.Coverage.Required)) return false;
        if (req.CoverageSemantics == "any-sufficient" && ev.Coverage.Observed <= 0) return false;
        if (ev.ObservedAt > _clock.UtcNow || _clock.UtcNow - ev.ObservedAt > TimeSpan.FromSeconds(req.FreshnessSeconds)) return false;
        return ev.ExpiresAt is null || ev.ExpiresAt >= _clock.UtcNow;
    }

    private void FinalizeLocked(StewardSeedJob job)
    {
        var completion = EvaluateCompletionLocked(job);
        if (completion.Disposition != "eligible")
        {
            _state.Jobs[job.JobId] = Advance(job, "blocked", "blocked", "blocked:completion-obligations-unresolved", cancellation: job.Cancellation, blockedReason: "completion-obligations-unresolved");
            return;
        }
        var publicationEffect = _policy.Effects["terminal-publication"];
        var publicationAdmission = EvaluateMutationLocked("terminal-publication", job, null, publicationEffect.CapabilityContract,
            AuthorityFor("terminal-publication", job, "completion-gate"));
        if (publicationAdmission != "Admitted")
        {
            var reason = $"mutation-admission:{publicationAdmission}";
            _state.Jobs[job.JobId] = Advance(job, "blocked", "mutation-admission-rejected", reason, cancellation: job.Cancellation, blockedReason: reason);
            AuditLocked(job.JobId, "mutation-admission-rejected", new Dictionary<string, string> { ["effect"] = "terminal-publication", ["disposition"] = publicationAdmission });
            return;
        }
        var publicationDecisionRef = $"admission-{Guid.NewGuid():N}";
        var handoff = CreateHandoff(job, completion);
        if (_faults.Trip("before-terminal-publication")) return;
        var lineage = _state.Lineages[job.LineageId];
        if (lineage.CurrentJobId != job.JobId || lineage.CurrentGeneration != job.Generation || lineage.Candidate != job.Candidate) throw new InvalidOperationException("stale lineage/candidate publication");
        _state.Completions[job.JobId] = completion; _state.Handoffs[job.JobId] = handoff;
        _state.Jobs[job.JobId] = Advance(job, "completed", "completed", "completed", cancellation: job.Cancellation);
        AuditLocked(job.JobId, "handoff-sealed", new Dictionary<string, string> { ["digest"] = handoff.Digest, ["candidate"] = handoff.Candidate.Digest, ["mutationDecisionRef"] = publicationDecisionRef });
    }

    private StewardHandoff CreateHandoff(StewardSeedJob job, StewardCompletionEvaluation completion)
    {
        var parentRef = job.ParentContract is { } parent ? new StewardParentContractRef(parent.Mode, parent.ContractDigest, parent.ParentWorkId, parent.ParentGeneration) : null;
        var unsigned = new { schema_version = 2, handoffId = $"handoff-{Guid.NewGuid():N}", jobId = job.JobId, lineageId = job.LineageId, generation = job.Generation, subject = job.Subject, candidate = job.Candidate, status = "completed", actionable = true, outcome = "seed-provider-completed", evidenceRefs = completion.Obligations.SelectMany(item => item.EvidenceRefs).ToArray(), artifactRefs = Array.Empty<string>(), externalOperationRefs = job.ExternalOperationRefs.ToArray(), gaps = Array.Empty<string>(), correlationId = job.JobId, sealedAt = _clock.UtcNow, parentContract = parentRef };
        var digest = "sha256:" + Sha256Hex(JsonSerializer.SerializeToUtf8Bytes(unsigned));
        return new(2, unsigned.handoffId, job.JobId, job.LineageId, job.Generation, job.Subject, job.Candidate, "completed", true,
            "seed-provider-completed", unsigned.evidenceRefs, [], unsigned.externalOperationRefs, [], job.JobId, unsigned.sealedAt, digest, parentRef);
    }

    private static string ComputeHandoffDigest(StewardHandoff handoff)
    {
        var unsigned = new { schema_version = handoff.SchemaVersion, handoffId = handoff.HandoffId, jobId = handoff.JobId, lineageId = handoff.LineageId, generation = handoff.Generation, subject = handoff.Subject, candidate = handoff.Candidate, status = handoff.Status, actionable = handoff.Actionable, outcome = handoff.Outcome, evidenceRefs = handoff.EvidenceRefs, artifactRefs = handoff.ArtifactRefs, externalOperationRefs = handoff.ExternalOperationRefs, gaps = handoff.Gaps, correlationId = handoff.CorrelationId, sealedAt = handoff.SealedAt, parentContract = handoff.ParentContract };
        return "sha256:" + Sha256Hex(JsonSerializer.SerializeToUtf8Bytes(unsigned));
    }

    private StewardSeedJob Advance(StewardSeedJob job, string status, string stage, string marker, string cancellation, string? blockedReason = null) => job with { Version = job.Version + 1, Status = status, Stage = stage, Cancellation = cancellation, BlockedReason = blockedReason, Lease = Terminal.Contains(status) ? null : job.Lease, UpdatedAt = _clock.UtcNow, HeartbeatAt = _clock.UtcNow, ProgressAt = _clock.UtcNow, ProgressRevision = job.ProgressRevision + 1, ProgressMarker = marker };
    private StewardSeedJob? NextJobLocked() => _state.Jobs.Values.Where(item => Runnable.Contains(item.Status)).OrderBy(item => item.Status == "waiting-external" ? 1 : 0).ThenBy(item => item.CreatedAt).ThenBy(item => item.JobId, StringComparer.Ordinal).FirstOrDefault();
    private StewardOperation? OperationLocked(string jobId, string kind) => _state.Operations.Values.Where(item => item.JobId == jobId && item.OperationKind == kind).OrderBy(item => item.CreatedAt).FirstOrDefault();
    private bool HasEvidenceLocked(string jobId) => _state.Evidence.Values.Any(item => item.JobId == jobId);
    private StewardOperation? NextSupersededOperationLocked() => _state.Operations.Values.Where(item => _state.Jobs.TryGetValue(item.JobId, out var job) && job.Status == "superseded" && item.State is not ("captured" or "abandoned" or "failed" or "expired") && (item.Delivery is "delivery-unknown" or "delivered")).OrderBy(item => item.ObservedAt).FirstOrDefault();
    private bool IsCurrentLocked(StewardSeedJob job)
    {
        if (!_state.Lineages.TryGetValue(job.LineageId, out var lineage) || lineage.CurrentJobId != job.JobId
            || lineage.CurrentGeneration != job.Generation || lineage.Subject != job.Subject || lineage.Candidate != job.Candidate) return false;
        var current = CurrentJobLocked(job.JobId);
        return current.AttemptId == job.AttemptId && current.Version == job.Version;
    }
    private StewardSeedJob CurrentJobLocked(string jobId) => _state.Jobs.TryGetValue(jobId, out var job) ? job : throw new KeyNotFoundException(jobId);
    private void RequireCurrentLocked(StewardSeedJob job) { if (!IsCurrentLocked(job)) throw new InvalidOperationException("stale lineage/generation/attempt/candidate"); }
    private void AuditLocked(string? jobId, string eventType, IReadOnlyDictionary<string, string> detail) { _state.AuditSequence++; _state.Audit.Add(new(_state.AuditSequence, jobId, eventType, _clock.UtcNow, detail)); if (_state.Audit.Count > 1000) _state.Audit.RemoveRange(0, _state.Audit.Count - 1000); }

    private StewardSeedState LoadOrQuarantine()
    {
        if (!File.Exists(_snapshotPath)) return new();
        try
        {
            var state = JsonSerializer.Deserialize<StewardSeedState>(File.ReadAllText(_snapshotPath)) ?? throw new JsonException("null Steward snapshot");
            if (state.Jobs is null || state.Lineages is null || state.Idempotency is null || state.Operations is null
                || state.Evidence is null || state.Completions is null || state.Handoffs is null || state.Audit is null)
                throw new JsonException("Steward snapshot contains null required collections");
            ValidateState(state);
            return state;
        }
        catch (JsonException exc) { var quarantine = _snapshotPath + $".corrupt-{DateTimeOffset.UtcNow:yyyyMMddHHmmssfff}"; File.Move(_snapshotPath, quarantine); throw new InvalidDataException($"STORE_CORRUPT / OPERATOR_RECOVERY_REQUIRED: canonical snapshot quarantined at {quarantine}", exc); }
    }

    private static void ValidateState(StewardSeedState state)
    {
        if (state.Jobs.Any(item => item.Value is null) || state.Lineages.Any(item => item.Value is null)
            || state.Idempotency.Any(item => item.Value is null) || state.Operations.Any(item => item.Value is null)
            || state.Evidence.Any(item => item.Value is null) || state.Completions.Any(item => item.Value is null)
            || state.Handoffs.Any(item => item.Value is null) || state.Audit.Any(item => item is null))
            throw new JsonException("Steward snapshot contains null entries");
        foreach (var pair in state.Jobs)
        {
            var job = pair.Value;
            if (job is null || pair.Key != job.JobId || string.IsNullOrWhiteSpace(job.LineageId)
                || job.Subject is null || string.IsNullOrWhiteSpace(job.Subject.Type) || string.IsNullOrWhiteSpace(job.Subject.Id)
                || job.Candidate is null || string.IsNullOrWhiteSpace(job.Candidate.Digest))
                throw new JsonException("Steward snapshot contains an invalid job identity");
            if (!state.Lineages.TryGetValue(job.LineageId, out var lineage) || lineage is null
                || string.IsNullOrWhiteSpace(lineage.CurrentJobId) || !state.Jobs.TryGetValue(lineage.CurrentJobId, out var currentJob)
                || currentJob is null || lineage.CurrentGeneration != currentJob.Generation
                || lineage.Subject != currentJob.Subject || lineage.Candidate != currentJob.Candidate)
                throw new JsonException("Steward snapshot contains inconsistent job lineage");
            if (job.ParentContract is { } parent)
            {
                if (parent.Mode != "supervised" || string.IsNullOrWhiteSpace(parent.SupervisorSystemId)
                    || string.IsNullOrWhiteSpace(parent.ContractId) || string.IsNullOrWhiteSpace(parent.ContractDigest))
                    throw new JsonException("Steward snapshot contains an invalid parent contract snapshot");
                if (!string.Equals(ParentContractDigest(parent), parent.ContractDigest, StringComparison.Ordinal))
                    throw new JsonException("Steward snapshot parent contract digest does not bind the snapshot contents");
                if (string.IsNullOrWhiteSpace(job.ParentContractDigest)
                    || !string.Equals(ParentContractDigest(parent), job.ParentContractDigest, StringComparison.Ordinal))
                    throw new JsonException("Steward snapshot parent contract does not match the admission-time digest column");
            }
            if (!Terminal.Contains(job.Status) || job.Status is "completed" or "completed-with-gaps")
            {
                if (job.ObligationSet is null || job.ObligationSet.Obligations.Count == 0
                    || string.IsNullOrWhiteSpace(job.ObligationSet.ProofRecipeDigest)
                    || string.IsNullOrWhiteSpace(job.ObligationSetDigest)
                    || job.ObligationSet.Obligations.Any(item => string.IsNullOrWhiteSpace(item.CriterionDigest)))
                    throw new JsonException("Steward snapshot job is missing the admitted obligation snapshot bindings");
                if (!string.Equals(Digest(new { revision = job.ObligationSet.Revision, proofRecipeDigest = job.ObligationSet.ProofRecipeDigest, obligations = job.ObligationSet.Obligations }), job.ObligationSet.Digest, StringComparison.Ordinal))
                    throw new JsonException("Steward snapshot obligation set digest does not bind the snapshot contents");
                if (!string.Equals(job.ObligationSet.Digest, job.ObligationSetDigest, StringComparison.Ordinal))
                    throw new JsonException("Steward snapshot obligation set does not match the admission-time digest column");
            }
        }
        foreach (var pair in state.Lineages)
            if (pair.Value is null || string.IsNullOrWhiteSpace(pair.Key) || !state.Jobs.TryGetValue(pair.Value.CurrentJobId, out var currentJob)
                || currentJob is null || currentJob.LineageId != pair.Key)
                throw new JsonException("Steward snapshot contains an invalid lineage identity");
        foreach (var pair in state.Idempotency)
            if (pair.Value is null || !state.Jobs.TryGetValue(pair.Value.JobId, out var idempotentJob)
                || idempotentJob is null || idempotentJob.RequestDigest != pair.Value.RequestDigest)
                throw new JsonException("Steward snapshot contains an inconsistent idempotency binding");
        foreach (var pair in state.Operations)
        {
            var operation = pair.Value;
            if (operation is null || pair.Key != operation.OperationId || !state.Jobs.TryGetValue(operation.JobId, out var job)
                || job is null || !state.Lineages.ContainsKey(operation.LineageId) || operation.LineageId != job.LineageId
                || operation.Generation != job.Generation || operation.AttemptId != job.AttemptId
                || operation.CandidateDigest != job.Candidate.Digest)
                throw new JsonException("Steward snapshot contains inconsistent operation identity");
            if (operation.OperationKind is "submit" or "cancel" or "mutation"
                && (string.IsNullOrWhiteSpace(operation.SemanticSlot) || operation.OperationDeadlineAt is null))
                throw new JsonException("Steward snapshot contains a stateful operation without semantic slot or absolute deadline");
        }
        foreach (var pair in state.Evidence)
        {
            var evidence = pair.Value;
            if (evidence is null || pair.Key != evidence.EvidenceId || !state.Jobs.TryGetValue(evidence.JobId, out var job)
                || job is null || evidence.LineageId != job.LineageId || evidence.Generation != job.Generation
                || evidence.Subject != job.Subject || evidence.Candidate != job.Candidate)
                throw new JsonException("Steward snapshot contains inconsistent evidence identity");
        }
        foreach (var pair in state.Completions)
        {
            var completion = pair.Value;
            if (completion is null || pair.Key != completion.JobId || !state.Jobs.TryGetValue(completion.JobId, out var job)
                || job is null || completion.LineageId != job.LineageId || completion.Generation != job.Generation
                || completion.Subject != job.Subject || completion.Candidate != job.Candidate)
                throw new JsonException("Steward snapshot contains an inconsistent completion reference");
        }
        foreach (var pair in state.Handoffs)
        {
            var handoff = pair.Value;
            if (handoff is null || pair.Key != handoff.JobId || !state.Jobs.TryGetValue(handoff.JobId, out var job)
                || job is null || handoff.LineageId != job.LineageId || handoff.Generation != job.Generation
                || handoff.Subject != job.Subject || handoff.Candidate != job.Candidate
                || !string.Equals(ComputeHandoffDigest(handoff), handoff.Digest, StringComparison.Ordinal))
                throw new JsonException("Steward snapshot contains an inconsistent handoff reference");
        }
    }

    private void SaveLocked()
    {
        var temp = _snapshotPath + $".tmp-{Guid.NewGuid():N}";
        try
        {
            using (var stream = new FileStream(temp, FileMode.CreateNew, FileAccess.Write, FileShare.None, 4096, FileOptions.WriteThrough)) { JsonSerializer.Serialize(stream, _state); stream.Flush(flushToDisk: true); }
            File.Move(temp, _snapshotPath, overwrite: true);
        }
        finally { if (File.Exists(temp)) File.Delete(temp); }
    }

    private static string Digest<T>(T value) => "sha256:" + Sha256Hex(JsonSerializer.SerializeToUtf8Bytes(value));
    private static string Sha256Hex(ReadOnlySpan<byte> value) => Convert.ToHexStringLower(SHA256.HashData(value));
}
