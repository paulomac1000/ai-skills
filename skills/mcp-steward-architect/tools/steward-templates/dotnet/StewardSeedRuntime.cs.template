public interface ISeedClock { DateTimeOffset UtcNow { get; } }
public sealed class SystemSeedClock : ISeedClock { public static readonly SystemSeedClock Instance = new(); private SystemSeedClock() { } public DateTimeOffset UtcNow => DateTimeOffset.UtcNow; }
public sealed class FakeSeedClock(DateTimeOffset initial) : ISeedClock { private DateTimeOffset _value = initial; public DateTimeOffset UtcNow => _value; public void Advance(TimeSpan value) => _value += value; }

