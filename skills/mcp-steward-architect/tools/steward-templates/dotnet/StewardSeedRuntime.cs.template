public interface ISeedProvider
{
    string ProducerId { get; }
    string Dispatch(string operationId, StewardSubject subject);
    string Reconcile(string operationId, StewardSubject subject);
    SeedPollResult Poll(string remoteHandle, StewardSubject subject);
    string Cancel(string cancellationOperationId, string remoteHandle, StewardSubject subject);
    string ReconcileCancel(string cancellationOperationId, string remoteHandle, StewardSubject subject);
}

public sealed class FakeSeedProvider : ISeedProvider
{
    private static readonly string[] ObservedTargetBinding = ["target"];
    public string ProducerId => "seed-provider";
    public string Dispatch(string operationId, StewardSubject subject) { _ = subject; return $"remote-{operationId}"; }
    public string Reconcile(string operationId, StewardSubject subject) { _ = subject; return $"remote-{operationId}"; }
    public SeedPollResult Poll(string remoteHandle, StewardSubject subject) => new(true, JsonSerializer.SerializeToElement(new { state = "completed", remoteHandle, subject, revision = "terminal-1", observation = new { producerId = ProducerId, observationGrade = "observed", authorityClass = "observed", binding = new { satisfied = ObservedTargetBinding }, coverage = new { required = 1, observed = 1 } } }));
    public string Cancel(string cancellationOperationId, string remoteHandle, StewardSubject subject) { _ = remoteHandle; _ = subject; return $"cancel-{cancellationOperationId}"; }
    public string ReconcileCancel(string cancellationOperationId, string remoteHandle, StewardSubject subject) { _ = remoteHandle; _ = subject; return $"cancel-{cancellationOperationId}"; }
}

public sealed class SeedFaultInjector
{
    private readonly HashSet<string> _faults;
    public SeedFaultInjector() : this((Environment.GetEnvironmentVariable("STEWARD_FAULTS") ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)) { }
    public SeedFaultInjector(IEnumerable<string> faults) => _faults = new(faults, StringComparer.Ordinal);
    public bool Trip(string name) => _faults.Remove(name);
}

