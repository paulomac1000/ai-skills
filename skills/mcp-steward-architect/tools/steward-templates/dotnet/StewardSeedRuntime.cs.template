public interface ISeedClock
{
    DateTimeOffset UtcNow { get; }
}

public sealed class SystemSeedClock : ISeedClock
{
    public static readonly SystemSeedClock Instance = new();
    private SystemSeedClock() { }
    public DateTimeOffset UtcNow => DateTimeOffset.UtcNow;
}

public sealed class FakeSeedClock(DateTimeOffset initial) : ISeedClock
{
    private DateTimeOffset _value = initial;
    public DateTimeOffset UtcNow => _value;
    public void Advance(TimeSpan value) => _value += value;
}

public sealed record SeedPollResult(bool Completed, JsonElement Payload);

public interface ISeedProvider
{
    string ProducerId { get; }
    string Dispatch(string operationId, StewardSubject subject);
    string Reconcile(string operationId, StewardSubject subject);
    SeedPollResult Poll(string remoteHandle, StewardSubject subject);
}

public sealed class FakeSeedProvider : ISeedProvider
{
    public string ProducerId => "seed-provider";

    public string Dispatch(string operationId, StewardSubject subject)
    {
        _ = subject;
        return $"remote-{operationId}";
    }

    public string Reconcile(string operationId, StewardSubject subject)
    {
        _ = subject;
        return $"remote-{operationId}";
    }

    public SeedPollResult Poll(string remoteHandle, StewardSubject subject)
    {
        var payload = JsonSerializer.SerializeToElement(new
        {
            state = "completed",
            remoteHandle,
            subject,
        });
        return new(true, payload);
    }
}

public sealed class SeedFaultInjector
{
    private readonly HashSet<string> _faults;

    public SeedFaultInjector()
        : this((Environment.GetEnvironmentVariable("STEWARD_FAULTS") ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
    {
    }

    public SeedFaultInjector(IEnumerable<string> faults) =>
        _faults = new HashSet<string>(faults, StringComparer.Ordinal);

    public bool Trip(string name) => _faults.Remove(name);
}

