    private static readonly HashSet<string> CancellationCauses = ["caller_cancel", "parent_superseded", "service_shutdown", "application_deadline", "transport_timeout", "provider_cancel", "unknown"];

    public StewardSeedJob Cancel(string jobId) => Cancel(jobId, "caller_cancel");

    public StewardSeedJob Cancel(string jobId, string cause)
    {
        // Cancellation provenance is a closed contract vocabulary (#106); a mechanism
        // label invented by a caller must never enter durable provenance.
        if (!CancellationCauses.Contains(cause)) throw new ArgumentException($"unsupported cancellation cause: {cause}", nameof(cause));
        lock (_gate)
        {
            var job = CurrentJobLocked(jobId);
            if (Terminal.Contains(job.Status)) return job;
            job = Advance(job with { CancellationCause = cause }, "cancelling", "cancel-requested", "cancel-requested", cancellation: "requested");
            _state.Jobs[jobId] = job; AuditLocked(jobId, "cancel-requested", new Dictionary<string, string> { ["cause"] = cause }); SaveLocked(); return job;
        }
    }

    public StewardDoctorResult Doctor(string? jobId = null)
    {
        lock (_gate)
        {
            var job = jobId is null ? NextJobLocked() : CurrentJobLocked(jobId);
            var ops = _state.Operations.Values.Where(item => jobId is null || item.JobId == jobId).ToArray();
            var unknown = ops.Count(item => item.Delivery == "delivery-unknown");
            var cancellationUnknown = ops.Count(item => item.OperationKind == "cancel" && item.Delivery == "delivery-unknown");
            var audit = _state.Audit.Where(item => jobId is null || item.JobId == jobId).OrderByDescending(item => item.Sequence).Take(50).ToArray();
            return new(job, unknown, cancellationUnknown, audit);
        }
    }

    public bool RunOneDue() => RunOneDueCore(suppressStaleOnce: false);

    private bool RunOneDueCore(bool suppressStaleOnce)
    {
        SeedAction? action;
        lock (_gate)
        {
            _reconcileTick++;
            var job = NextJobLocked();
            var stale = suppressStaleOnce ? null : NextSupersededOperationLocked();
            if (stale is not null && (_reconcileTick % 2 == 0 || job is null || job.Status == "waiting-external"))
            {
                var staleJob = CurrentJobLocked(stale.JobId);
                action = new(stale.Delivery == "delivery-unknown" ? (stale.OperationKind == "cancel" ? "stale-cancel-reconcile" : "stale-reconcile") : "stale-poll", staleJob, stale);
            }
            else
            {
                if (job is null) return false;
                _state.Jobs[job.JobId] = job with { HeartbeatAt = _clock.UtcNow };
                job = _state.Jobs[job.JobId];
                if (job.Cancellation is "requested" or "reconciling" || job.Status == "cancelling")
                {
                    action = PrepareCancellationLocked(job);
                    if (action is null) return true;
                }
                else
                {
                    var submit = OperationLocked(job.JobId, "submit");
                    if (submit is null) { ReserveOperationLocked(job, "submit"); SaveLocked(); _faults.Trip("after-reservation"); return true; }
                    if (submit.Delivery == "not-delivered") { if (!BeginDispatchLocked(submit.OperationId, "external-dispatch")) { SaveLocked(); return true; } SaveLocked(); action = new("dispatch", _state.Jobs[job.JobId], _state.Operations[submit.OperationId]); }
                    else if (submit.Delivery == "delivery-unknown") action = new("reconcile", job, submit);
                    else if (submit.Result is null) action = new("poll", job, submit);
                    else if (!HasEvidenceLocked(job.JobId)) { PromoteOrBlockLocked(job, submit, submit.Result.Value); SaveLocked(); return true; }
                    else if (job.Status == "finalizing")
                    {
                        var priorState = JsonSerializer.Deserialize<StewardSeedState>(JsonSerializer.Serialize(_state))
                            ?? throw new InvalidOperationException("cannot snapshot Steward state");
                        try { FinalizeLocked(job); SaveLocked(); }
                        catch { _state = priorState; throw; }
                        return true;
                    }
                    else return false;
                }
            }
        }

        // Deadline fencing precedes EVERY provider action branch (#106): dispatch,
        // reconcile, cancel-dispatch, cancel-reconcile and poll all classify an expired
        // operation deterministically instead of touching remote reality.
        if (action.Operation.OperationDeadlineAt is { } fencedDeadline && _clock.UtcNow > fencedDeadline)
        {
            lock (_gate)
            {
                var owner = CurrentJobLocked(action.Operation.JobId);
                _state.Operations[action.Operation.OperationId] = action.Operation with { State = "expired", CancellationCause = "application_deadline", ObservedAt = _clock.UtcNow };
                if (!Terminal.Contains(owner.Status))
                    _state.Jobs[owner.JobId] = Advance(owner, "blocked", "operation-deadline-exceeded", "blocked:operation-deadline-exceeded", cancellation: owner.Cancellation, blockedReason: "operation-deadline-exceeded");
                AuditLocked(owner.JobId, "operation-deadline-exceeded", new Dictionary<string, string> { ["operationId"] = action.Operation.OperationId, ["cause"] = "application_deadline" });
                SaveLocked();
            }
            return true;
        }

        if (action.Kind == "dispatch")
        {
            if (_faults.Trip("after-dispatch-start")) return true;
            var handle = _provider.Dispatch(action.Operation.OperationId, action.Job.Subject);
            if (_faults.Trip("after-dispatch") || _faults.Trip("before-handle-persist")) return true;
            lock (_gate) { BindDispatchLocked(action.Operation.OperationId, handle, false); SaveLocked(); }
            return true;
        }
        if (action.Kind is "reconcile" or "stale-reconcile")
        {
            var handle = _provider.Reconcile(action.Operation.OperationId, action.Job.Subject);
            lock (_gate) { ReconcileLocked(action.Operation.OperationId, handle, false); SaveLocked(); }
            return true;
        }
        if (action.Kind == "cancel-dispatch")
        {
            if (_faults.Trip("after-cancel-start")) return true;
            var submit = OperationLocked(action.Job.JobId, "submit") ?? throw new InvalidOperationException("submit operation missing");
            var handle = _provider.Cancel(action.Operation.OperationId, submit.RemoteHandle ?? throw new InvalidOperationException("submit handle missing"), action.Job.Subject);
            if (_faults.Trip("after-cancel-dispatch") || _faults.Trip("before-cancel-bind")) return true;
            lock (_gate) { BindDispatchLocked(action.Operation.OperationId, handle, true); MarkSubmitCancelledLocked(submit.OperationId); SaveLocked(); }
            return true;
        }
        if (action.Kind is "cancel-reconcile" or "stale-cancel-reconcile")
        {
            var submit = OperationLocked(action.Job.JobId, "submit") ?? throw new InvalidOperationException("submit operation missing");
            var handle = _provider.ReconcileCancel(action.Operation.OperationId, submit.RemoteHandle ?? throw new InvalidOperationException("submit handle missing"), action.Job.Subject);
            lock (_gate) { ReconcileLocked(action.Operation.OperationId, handle, true); MarkSubmitCancelledLocked(submit.OperationId); SaveLocked(); }
            return true;
        }

        var result = _provider.Poll(action.Operation.RemoteHandle ?? throw new InvalidOperationException("remote handle missing"), action.Job.Subject);
        if (!result.Completed)
        {
            if (action.Kind == "stale-poll")
            {
                // A no-progress stale poll must not report global idleness while runnable work remains.
                // Suppress the stale branch on the re-entry so the runnable job is actually processed
                // this call; the recursion happens OUTSIDE the store lock because the nested pass
                // performs provider I/O that must never hold the gate (#104/#105).
                bool runnable;
                lock (_gate) runnable = NextJobLocked() is not null;
                if (runnable) return RunOneDueCore(suppressStaleOnce: true);
            }
            return false;
        }
        lock (_gate)
        {
            if (action.Kind == "stale-poll") { CaptureStaleLocked(action.Operation.OperationId, result.Payload); SaveLocked(); return true; }
            RequireCurrentLocked(action.Job);
            if (_faults.Trip("before-result-persist")) return true;
            CaptureResultLocked(action.Operation.OperationId, result.Payload);
            SaveLocked();
        }
        return true;
    }

    private SeedAction? PrepareCancellationLocked(StewardSeedJob job)
    {
        var submit = OperationLocked(job.JobId, "submit");
        if (submit is null || submit.Delivery == "not-delivered")
        {
            if (submit is not null) _state.Operations[submit.OperationId] = submit with { State = "abandoned", ObservedAt = _clock.UtcNow };
            _state.Jobs[job.JobId] = Advance(job, "cancelled", "cancelled", "cancelled", cancellation: "completed");
            AuditLocked(job.JobId, "cancelled", new Dictionary<string, string> { ["remoteStop"] = "not-required" }); SaveLocked(); return null;
        }
        if (submit.Delivery == "delivery-unknown") return new("reconcile", job, submit);
        if (submit.State == "captured")
        {
            _state.Jobs[job.JobId] = Advance(job, "cancelled", "cancelled", "cancelled", cancellation: "completed");
            AuditLocked(job.JobId, "cancelled", new Dictionary<string, string> { ["remoteStop"] = "already-terminal" }); SaveLocked(); return null;
        }
        var cancel = OperationLocked(job.JobId, "cancel");
        if (cancel is null) { ReserveOperationLocked(job, "cancel", submit.OperationId); SaveLocked(); return null; }
        if (cancel.Delivery == "not-delivered") { if (!BeginDispatchLocked(cancel.OperationId, "cancellation-dispatch")) { SaveLocked(); return null; } SaveLocked(); return new("cancel-dispatch", _state.Jobs[job.JobId], _state.Operations[cancel.OperationId]); }
        if (cancel.Delivery == "delivery-unknown") return new("cancel-reconcile", job, cancel);
        if (cancel.State == "captured") return null;
        throw new InvalidOperationException("unsupported cancellation state");
    }
    public void RecoverUntilIdle(int maxSteps = 100)
    {
        for (var step = 0; step < maxSteps; step++)
        {
            if (!RunOneDue()) return;
            lock (_gate) if (NextJobLocked() is null && NextSupersededOperationLocked() is null) return;
        }
        throw new InvalidOperationException("recovery supervisor exceeded bounded step budget");
    }

    public static bool VerifyHandoffDigest(StewardHandoff handoff) => string.Equals(handoff.Digest, ComputeHandoffDigest(handoff), StringComparison.Ordinal);
    public void Dispose() => _ownerLock.Dispose();

    private void ReserveOperationLocked(StewardSeedJob job, string kind, string? submitOperationId = null)
    {
        RequireCurrentLocked(job);
        var id = $"operation-{Guid.NewGuid():N}"; var now = _clock.UtcNow;
        _ = submitOperationId;
        var requestDigest = OperationRequestDigest(job, kind);
        var op = new StewardOperation(id, kind, job.JobId, job.LineageId, job.Generation, job.AttemptId, job.Version + 1,
            _policy.Capability.Id, _policy.Capability.Digest, $"target:{job.Subject.Id}:{job.Subject.Revision ?? "none"}",
            job.Candidate.Digest, requestDigest, "reserved", "not-delivered", "forbidden", "primary", null, null, now, now, 0, null,
            kind, job.DeadlineAt, kind == "cancel" ? job.CancellationCause : null);
        _state.Operations[id] = op;
        var refs = job.ExternalOperationRefs.Concat([id]).ToArray();
        _state.Jobs[job.JobId] = Advance(job with { ExternalOperationRefs = refs }, job.Status, $"{kind}-reserved", $"{kind}-reserved", cancellation: job.Cancellation);
        AuditLocked(job.JobId, "external-reserved", new Dictionary<string, string> { ["operationId"] = id, ["kind"] = kind, ["capabilityContractDigest"] = _policy.Capability.Digest });
    }

    private bool BeginDispatchLocked(string operationId, string effectId)
    {
        var op = _state.Operations[operationId]; var job = CurrentJobLocked(op.JobId);
        var effect = _policy.Effects.GetValueOrDefault(effectId) ?? throw new InvalidOperationException($"mutation policy has no effect {effectId}");
        var decision = EvaluateMutationLocked(effectId, job, op, effect.CapabilityContract, AuthorityFor(effectId, job, effect.AuthoritySource));
        if (decision != "Admitted")
        {
            var reason = $"mutation-admission:{decision}";
            _state.Jobs[job.JobId] = Advance(job, "blocked", "mutation-admission-rejected", reason, cancellation: job.Cancellation, blockedReason: reason);
            AuditLocked(job.JobId, "mutation-admission-rejected", new Dictionary<string, string> { ["operationId"] = operationId, ["effect"] = effectId, ["disposition"] = decision });
            return false;
        }
        var decisionRef = $"admission-{Guid.NewGuid():N}";
        _state.Operations[operationId] = op with { State = "dispatching", Delivery = "delivery-unknown", RetryDisposition = "reconcile-first", ObservedAt = _clock.UtcNow, MutationDecisionRef = decisionRef };
        var status = op.OperationKind == "cancel" ? "cancelling" : "reconciling";
        var cancellation = op.OperationKind == "cancel" ? "reconciling" : job.Cancellation;
        _state.Jobs[job.JobId] = Advance(job, status, $"{op.OperationKind}-dispatch-started", $"{op.OperationKind}-dispatch-started", cancellation: cancellation);
        AuditLocked(job.JobId, "mutation-admitted", new Dictionary<string, string> { ["operationId"] = operationId, ["effect"] = effectId, ["decisionRef"] = decisionRef });
        return true;
    }

    private static SeedAuthority AuthorityFor(string effectId, StewardSeedJob job, string source)
    {
        var target = $"target:{job.Subject.Id}:{job.Subject.Revision ?? "none"}";
        var principal = $"{source}:{job.AttemptId}";
        return new(source, principal, effectId, target, job.AttemptId, job.Version, job.Lease?.Owner, job.Lease?.FencingToken);
    }

    private static string OperationRequestDigest(StewardSeedJob job, string kind) => Digest(new { kind, slot = kind, subject = job.Subject, candidate = job.Candidate });

    private string EvaluateMutationLocked(string effectId, StewardSeedJob job, StewardOperation? operation, SeedCapability actualCapability, SeedAuthority authority)
    {
        if (!_policy.Effects.TryGetValue(effectId, out var effect)) return "CapabilityUnavailable";
        if (!IsCurrentLocked(job)) return "LostAuthority";
        var lineage = _state.Lineages[job.LineageId];
        if (lineage.Subject != job.Subject) return "LostAuthority";
        var cancellationDispatch = effectId == "cancellation-dispatch";
        var cancellationFenced = job.Cancellation is "requested" or "fenced" or "reconciling";
        if (Terminal.Contains(job.Status) || (!cancellationDispatch && cancellationFenced)) return "LostAuthority";
        if (cancellationDispatch && job.Cancellation is not ("requested" or "reconciling")) return "LostAuthority";
        var target = $"target:{job.Subject.Id}:{job.Subject.Revision ?? "none"}";
        if (!string.Equals(authority.Source, effect.AuthoritySource, StringComparison.Ordinal)
            || string.IsNullOrWhiteSpace(authority.Principal) || authority.Principal is "unknown" or "HEAD" or "latest"
            || authority.Scope != effectId || authority.Target != target || authority.AttemptId != job.AttemptId || authority.JobVersion != job.Version)
            return "LostAuthority";
        if (effect.LeaseRequired)
        {
            var expectedOwner = $"{effect.AuthoritySource}:{job.AttemptId}";
            if (job.Lease is null || authority.Principal != expectedOwner || job.Lease.Owner != expectedOwner || authority.LeaseOwner != expectedOwner
                || job.Lease.FencingToken != job.Generation || authority.LeaseFencingToken != job.Generation || job.Lease.ExpiresAt <= _clock.UtcNow)
                return "LostAuthority";
        }
        if (effect.CandidateRequired && string.IsNullOrWhiteSpace(job.Candidate.Digest)) return "StaleCandidate";
        if (actualCapability != effect.CapabilityContract || actualCapability.Id != effect.CapabilityRef) return "CapabilityUnavailable";
        if (job.ParentContract is { } parent)
        {
            // The supervised snapshot must still bind to the admission-time digest column
            // before any delegated authority is consulted (#95/#104); a caller-owned or
            // restored snapshot that drifted never regains parent authority.
            if (job.ParentContractDigest is null
                || !string.Equals(ParentContractDigest(parent), job.ParentContractDigest, StringComparison.Ordinal))
                return "ParentAuthorityInsufficient";
            // Effective authority is the intersection of local configuration and parent delegation (#95).
            // An explicitly empty delegation grants nothing; it is never a wildcard.
            // Local internal capabilities (steward-owned handoff/publication) are outside
            // the delegation scope — a parent cannot revoke the steward's own reporting.
            var isLocalCapability = effect.CapabilityRef.StartsWith("local:", StringComparison.Ordinal);
            if (!isLocalCapability)
            {
                if (parent.ForbiddenCapabilities.Contains(effect.CapabilityRef)) return "ParentAuthorityInsufficient";
                if (!parent.DelegatedCapabilities.Contains(effect.CapabilityRef)) return "ParentAuthorityInsufficient";
            }
        }
        if (job.DeadlineAt - _clock.UtcNow < TimeSpan.FromMilliseconds(effect.MinimumBudgetMs + effect.FinalizationReserveMs)) return "BudgetUnavailable";
        if (effect.DurableOperationRequired)
        {
            if (operation is null || operation.State != "reserved" || operation.Delivery != "not-delivered") return "ReconciliationRequired";
            if (operation.OperationKind != effect.OperationKind || operation.JobId != job.JobId || operation.LineageId != job.LineageId
                || operation.Generation != job.Generation || operation.AttemptId != job.AttemptId || operation.JobVersion != job.Version) return "LostAuthority";
            if (operation.RequestDigest != OperationRequestDigest(job, operation.OperationKind)) return "LostAuthority";
            if (operation.CandidateDigest != job.Candidate.Digest) return "StaleCandidate";
            if (operation.CapabilityIdentity != actualCapability.Id || operation.CapabilityContractDigest != actualCapability.Digest) return "CapabilityUnavailable";
            if (operation.TargetIdentity != target) return "LostAuthority";
        }
        return "Admitted";
    }

    private void BindDispatchLocked(string operationId, string handle, bool cancellationConfirmed)
    {
        var op = _state.Operations[operationId]; var job = CurrentJobLocked(op.JobId); var now = _clock.UtcNow;
        _state.Operations[operationId] = op with { State = cancellationConfirmed ? "captured" : "dispatched", Delivery = "delivered", RetryDisposition = "forbidden", RemoteHandle = handle, ObservedAt = now };
        if (IsCurrentLocked(job))
        {
            if (op.OperationKind == "cancel" && cancellationConfirmed) _state.Jobs[job.JobId] = Advance(job, "cancelled", "cancelled", "cancelled", cancellation: "completed");
            else if (op.OperationKind == "submit") _state.Jobs[job.JobId] = Advance(job, "waiting-external", "external-dispatched", "external-dispatched", cancellation: job.Cancellation);
        }
        AuditLocked(job.JobId, "external-dispatched", new Dictionary<string, string> { ["operationId"] = operationId, ["kind"] = op.OperationKind });
    }

