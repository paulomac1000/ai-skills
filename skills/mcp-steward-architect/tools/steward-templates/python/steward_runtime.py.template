"""Executable Steward v3 seed: durable gates, reconciliation, cancellation, evidence and recovery."""

from __future__ import annotations

import hashlib
import json
import logging
import os
import sqlite3
import threading
import uuid
from contextlib import contextmanager
from datetime import UTC, datetime, timedelta
from importlib.resources import files
from pathlib import Path
from typing import Any, Iterator

_LOGGER = logging.getLogger(__name__)
_AUTHORITY_RANK = {"advisory": 0, "observed": 1, "verified": 2, "independent": 3}
_TERMINAL = {"completed", "completed-with-gaps", "failed", "cancelled", "superseded"}
_RUNNABLE = {"queued", "reconciling", "waiting-external", "cancelling", "finalizing"}
_OBSERVATION_GRADES = {"declared", "observed", "observed-effective", "functional-ready", "verified"}
_PLACEHOLDER_AUTHORITY = {"", "unknown", "head", "latest", "default", "unset", "none"}


def _canonical(value: object) -> str:
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False)


def _digest(value: object) -> str:
    return "sha256:" + hashlib.sha256(_canonical(value).encode("utf-8")).hexdigest()


def compute_handoff_digest(value: dict[str, Any]) -> str:
    return _digest({key: item for key, item in value.items() if key != "digest"})


def _iso(value: datetime) -> str:
    return value.astimezone(UTC).isoformat().replace("+00:00", "Z")


def _parse(value: str) -> datetime:
    return datetime.fromisoformat(value.replace("Z", "+00:00")).astimezone(UTC)


def _capability_digest(capability: dict[str, Any]) -> str | None:
    contract = capability.get("contract")
    if not isinstance(contract, dict):
        return None
    projected = json.loads(json.dumps(capability))
    projected_contract = projected.get("contract")
    if not isinstance(projected_contract, dict):
        return None
    projected_contract.pop("digest", None)
    return _digest(projected)


def _target_identity(job: dict[str, Any]) -> str:
    subject = job["subject"]
    return f"{subject['type']}:{subject['id']}:{subject.get('revision') or 'none'}"


def _operation_request_digest(job: dict[str, Any], kind: str) -> str:
    return _digest({"kind": kind, "subject": job["subject"], "candidate": job["candidate"]})


def _evaluate_mutation(
    effect: dict[str, Any], job: dict[str, Any], capability: dict[str, Any], authority: dict[str, Any],
    *, current_job_id: str, current_generation: int, current_attempt_id: str, current_version: int,
    current_subject: dict[str, Any], remaining_budget_ms: int, expected_request_digest: str | None,
    receipt: dict[str, Any] | None, candidate: dict[str, Any] | None, now: datetime,
) -> dict[str, Any]:
    reasons: list[tuple[str, str]] = []
    if job["jobId"] != current_job_id or job["generation"] != current_generation:
        reasons.append(("LostAuthority", "stale job/generation"))
    if job["attemptId"] != current_attempt_id or int(job["version"]) != int(current_version):
        reasons.append(("LostAuthority", "stale attempt/version"))
    cancellation_dispatch = effect["id"] == "cancellation-dispatch"
    if job["status"] in _TERMINAL or (
        not cancellation_dispatch and job["cancellation"] in {"requested", "fenced", "reconciling"}
    ):
        reasons.append(("LostAuthority", "job is terminal or cancellation-fenced"))
    if cancellation_dispatch and job["cancellation"] not in {"requested", "reconciling"}:
        reasons.append(("LostAuthority", "cancellation dispatch requires an active cancellation request"))
    if job["subject"] != current_subject:
        reasons.append(("LostAuthority", "subject identity differs from current authoritative subject"))
    target = _target_identity(job)
    if authority.get("source") != effect["authority_source"]:
        reasons.append(("LostAuthority", "authority source mismatch"))
    principal = str(authority.get("principal", ""))
    if principal.casefold() in _PLACEHOLDER_AUTHORITY or authority.get("scope") != effect["id"] or authority.get("target") != target:
        reasons.append(("LostAuthority", "authority principal/scope/target mismatch"))
    if authority.get("attemptId") != current_attempt_id or int(authority.get("jobVersion", -1)) != int(current_version):
        reasons.append(("LostAuthority", "authority attempt/version fence mismatch"))
    if effect["lease_required"]:
        lease = job.get("lease")
        if not isinstance(lease, dict):
            reasons.append(("LostAuthority", "required lease missing"))
        else:
            if _parse(str(lease["expiresAt"])) <= now:
                reasons.append(("LostAuthority", "required lease expired"))
            expected_owner = f"{effect['authority_source']}:{current_attempt_id}"
            if authority.get("principal") != expected_owner or lease.get("owner") != expected_owner or authority.get("leaseOwner") != expected_owner:
                reasons.append(("LostAuthority", "lease owner does not match admitted runtime principal"))
            if lease.get("fencingToken") != current_generation or authority.get("leaseFencingToken") != current_generation:
                reasons.append(("LostAuthority", "lease fencing token does not match current generation"))
    if effect["candidate_required"]:
        if candidate is None or candidate != job.get("candidate"):
            reasons.append(("StaleCandidate", "exact candidate mismatch"))
    contract = capability.get("contract") if isinstance(capability.get("contract"), dict) else {}
    if capability.get("capability_id") != effect["capability_ref"] or contract.get("id") != capability.get("capability_id"):
        reasons.append(("CapabilityUnavailable", "capability identity mismatch"))
    if _capability_digest(capability) != contract.get("digest") or contract != effect["capability_contract"]:
        reasons.append(("CapabilityUnavailable", "capability contract differs from exact reviewed source/id/revision/digest"))
    required_budget_ms = int(effect["minimum_budget_ms"]) + int(effect["finalization_reserve_ms"])
    if remaining_budget_ms < required_budget_ms:
        reasons.append(("BudgetUnavailable", "remaining budget cannot cover operation plus deterministic finalization reserve"))
    if effect["durable_operation_required"]:
        if receipt is None:
            reasons.append(("ReconciliationRequired", "durable receipt missing"))
        else:
            if (receipt.get("jobId") != current_job_id or receipt.get("lineageId") != job["lineageId"]
                    or receipt.get("generation") != current_generation or receipt.get("attemptId") != current_attempt_id):
                reasons.append(("LostAuthority", "receipt stale job/lineage/generation/attempt"))
            if int(receipt.get("jobVersion", -1)) != int(current_version):
                reasons.append(("LostAuthority", "receipt stale optimistic version"))
            if receipt.get("operationKind") != effect["operation_kind"]:
                reasons.append(("LostAuthority", "receipt operation kind mismatch"))
            if expected_request_digest is None or receipt.get("requestDigest") != expected_request_digest:
                reasons.append(("LostAuthority", "receipt request digest mismatch"))
            if receipt.get("targetIdentity") != target:
                reasons.append(("LostAuthority", "receipt target mismatch"))
            if receipt.get("capabilityIdentity") != capability.get("capability_id") or receipt.get("capabilityContractDigest") != contract.get("digest"):
                reasons.append(("CapabilityUnavailable", "receipt capability provenance mismatch"))
            if candidate is not None and receipt.get("candidateDigest") != candidate.get("digest"):
                reasons.append(("StaleCandidate", "receipt candidate mismatch"))
            if receipt.get("state") != "reserved" or receipt.get("delivery") != "not-delivered":
                reasons.append(("ReconciliationRequired", "receipt is not reserved/not-delivered"))
    if reasons:
        return {"disposition": reasons[0][0], "reasons": [reason for _, reason in reasons]}
    return {"disposition": "Admitted", "reasons": []}


class SystemClock:
    def now(self) -> datetime:
        return datetime.now(UTC)


class FakeClock:
    def __init__(self, value: datetime) -> None:
        if value.tzinfo is None:
            raise ValueError("FakeClock requires timezone-aware datetime")
        self._value = value.astimezone(UTC)

    def now(self) -> datetime:
        return self._value

    def advance(self, seconds: float) -> None:
        self._value += timedelta(seconds=seconds)


class FaultInjector:
    def __init__(self, faults: set[str] | None = None) -> None:
        self._faults = set(faults or ())

    def trip(self, name: str) -> bool:
        if name not in self._faults:
            return False
        self._faults.remove(name)
        return True


class FakeProvider:
    producer_id = "seed-provider"

    def dispatch(self, operation_id: str, subject: dict[str, Any]) -> str:
        del subject
        return f"remote-{operation_id}"

    def reconcile(self, operation_id: str, subject: dict[str, Any]) -> str:
        del subject
        return f"remote-{operation_id}"

    def poll(self, remote_handle: str, subject: dict[str, Any]) -> dict[str, Any]:
        return {
            "state": "completed", "remoteHandle": remote_handle, "subject": subject, "revision": "terminal-1",
            "observation": {
                "producerId": self.producer_id, "observationGrade": "observed", "authorityClass": "observed",
                "binding": {"satisfied": ["target"]}, "coverage": {"required": 1, "observed": 1},
            },
        }

    def cancel(self, cancellation_operation_id: str, remote_handle: str, subject: dict[str, Any]) -> str:
        del remote_handle, subject
        return f"cancel-{cancellation_operation_id}"

    def reconcile_cancel(self, cancellation_operation_id: str, remote_handle: str, subject: dict[str, Any]) -> str:
        del remote_handle, subject
        return f"cancel-{cancellation_operation_id}"


class StewardStore:
    def __init__(self, path: Path, clock: SystemClock | FakeClock | None = None) -> None:
        self.path = path
        self.clock = clock or SystemClock()
        self.path.parent.mkdir(parents=True, exist_ok=True)
        self._init()

    def _connect(self) -> sqlite3.Connection:
        db = sqlite3.connect(self.path, timeout=10, isolation_level=None)
        db.row_factory = sqlite3.Row
        db.execute("PRAGMA journal_mode=WAL")
        db.execute("PRAGMA foreign_keys=ON")
        return db

    @contextmanager
    def _write(self) -> Iterator[sqlite3.Connection]:
        with self._connect() as db:
            db.execute("BEGIN IMMEDIATE")
            try:
                yield db
            except BaseException:
                db.rollback()
                raise
            else:
                db.commit()

    def _init(self) -> None:
        with self._connect() as db:
            db.executescript("""
            CREATE TABLE IF NOT EXISTS steward_jobs(
              job_id TEXT PRIMARY KEY,lineage_id TEXT,generation INTEGER,attempt_id TEXT,version INTEGER,
              subject_json TEXT,candidate_json TEXT,request_digest TEXT,status TEXT,stage TEXT,cancellation TEXT,
              blocked_reason TEXT,created_at TEXT,updated_at TEXT,heartbeat_at TEXT,progress_at TEXT,progress_revision INTEGER,
              progress_marker TEXT,deadline_at TEXT,finalization_starts_at TEXT,lease_owner TEXT,lease_fencing_token INTEGER,lease_expires_at TEXT);
            CREATE TABLE IF NOT EXISTS steward_lineages(
              lineage_id TEXT PRIMARY KEY,current_generation INTEGER,current_job_id TEXT,subject_json TEXT,candidate_json TEXT,version INTEGER);
            CREATE TABLE IF NOT EXISTS intake_idempotency(
              idempotency_key TEXT PRIMARY KEY,request_digest TEXT,job_id TEXT);
            CREATE TABLE IF NOT EXISTS external_operations(
              operation_id TEXT PRIMARY KEY,operation_kind TEXT,job_id TEXT,lineage_id TEXT,generation INTEGER,attempt_id TEXT,job_version INTEGER,
              capability_identity TEXT,capability_contract_digest TEXT,target_identity TEXT,candidate_digest TEXT,request_digest TEXT,
              state TEXT,delivery TEXT,retry_disposition TEXT,credential_slot_id TEXT,remote_handle TEXT,result_json TEXT,
              created_at TEXT,observed_at TEXT,reconcile_count INTEGER,mutation_decision_ref TEXT);
            CREATE TABLE IF NOT EXISTS steward_evidence(
              evidence_id TEXT PRIMARY KEY,job_id TEXT,lineage_id TEXT,generation INTEGER,subject_json TEXT,candidate_json TEXT,
              criterion_id TEXT,claim_id TEXT,evidence_class TEXT,observation_grade TEXT,authority_class TEXT,producer_id TEXT,
              proof_recipe_id TEXT,binding_json TEXT,coverage_json TEXT,observed_at TEXT,expires_at TEXT,payload_digest TEXT);
            CREATE TABLE IF NOT EXISTS completion_evaluations(job_id TEXT PRIMARY KEY,value_json TEXT);
            CREATE TABLE IF NOT EXISTS steward_handoffs(job_id TEXT PRIMARY KEY,value_json TEXT);
            CREATE TABLE IF NOT EXISTS audit_events(
              sequence INTEGER PRIMARY KEY AUTOINCREMENT,job_id TEXT,event_type TEXT,at TEXT,detail_json TEXT);
            CREATE UNIQUE INDEX IF NOT EXISTS external_operations_job_kind
              ON external_operations(job_id, operation_kind);
            """)

    def _audit(self, db: sqlite3.Connection, job_id: str | None, event: str, detail: dict[str, Any]) -> None:
        db.execute(
            "INSERT INTO audit_events(job_id,event_type,at,detail_json) VALUES(?,?,?,?)",
            (job_id, event, _iso(self.clock.now()), _canonical(detail)),
        )

    def record_recovery_failure(self, exception: Exception) -> None:
        with self._write() as db:
            self._audit(db, None, "recovery-failure", {"failureClass": type(exception).__name__})

    def _candidate(self, subject: dict[str, Any]) -> dict[str, Any]:
        material = {"type": "subject-snapshot", "id": subject["id"], "revision": subject.get("revision")}
        return {**material, "digest": _digest(material)}

    def admit(self, subject: dict[str, Any], idempotency_key: str) -> dict[str, Any]:
        subject = {"type": "target", "id": str(subject["id"]), "revision": subject.get("revision")}
        candidate = self._candidate(subject)
        request_digest = _digest({"subject": subject, "candidate": candidate})
        lineage_id = "lineage-" + hashlib.sha256(_canonical({"type": subject["type"], "id": subject["id"]}).encode("utf-8")).hexdigest()[:24]
        now_dt = self.clock.now()
        now = _iso(now_dt)
        deadline = _iso(now_dt + timedelta(minutes=15))
        with self._write() as db:
            previous = db.execute(
                "SELECT request_digest,job_id FROM intake_idempotency WHERE idempotency_key=?", (idempotency_key,)
            ).fetchone()
            if previous:
                if previous["request_digest"] != request_digest:
                    raise RuntimeError("idempotency key is bound to a different request digest")
                return {"jobId": str(previous["job_id"]), "duplicate": True}
            lineage = db.execute(
                "SELECT current_generation,current_job_id FROM steward_lineages WHERE lineage_id=?", (lineage_id,)
            ).fetchone()
            generation = 1 if lineage is None else int(lineage["current_generation"]) + 1
            job_id, attempt_id = f"job-{uuid.uuid4().hex}", f"attempt-{uuid.uuid4().hex}"
            if lineage is not None:
                previous_job_id = str(lineage["current_job_id"])
                superseded = db.execute(
                    "UPDATE steward_jobs SET status='superseded',stage='superseded',version=version+1,updated_at=?,"
                    "progress_at=?,progress_revision=progress_revision+1,progress_marker='superseded' "
                    "WHERE job_id=? AND status NOT IN ('completed','completed-with-gaps','failed','cancelled','superseded')",
                    (now, now, previous_job_id),
                )
                if superseded.rowcount:
                    db.execute(
                        "UPDATE external_operations SET state='abandoned',observed_at=? WHERE job_id=? AND state='reserved' AND delivery='not-delivered'",
                        (now, previous_job_id),
                    )
                    self._audit(db, previous_job_id, "superseded", {"byJobId": job_id, "generation": generation})
            db.execute(
                "INSERT INTO steward_jobs("
                "job_id,lineage_id,generation,attempt_id,version,subject_json,candidate_json,request_digest,status,stage,cancellation,"
                "blocked_reason,created_at,updated_at,heartbeat_at,progress_at,progress_revision,progress_marker,deadline_at,"
                "finalization_starts_at,lease_owner,lease_fencing_token,lease_expires_at) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
                (job_id, lineage_id, generation, attempt_id, 0, _canonical(subject), _canonical(candidate), request_digest,
                 "queued", "admitted", "none", None, now, now, now, now, 1, "admitted", deadline, None,
                 f"steward-runtime:{attempt_id}", generation, deadline),
            )
            db.execute(
                "INSERT INTO steward_lineages VALUES(?,?,?,?,?,0) ON CONFLICT(lineage_id) DO UPDATE SET "
                "current_generation=excluded.current_generation,current_job_id=excluded.current_job_id,"
                "subject_json=excluded.subject_json,candidate_json=excluded.candidate_json,version=version+1",
                (lineage_id, generation, job_id, _canonical(subject), _canonical(candidate)),
            )
            db.execute("INSERT INTO intake_idempotency VALUES(?,?,?)", (idempotency_key, request_digest, job_id))
            self._audit(db, job_id, "admitted", {"generation": generation, "candidateDigest": candidate["digest"]})
        return {"jobId": job_id, "duplicate": False}

    def job(self, job_id: str) -> dict[str, Any]:
        with self._connect() as db:
            row = db.execute("SELECT * FROM steward_jobs WHERE job_id=?", (job_id,)).fetchone()
            refs = db.execute("SELECT operation_id FROM external_operations WHERE job_id=? ORDER BY created_at", (job_id,)).fetchall()
            evrefs = db.execute("SELECT evidence_id FROM steward_evidence WHERE job_id=? ORDER BY observed_at", (job_id,)).fetchall()
        if row is None:
            raise KeyError(job_id)
        lease = None if row["status"] in _TERMINAL or row["lease_owner"] is None else {
            "owner": row["lease_owner"], "fencingToken": row["lease_fencing_token"], "expiresAt": row["lease_expires_at"]
        }
        return {
            "schema_version": 2, "jobId": row["job_id"], "lineageId": row["lineage_id"], "generation": row["generation"],
            "attemptId": row["attempt_id"], "version": row["version"], "subject": json.loads(row["subject_json"]),
            "candidate": json.loads(row["candidate_json"]), "requestDigest": row["request_digest"], "status": row["status"],
            "stage": row["stage"], "createdAt": row["created_at"], "updatedAt": row["updated_at"],
            "heartbeatAt": row["heartbeat_at"], "progressAt": row["progress_at"], "progressRevision": row["progress_revision"],
            "progressMarker": row["progress_marker"], "deadlineAt": row["deadline_at"],
            "finalizationStartsAt": row["finalization_starts_at"], "lease": lease, "cancellation": row["cancellation"],
            "blockedReason": row["blocked_reason"], "externalOperationRefs": [str(item[0]) for item in refs],
            "evidenceRefs": [str(item[0]) for item in evrefs], "artifactRefs": [], "failure": None,
        }

    def current_lineage(self, lineage_id: str) -> dict[str, Any]:
        with self._connect() as db:
            row = db.execute("SELECT * FROM steward_lineages WHERE lineage_id=?", (lineage_id,)).fetchone()
        if row is None:
            raise KeyError(lineage_id)
        return {"currentGeneration": row["current_generation"], "currentJobId": row["current_job_id"],
                "subject": json.loads(row["subject_json"]), "candidate": json.loads(row["candidate_json"])}

    def _advance(self, db: sqlite3.Connection, job_id: str, *, status: str | None = None, stage: str,
                 marker: str, cancellation: str | None = None, blocked_reason: str | None = None) -> None:
        now = _iso(self.clock.now())
        fields = ["stage=?", "updated_at=?", "heartbeat_at=?", "progress_at=?", "progress_revision=progress_revision+1", "progress_marker=?", "version=version+1"]
        values: list[Any] = [stage, now, now, now, marker]
        if status is not None:
            fields.append("status=?"); values.append(status)
        if cancellation is not None:
            fields.append("cancellation=?"); values.append(cancellation)
        if blocked_reason is not None:
            fields.append("blocked_reason=?"); values.append(blocked_reason)
        values.append(job_id)
        db.execute(f"UPDATE steward_jobs SET {','.join(fields)} WHERE job_id=?", tuple(values))

    def heartbeat(self, job_id: str) -> None:
        with self._write() as db:
            db.execute("UPDATE steward_jobs SET heartbeat_at=? WHERE job_id=?", (_iso(self.clock.now()), job_id))

    def next_job(self) -> dict[str, Any] | None:
        marks = ",".join("?" for _ in _RUNNABLE)
        with self._connect() as db:
            row = db.execute(
                f"SELECT job_id FROM steward_jobs WHERE status IN ({marks}) ORDER BY CASE WHEN status='waiting-external' THEN 1 ELSE 0 END,created_at,job_id LIMIT 1",
                tuple(sorted(_RUNNABLE)),
            ).fetchone()
        return None if row is None else self.job(str(row[0]))

    def operation_for_job(self, job_id: str, kind: str = "submit") -> dict[str, Any] | None:
        with self._connect() as db:
            rows = db.execute(
                "SELECT * FROM external_operations WHERE job_id=? ORDER BY created_at,operation_id", (job_id,)
            ).fetchall()
        exact = [row for row in rows if row["operation_kind"] == kind]
        if exact:
            return dict(exact[0])
        # A persisted receipt whose self-declared kind was corrupted must still reach
        # the compositional gate; otherwise the scheduler would silently reserve a
        # replacement and turn a typed admission failure into an identity bypass.
        if kind == "submit" and rows:
            return dict(rows[0])
        if kind == "cancel" and len(rows) > 1:
            return dict(rows[-1])
        return None

    def _is_current_tx(self, db: sqlite3.Connection, job_id: str, generation: int, attempt_id: str) -> bool:
        row = db.execute(
            "SELECT j.status,j.attempt_id,l.current_job_id,l.current_generation FROM steward_jobs j "
            "JOIN steward_lineages l ON l.lineage_id=j.lineage_id WHERE j.job_id=?", (job_id,),
        ).fetchone()
        return bool(row is not None and row["status"] not in _TERMINAL and row["attempt_id"] == attempt_id
                    and row["current_job_id"] == job_id and int(row["current_generation"]) == generation)

    def reserve_external(self, job_id: str, capability: dict[str, Any], kind: str = "submit") -> dict[str, Any]:
        job = self.job(job_id)
        existing = self.operation_for_job(job_id, kind)
        if existing is not None:
            return existing
        operation_id = f"operation-{uuid.uuid4().hex}"
        now = _iso(self.clock.now())
        target = _target_identity(job)
        request_digest = _operation_request_digest(job, kind)
        with self._write() as db:
            existing_row = db.execute(
                "SELECT * FROM external_operations WHERE job_id=? AND operation_kind=?", (job_id, kind)
            ).fetchone()
            if existing_row is not None:
                return dict(existing_row)
            if not self._is_current_tx(db, job_id, int(job["generation"]), str(job["attemptId"])):
                raise RuntimeError("stale lineage operation reservation")
            db.execute(
                "INSERT INTO external_operations VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,0,NULL)",
                (operation_id, kind, job_id, job["lineageId"], job["generation"], job["attemptId"], int(job["version"]) + 1,
                 capability["capability_id"], capability["contract"]["digest"], target, job["candidate"]["digest"],
                 request_digest, "reserved", "not-delivered", "forbidden", "primary", None, None, now, now),
            )
            self._advance(db, job_id, stage=f"{kind}-reserved", marker=f"{kind}-reserved")
            self._audit(db, job_id, "external-reserved", {"operationId": operation_id, "kind": kind,
                        "capabilityContractDigest": capability["contract"]["digest"]})
        return self.operation_for_job(job_id, kind) or {}

    @staticmethod
    def _receipt_view(op: sqlite3.Row | dict[str, Any]) -> dict[str, Any]:
        return {
            "jobId": op["job_id"], "lineageId": op["lineage_id"], "generation": op["generation"],
            "attemptId": op["attempt_id"], "jobVersion": op["job_version"], "operationKind": op["operation_kind"],
            "requestDigest": op["request_digest"], "capabilityIdentity": op["capability_identity"],
            "capabilityContractDigest": op["capability_contract_digest"], "targetIdentity": op["target_identity"],
            "candidateDigest": op["candidate_digest"], "state": op["state"], "delivery": op["delivery"],
        }

    def begin_dispatch(
        self, operation_id: str, effect: dict[str, Any], capability: dict[str, Any], authority: dict[str, Any]
    ) -> dict[str, Any]:
        now = self.clock.now()
        with self._write() as db:
            op = db.execute("SELECT * FROM external_operations WHERE operation_id=?", (operation_id,)).fetchone()
            if op is None:
                raise KeyError(operation_id)
            row = db.execute("SELECT * FROM steward_jobs WHERE job_id=?", (op["job_id"],)).fetchone()
            lineage = db.execute("SELECT * FROM steward_lineages WHERE lineage_id=?", (row["lineage_id"],)).fetchone()
            if row is None or lineage is None:
                raise RuntimeError("mutation admission lost canonical job/lineage")
            lease = None if row["status"] in _TERMINAL or row["lease_owner"] is None else {
                "owner": row["lease_owner"], "fencingToken": row["lease_fencing_token"], "expiresAt": row["lease_expires_at"]
            }
            job = {
                "jobId": row["job_id"], "lineageId": row["lineage_id"], "generation": row["generation"],
                "attemptId": row["attempt_id"], "version": row["version"], "subject": json.loads(row["subject_json"]),
                "candidate": json.loads(row["candidate_json"]), "status": row["status"], "cancellation": row["cancellation"],
                "deadlineAt": row["deadline_at"], "lease": lease,
            }
            budget_ms = max(0, int((_parse(job["deadlineAt"]) - now).total_seconds() * 1000))
            decision = _evaluate_mutation(
                effect, job, capability, authority,
                current_job_id=str(lineage["current_job_id"]), current_generation=int(lineage["current_generation"]),
                current_attempt_id=str(row["attempt_id"]), current_version=int(row["version"]),
                current_subject=json.loads(lineage["subject_json"]), remaining_budget_ms=budget_ms,
                expected_request_digest=_operation_request_digest(job, str(op["operation_kind"])),
                receipt=self._receipt_view(op), candidate=job["candidate"], now=now,
            )
            if decision["disposition"] != "Admitted":
                reason = f"mutation-admission:{decision['disposition']}"
                self._advance(db, str(op["job_id"]), status="blocked", stage="mutation-admission-rejected",
                              marker=reason, blocked_reason=reason)
                self._audit(db, str(op["job_id"]), "mutation-admission-rejected",
                            {"operationId": operation_id, "effect": effect["id"], "disposition": decision["disposition"]})
                return decision
            decision_ref = f"admission-{uuid.uuid4().hex}"
            db.execute(
                "UPDATE external_operations SET state='dispatching',delivery='delivery-unknown',retry_disposition='reconcile-first',"
                "observed_at=?,mutation_decision_ref=? WHERE operation_id=?",
                (_iso(now), decision_ref, operation_id),
            )
            status = "cancelling" if op["operation_kind"] == "cancel" else "reconciling"
            cancellation = "reconciling" if op["operation_kind"] == "cancel" else None
            self._advance(db, str(op["job_id"]), status=status, stage=f"{op['operation_kind']}-dispatch-started",
                          marker=f"{op['operation_kind']}-dispatch-started", cancellation=cancellation)
            self._audit(db, str(op["job_id"]), "mutation-admitted",
                        {"operationId": operation_id, "effect": effect["id"], "decisionRef": decision_ref})
            return {"disposition": "Admitted", "reasons": [], "decisionRef": decision_ref}

    def bind_dispatch(self, operation_id: str, remote_handle: str, *, observed: bool = False) -> None:
        now = _iso(self.clock.now())
        with self._write() as db:
            op = db.execute("SELECT * FROM external_operations WHERE operation_id=?", (operation_id,)).fetchone()
            if op is None:
                raise KeyError(operation_id)
            state = "captured" if observed else "dispatched"
            db.execute(
                "UPDATE external_operations SET state=?,delivery='delivered',retry_disposition='forbidden',remote_handle=?,observed_at=? WHERE operation_id=?",
                (state, remote_handle, now, operation_id),
            )
            if op["operation_kind"] == "cancel" and observed:
                db.execute(
                    "UPDATE external_operations SET state='captured',delivery='delivered',retry_disposition='forbidden',observed_at=? WHERE job_id=? AND operation_kind='submit' AND state NOT IN ('captured','abandoned','failed')",
                    (now, str(op["job_id"])),
                )
            if self._is_current_tx(db, str(op["job_id"]), int(op["generation"]), str(op["attempt_id"])):
                if op["operation_kind"] == "cancel" and observed:
                    self._advance(db, str(op["job_id"]), status="cancelled", stage="cancelled", marker="cancelled", cancellation="completed")
                elif op["operation_kind"] == "submit":
                    self._advance(db, str(op["job_id"]), status="waiting-external", stage="external-dispatched", marker="external-dispatched")
            self._audit(db, str(op["job_id"]), "external-dispatched", {"operationId": operation_id, "kind": op["operation_kind"]})

    def reconcile_operation(self, operation_id: str, remote_handle: str, *, cancellation_confirmed: bool = False) -> None:
        now = _iso(self.clock.now())
        with self._write() as db:
            op = db.execute("SELECT * FROM external_operations WHERE operation_id=?", (operation_id,)).fetchone()
            if op is None:
                raise KeyError(operation_id)
            state = "captured" if cancellation_confirmed else "dispatched"
            db.execute(
                "UPDATE external_operations SET state=?,delivery='delivered',retry_disposition='forbidden',remote_handle=?,observed_at=?,reconcile_count=reconcile_count+1 WHERE operation_id=?",
                (state, remote_handle, now, operation_id),
            )
            if cancellation_confirmed:
                db.execute(
                    "UPDATE external_operations SET state='captured',delivery='delivered',retry_disposition='forbidden',observed_at=? WHERE job_id=? AND operation_kind='submit' AND state NOT IN ('captured','abandoned','failed')",
                    (now, str(op["job_id"])),
                )
            current = self._is_current_tx(db, str(op["job_id"]), int(op["generation"]), str(op["attempt_id"]))
            if current:
                if op["operation_kind"] == "cancel" and cancellation_confirmed:
                    self._advance(db, str(op["job_id"]), status="cancelled", stage="cancelled", marker="cancelled", cancellation="completed")
                elif op["operation_kind"] == "submit":
                    self._advance(db, str(op["job_id"]), status="waiting-external", stage="reconciled", marker="reconciled")
            self._audit(db, str(op["job_id"]), "reconciled", {"operationId": operation_id, "kind": op["operation_kind"]})

    def capture_result(self, operation_id: str, payload: dict[str, Any]) -> None:
        now = _iso(self.clock.now())
        with self._write() as db:
            op = db.execute("SELECT * FROM external_operations WHERE operation_id=?", (operation_id,)).fetchone()
            if op is None:
                raise KeyError(operation_id)
            if op["result_json"] is not None:
                return
            if not self._is_current_tx(db, str(op["job_id"]), int(op["generation"]), str(op["attempt_id"])):
                raise RuntimeError("stale lineage result")
            db.execute("UPDATE external_operations SET state='captured',result_json=?,observed_at=? WHERE operation_id=?",
                       (_canonical(payload), now, operation_id))
            self._advance(db, str(op["job_id"]), stage="result-captured", marker=f"result:{_digest(payload)}")
            self._audit(db, str(op["job_id"]), "result-captured", {"operationId": operation_id, "digest": _digest(payload)})

    def result_payload(self, operation_id: str) -> dict[str, Any] | None:
        with self._connect() as db:
            row = db.execute("SELECT result_json FROM external_operations WHERE operation_id=?", (operation_id,)).fetchone()
        return None if row is None or row[0] is None else json.loads(row[0])

    def evidence(self, job_id: str) -> list[dict[str, Any]]:
        with self._connect() as db:
            rows = db.execute("SELECT * FROM steward_evidence WHERE job_id=? ORDER BY observed_at", (job_id,)).fetchall()
        return [{"schema_version":2,"evidenceId":r["evidence_id"],"jobId":r["job_id"],"lineageId":r["lineage_id"],
                 "generation":r["generation"],"subject":json.loads(r["subject_json"]),"candidate":json.loads(r["candidate_json"]),
                 "criterionId":r["criterion_id"],"claimId":r["claim_id"],"evidenceClass":r["evidence_class"],
                 "observationGrade":r["observation_grade"],"authorityClass":r["authority_class"],"producerId":r["producer_id"],
                 "proofRecipeId":r["proof_recipe_id"],"binding":json.loads(r["binding_json"]),"coverage":json.loads(r["coverage_json"]),
                 "observedAt":r["observed_at"],"expiresAt":r["expires_at"],"payloadDigest":r["payload_digest"]} for r in rows]

    def persist_evidence(
        self, job_id: str, requirement: dict[str, Any], criterion: dict[str, Any], adapter_producer_id: str,
        payload: dict[str, Any], recipe_id: str, operation: dict[str, Any], producer: dict[str, Any],
    ) -> bool:
        observation = payload.get("observation")
        if not isinstance(observation, dict) or observation.get("producerId") != adapter_producer_id:
            return False
        producer_id = str(observation.get("producerId", ""))
        if producer_id != producer.get("producer_id"):
            return False
        if criterion["approved_producers"] and producer_id not in criterion["approved_producers"]:
            return False
        authority = str(observation.get("authorityClass", ""))
        if authority not in _AUTHORITY_RANK:
            return False
        ceiling = str(producer.get("authority_ceiling", "advisory"))
        if ceiling not in _AUTHORITY_RANK:
            return False
        if _AUTHORITY_RANK[authority] > _AUTHORITY_RANK[ceiling]:
            authority = ceiling
        binding_observation = observation.get("binding")
        coverage_observation = observation.get("coverage")
        if not isinstance(binding_observation, dict) or not isinstance(coverage_observation, dict):
            return False
        job = self.job(job_id)
        if payload.get("subject") != job["subject"]:
            return False
        actual_satisfied = {str(item) for item in binding_observation.get("satisfied", [])}
        if operation.get("candidate_digest") == job["candidate"]["digest"]:
            actual_satisfied.add("candidate")
        required = [str(item) for item in criterion["binding_requirements"]]
        satisfied = [item for item in required if item in actual_satisfied]
        binding_status = "complete" if set(required) <= set(satisfied) else ("partial" if satisfied else "unknown")
        binding = {"required": required, "satisfied": satisfied, "status": binding_status}
        try:
            required_count = int(coverage_observation["required"])
            observed_count = int(coverage_observation["observed"])
        except (KeyError, TypeError, ValueError):
            return False
        if required_count < 1 or observed_count < 0 or observed_count > required_count:
            return False
        coverage_state = "complete" if observed_count >= required_count else ("partial" if observed_count else "unknown")
        coverage = {"state": coverage_state, "required": required_count, "observed": observed_count}
        observation_grade = str(observation.get("observationGrade", ""))
        if observation_grade not in _OBSERVATION_GRADES:
            return False
        try:
            observed = _parse(str(operation["observed_at"]))
        except (KeyError, TypeError, ValueError):
            return False
        evidence_id = f"evidence-{uuid.uuid4().hex}"
        with self._write() as db:
            if not self._is_current_tx(db, job_id, int(job["generation"]), str(job["attemptId"])):
                raise RuntimeError("stale lineage evidence")
            db.execute(
                "INSERT INTO steward_evidence VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
                (evidence_id, job_id, job["lineageId"], job["generation"], _canonical(job["subject"]), _canonical(job["candidate"]),
                 requirement["id"], criterion["canonical_claim"], requirement["evidence_class"], observation_grade,
                 authority, producer_id, recipe_id, _canonical(binding), _canonical(coverage), _iso(observed),
                 _iso(observed + timedelta(seconds=int(criterion["freshness_seconds"]))), _digest(payload)),
            )
            self._advance(db, job_id, status="finalizing", stage="evidence-persisted", marker=f"evidence:{evidence_id}")
            self._audit(db, job_id, "evidence-persisted", {"evidenceId": evidence_id, "claimId": criterion["canonical_claim"],
                        "authorityClass": authority, "bindingStatus": binding_status, "coverageState": coverage_state})
        return True

    def block(self, job_id: str, reason: str) -> None:
        with self._write() as db:
            self._advance(db, job_id, status="blocked", stage="blocked", marker=f"blocked:{reason}", blocked_reason=reason)
            self._audit(db, job_id, "blocked", {"reason": reason})

    def unresolved_lineage_operations(self, job_id: str) -> list[str]:
        with self._connect() as db:
            rows = db.execute(
                "SELECT o.operation_id FROM external_operations o JOIN steward_jobs owner ON owner.job_id=o.job_id "
                "JOIN steward_jobs current ON current.job_id=? WHERE owner.lineage_id=current.lineage_id "
                "AND o.state NOT IN ('captured','abandoned','failed') ORDER BY o.operation_id", (job_id,),
            ).fetchall()
        return [str(row[0]) for row in rows]

    def unknown_delivery_operations(self) -> list[dict[str, Any]]:
        with self._connect() as db:
            rows = db.execute(
                "SELECT * FROM external_operations WHERE delivery='delivery-unknown' ORDER BY observed_at,operation_id"
            ).fetchall()
        return [dict(row) for row in rows]

    def next_stale_operation(self) -> dict[str, Any] | None:
        with self._connect() as db:
            row = db.execute(
                "SELECT o.* FROM external_operations o JOIN steward_jobs j ON j.job_id=o.job_id "
                "WHERE j.status='superseded' AND o.state NOT IN ('captured','abandoned','failed') "
                "AND o.delivery IN ('delivery-unknown','delivered') ORDER BY o.observed_at,o.operation_id LIMIT 1"
            ).fetchone()
        return None if row is None else dict(row)

    def cancel(self, job_id: str) -> dict[str, Any]:
        with self._write() as db:
            current = db.execute("SELECT status FROM steward_jobs WHERE job_id=?", (job_id,)).fetchone()
            if current is None:
                raise KeyError(job_id)
            if current["status"] not in _TERMINAL:
                self._advance(db, job_id, status="cancelling", stage="cancel-requested", marker="cancel-requested", cancellation="requested")
                self._audit(db, job_id, "cancel-requested", {})
        return self.job(job_id)

    def finish_cancel_without_remote(self, job_id: str) -> None:
        with self._write() as db:
            submit = db.execute("SELECT * FROM external_operations WHERE job_id=? AND operation_kind='submit'", (job_id,)).fetchone()
            if submit is not None and submit["delivery"] != "not-delivered" and submit["state"] not in {"captured", "abandoned"}:
                raise RuntimeError("cannot terminalize cancellation while remote effect is unresolved")
            if submit is not None and submit["delivery"] == "not-delivered":
                db.execute("UPDATE external_operations SET state='abandoned',observed_at=? WHERE operation_id=?",
                           (_iso(self.clock.now()), submit["operation_id"]))
            self._advance(db, job_id, status="cancelled", stage="cancelled", marker="cancelled", cancellation="completed")
            self._audit(db, job_id, "cancelled", {"remoteStop": "not-required"})

    def save_terminal(
        self, job_id: str, completion: dict[str, Any], handoff: dict[str, Any], *,
        expected_attempt_id: str, expected_version: int, mutation_decision_ref: str,
    ) -> None:
        with self._write() as db:
            row = db.execute(
                "SELECT j.generation,j.candidate_json,j.attempt_id,j.version,l.current_generation,l.current_job_id,l.candidate_json "
                "FROM steward_jobs j JOIN steward_lineages l ON l.lineage_id=j.lineage_id WHERE j.job_id=?", (job_id,),
            ).fetchone()
            if (row is None or row[0] != row[4] or row[5] != job_id or row[1] != row[6]
                    or row[2] != expected_attempt_id or int(row[3]) != int(expected_version)):
                raise RuntimeError("stale lineage/candidate/attempt/version publication")
            if self.unresolved_lineage_operations(job_id):
                raise RuntimeError("completion blocked by unresolved lineage operation")
            db.execute("INSERT OR REPLACE INTO completion_evaluations VALUES(?,?)", (job_id, _canonical(completion)))
            db.execute("INSERT OR REPLACE INTO steward_handoffs VALUES(?,?)", (job_id, _canonical(handoff)))
            self._advance(db, job_id, status="completed", stage="completed", marker="completed")
            self._audit(db, job_id, "handoff-sealed", {"digest": handoff["digest"], "candidate": handoff["candidate"]["digest"],
                        "mutationDecisionRef": mutation_decision_ref})

    def result(self, job_id: str) -> dict[str, Any]:
        # Read the job first. Terminal publication is monotonic: save_terminal commits
        # completion, handoff and status=completed atomically, so once completed is
        # observed, the sealed bundle must already be visible to later reads.
        job = self.job(job_id)
        terminal_publication = job["status"] == "completed"
        with self._connect() as db:
            completion = None
            handoff = None
            if terminal_publication:
                completion = db.execute(
                    "SELECT value_json FROM completion_evaluations WHERE job_id=?", (job_id,)
                ).fetchone()
                handoff = db.execute(
                    "SELECT value_json FROM steward_handoffs WHERE job_id=?", (job_id,)
                ).fetchone()
            operations = [
                dict(row)
                for row in db.execute(
                    "SELECT * FROM external_operations WHERE job_id=? ORDER BY created_at", (job_id,)
                ).fetchall()
            ]
        if terminal_publication and (completion is None or handoff is None):
            raise RuntimeError("completed Steward job is missing its sealed completion/handoff bundle")
        return {
            "job": job,
            "operations": operations,
            "evidence": self.evidence(job_id),
            "completion": None if completion is None else json.loads(completion[0]),
            "handoff": None if handoff is None else json.loads(handoff[0]),
        }

    def audit(self, job_id: str | None) -> list[dict[str, Any]]:
        with self._connect() as db:
            rows = db.execute("SELECT * FROM audit_events ORDER BY sequence DESC LIMIT 50").fetchall() if job_id is None else db.execute(
                "SELECT * FROM audit_events WHERE job_id=? ORDER BY sequence DESC LIMIT 50", (job_id,)
            ).fetchall()
        return [dict(row) for row in rows]


class StewardRuntime:
    def __init__(
        self, store: StewardStore, profile: dict[str, Any], proof_recipe: dict[str, Any], mutation_policy: dict[str, Any], *,
        upstream: dict[str, Any], provider: FakeProvider | None = None, faults: FaultInjector | None = None,
    ) -> None:
        if not isinstance(upstream, dict) or not isinstance(mutation_policy, dict):
            raise ValueError("explicit reviewed upstream capability and mutation policy are required")
        self.store, self.profile, self.proof_recipe = store, profile, proof_recipe
        self.mutation_policy, self.upstream = mutation_policy, upstream
        self.provider, self.faults = provider or FakeProvider(), faults or FaultInjector()
        self._stop, self._thread = threading.Event(), None
        self._tick = 0

    @property
    def recipe_id(self) -> str:
        return f"{self.proof_recipe['recipe_id']}@{self.proof_recipe['revision']}"

    def _effect(self, effect_id: str) -> dict[str, Any]:
        for effect in self.mutation_policy["effects"]:
            if effect["id"] == effect_id:
                return effect
        raise RuntimeError(f"mutation policy has no effect {effect_id}")

    def _producer(self, producer_id: str) -> dict[str, Any] | None:
        for producer in self.proof_recipe["producers"]:
            if producer["producer_id"] == producer_id:
                return producer
        return None

    @staticmethod
    def _local_handoff_capability() -> dict[str, Any]:
        identity = {"source": "local", "id": "local:handoff@1", "revision": "1"}
        capability: dict[str, Any] = {
            "capability_id": "local:handoff@1",
            "contract": {**identity, "digest": "sha256:" + "0" * 64},
        }
        capability["contract"]["digest"] = _capability_digest(capability)
        return capability

    def _authority(self, effect_id: str, job: dict[str, Any], *, source: str, target: str) -> dict[str, Any]:
        lease = job.get("lease") if isinstance(job.get("lease"), dict) else None
        # Authority is derived from the admitted runtime principal, never from the
        # lease payload being proven. Otherwise a forged lease owner could mint its
        # own matching authority by construction.
        principal = f"{source}:{job['attemptId']}"
        return {
            "source": source, "principal": principal, "scope": effect_id, "target": target,
            "attemptId": job["attemptId"], "jobVersion": job["version"],
            "leaseOwner": None if lease is None else lease["owner"],
            "leaseFencingToken": None if lease is None else lease["fencingToken"],
        }

    def submit(self, subject_id: str, subject_revision: str | None, idempotency_key: str) -> dict[str, Any]:
        if not idempotency_key:
            raise ValueError("idempotency_key is required")
        return self.store.admit({"id": subject_id, "revision": subject_revision}, idempotency_key)

    def status(self, job_id: str) -> dict[str, Any]:
        return self.store.job(job_id)

    def get(self, job_id: str) -> dict[str, Any]:
        return self.store.result(job_id)

    def cancel(self, job_id: str) -> dict[str, Any]:
        return self.store.cancel(job_id)

    def doctor(self, job_id: str | None = None) -> dict[str, Any]:
        operations = self.store.unknown_delivery_operations() if job_id is None else self.store.result(job_id)["operations"]
        unknown = [item for item in operations if item["delivery"] == "delivery-unknown"]
        cancel_unknown = [item for item in unknown if item["operation_kind"] == "cancel"]
        return {"job": None if job_id is None else self.store.job(job_id), "deliveryUnknown": len(unknown),
                "cancellationUnknown": len(cancel_unknown), "audit": self.store.audit(job_id)}

    def _criterion(self, obligation_id: str) -> dict[str, Any]:
        for criterion in self.proof_recipe["criteria"]:
            if criterion["criterion_id"] == obligation_id:
                return criterion
        raise RuntimeError(f"proof recipe has no criterion for obligation {obligation_id}")

    def _provider_approved(self, criterion: dict[str, Any]) -> bool:
        return not criterion["approved_producers"] or self.provider.producer_id in criterion["approved_producers"]

    @staticmethod
    def _coverage_satisfies(criterion: dict[str, Any], evidence: dict[str, Any]) -> bool:
        coverage = evidence["coverage"]
        semantics = criterion["coverage_semantics"]
        if semantics in {"all-required", "complete-negative-coverage"}:
            return coverage["state"] == "complete" and coverage["observed"] >= coverage["required"]
        if semantics == "any-sufficient":
            return coverage["observed"] > 0
        return False

    def completion_gate(self, job_id: str) -> dict[str, Any]:
        job = self.store.job(job_id)
        lineage = self.store.current_lineage(job["lineageId"])
        if lineage["currentJobId"] != job_id or lineage["currentGeneration"] != job["generation"]:
            raise RuntimeError("stale lineage publication")
        if lineage["subject"] != job["subject"] or lineage["candidate"] != job["candidate"]:
            raise RuntimeError("stale subject/candidate identity")
        now, evidence = self.store.clock.now(), self.store.evidence(job_id)
        unresolved = self.store.unresolved_lineage_operations(job_id)
        cancel_refs = [item["operation_id"] for item in self.store.result(job_id)["operations"]
                       if item["operation_kind"] == "cancel" and item["state"] not in {"captured", "abandoned", "failed"}]
        obligations, blocked = [], bool(unresolved or cancel_refs)
        for requirement in self.profile["completion"]["obligations"]:
            criterion, refs = self._criterion(requirement["id"]), []
            for item in evidence:
                observed, expires = _parse(item["observedAt"]), _parse(item["expiresAt"]) if item["expiresAt"] else None
                valid = (
                    item["jobId"] == job_id and item["generation"] == job["generation"] and item["lineageId"] == job["lineageId"]
                    and item["subject"] == job["subject"] and item["candidate"] == job["candidate"]
                    and item["criterionId"] == requirement["id"] and item["claimId"] == criterion["canonical_claim"]
                    and item["evidenceClass"] == requirement["evidence_class"] and item["proofRecipeId"] == self.recipe_id
                    and (not criterion["approved_producers"] or item["producerId"] in criterion["approved_producers"])
                    and self._producer(item["producerId"]) is not None
                    and item["observationGrade"] in _OBSERVATION_GRADES
                    and _AUTHORITY_RANK[item["authorityClass"]] <= _AUTHORITY_RANK[self._producer(item["producerId"])["authority_ceiling"]]
                    and _AUTHORITY_RANK[item["authorityClass"]] >= _AUTHORITY_RANK[criterion["required_authority"]]
                    and item["binding"]["status"] == "complete"
                    and set(criterion["binding_requirements"]) <= set(item["binding"]["satisfied"])
                    and self._coverage_satisfies(criterion, item)
                    and observed <= now and (now - observed).total_seconds() <= criterion["freshness_seconds"]
                    and (expires is None or expires >= now)
                )
                if valid:
                    refs.append(item["evidenceId"])
            if requirement["required"] and not refs:
                blocked = True
            obligations.append({"id": requirement["id"], "state": "satisfied" if refs else "unsatisfied", "evidenceRefs": refs})
        return {
            "schema_version": 2, "evaluationId": f"completion-{uuid.uuid4().hex}", "jobId": job_id,
            "lineageId": job["lineageId"], "generation": job["generation"], "subject": job["subject"],
            "candidate": job["candidate"], "decisionIdentity": {"generation": job["generation"],
            "profileRevision": self.profile["steward"]["contract_revision"], "proofRecipeRevision": self.proof_recipe["revision"],
            "subjectRevision": job["subject"].get("revision") or "none", "candidateDigest": job["candidate"]["digest"]},
            "disposition": "blocked" if blocked else "eligible", "obligations": obligations,
            "ambiguousOperationRefs": unresolved, "ambiguousCancellationRefs": cancel_refs, "evaluatedAt": _iso(now),
        }

    def finalize_with_gate(self, job_id: str) -> None:
        completion = self.completion_gate(job_id)
        if completion["disposition"] != "eligible":
            self.store.block(job_id, "completion-obligations-unresolved")
            return
        job = self.store.job(job_id)
        effect = self._effect("terminal-publication")
        capability = self._local_handoff_capability()
        budget_ms = max(0, int((_parse(job["deadlineAt"]) - self.store.clock.now()).total_seconds() * 1000))
        admission = _evaluate_mutation(
            effect, job, capability,
            self._authority("terminal-publication", job, source="completion-gate", target=_target_identity(job)),
            current_job_id=job_id, current_generation=int(job["generation"]), current_attempt_id=str(job["attemptId"]),
            current_version=int(job["version"]), current_subject=self.store.current_lineage(job["lineageId"])["subject"],
            remaining_budget_ms=budget_ms, expected_request_digest=None, receipt=None,
            candidate=job["candidate"], now=self.store.clock.now(),
        )
        if admission["disposition"] != "Admitted":
            current = self.store.job(job_id)
            if current["cancellation"] in {"requested", "reconciling"} or current["status"] == "cancelling":
                return
            self.store.block(job_id, f"mutation-admission:{admission['disposition']}")
            return
        decision_ref = f"admission-{uuid.uuid4().hex}"
        handoff = {
            "schema_version": 2, "handoffId": f"handoff-{uuid.uuid4().hex}", "jobId": job_id,
            "lineageId": job["lineageId"], "generation": job["generation"], "subject": job["subject"],
            "candidate": job["candidate"], "status": "completed", "actionable": True,
            "outcome": "seed-provider-completed", "evidenceRefs": [ref for item in completion["obligations"] for ref in item["evidenceRefs"]],
            "artifactRefs": [], "externalOperationRefs": job["externalOperationRefs"], "gaps": [],
            "correlationId": job_id, "sealedAt": _iso(self.store.clock.now()),
        }
        handoff["digest"] = compute_handoff_digest(handoff)
        if self.faults.trip("before-terminal-publication"):
            return
        self.store.save_terminal(
            job_id, completion, handoff, expected_attempt_id=str(job["attemptId"]),
            expected_version=int(job["version"]), mutation_decision_ref=decision_ref,
        )

    def _handle_cancellation(self, job: dict[str, Any]) -> bool:
        submit = self.store.operation_for_job(job["jobId"], "submit")
        if submit is None or submit["delivery"] == "not-delivered":
            self.store.finish_cancel_without_remote(job["jobId"])
            return True
        if submit["delivery"] == "delivery-unknown":
            handle = self.provider.reconcile(submit["operation_id"], job["subject"])
            self.store.reconcile_operation(submit["operation_id"], handle)
            return True
        if submit["state"] == "captured":
            self.store.finish_cancel_without_remote(job["jobId"])
            return True
        cancel_op = self.store.operation_for_job(job["jobId"], "cancel")
        if cancel_op is None:
            self.store.reserve_external(job["jobId"], self.upstream, "cancel")
            return True
        if cancel_op["delivery"] == "not-delivered":
            current = self.store.job(job["jobId"])
            admission = self.store.begin_dispatch(
                cancel_op["operation_id"], self._effect("cancellation-dispatch"), self.upstream,
                self._authority("cancellation-dispatch", current, source="steward-runtime", target=cancel_op["target_identity"]),
            )
            if admission["disposition"] != "Admitted":
                return True
            if self.faults.trip("after-cancel-start"):
                return True
            handle = self.provider.cancel(cancel_op["operation_id"], str(submit["remote_handle"]), job["subject"])
            if self.faults.trip("after-cancel-dispatch") or self.faults.trip("before-cancel-bind"):
                return True
            self.store.bind_dispatch(cancel_op["operation_id"], handle, observed=True)
            return True
        if cancel_op["delivery"] == "delivery-unknown":
            handle = self.provider.reconcile_cancel(cancel_op["operation_id"], str(submit["remote_handle"]), job["subject"])
            self.store.reconcile_operation(cancel_op["operation_id"], handle, cancellation_confirmed=True)
            return True
        if cancel_op["state"] == "captured":
            return False
        raise RuntimeError("unsupported cancellation state")

    def _handle_stale_operation(self, operation: dict[str, Any]) -> bool:
        job = self.store.job(str(operation["job_id"]))
        if operation["delivery"] == "delivery-unknown":
            if operation["operation_kind"] == "cancel":
                submit = self.store.operation_for_job(job["jobId"], "submit")
                if submit is None or not submit.get("remote_handle"):
                    raise RuntimeError("stale cancellation reconciliation requires original submit remote handle")
                handle = self.provider.reconcile_cancel(
                    operation["operation_id"], str(submit["remote_handle"]), job["subject"]
                )
                self.store.reconcile_operation(operation["operation_id"], handle, cancellation_confirmed=True)
            else:
                handle = self.provider.reconcile(operation["operation_id"], job["subject"])
                self.store.reconcile_operation(operation["operation_id"], handle)
            return True
        if operation["operation_kind"] == "submit" and operation["state"] != "captured":
            payload = self.provider.poll(str(operation["remote_handle"]), job["subject"])
            if payload.get("state") != "completed":
                return False
            self.store.capture_result(operation["operation_id"], payload) if job["status"] not in _TERMINAL else self._capture_stale(operation, payload)
            return True
        return False

    def _capture_stale(self, operation: dict[str, Any], payload: dict[str, Any]) -> None:
        with self.store._write() as db:
            db.execute("UPDATE external_operations SET state='captured',result_json=?,observed_at=? WHERE operation_id=?",
                       (_canonical(payload), _iso(self.store.clock.now()), operation["operation_id"]))
            self.store._audit(db, str(operation["job_id"]), "late-result-discarded", {"operationId": operation["operation_id"]})

    def run_once(self) -> bool:
        self._tick += 1
        job = self.store.next_job()
        stale = self.store.next_stale_operation()
        if stale is not None and (self._tick % 2 == 0 or job is None or job["status"] == "waiting-external"):
            return self._handle_stale_operation(stale)
        if job is None:
            return False
        self.store.heartbeat(job["jobId"])
        if job["cancellation"] in {"requested", "reconciling"} or job["status"] == "cancelling":
            return self._handle_cancellation(job)
        submit = self.store.operation_for_job(job["jobId"], "submit")
        if submit is None:
            self.store.reserve_external(job["jobId"], self.upstream, "submit")
            self.faults.trip("after-reservation")
            return True
        if submit["delivery"] == "not-delivered":
            current = self.store.job(job["jobId"])
            admission = self.store.begin_dispatch(
                submit["operation_id"], self._effect("external-dispatch"), self.upstream,
                self._authority("external-dispatch", current, source="steward-runtime", target=submit["target_identity"]),
            )
            if admission["disposition"] != "Admitted":
                return True
            if self.faults.trip("after-dispatch-start"):
                return True
            handle = self.provider.dispatch(submit["operation_id"], job["subject"])
            if self.faults.trip("after-dispatch") or self.faults.trip("before-handle-persist"):
                return True
            self.store.bind_dispatch(submit["operation_id"], handle)
            return True
        if submit["delivery"] == "delivery-unknown":
            self.store.reconcile_operation(submit["operation_id"], self.provider.reconcile(submit["operation_id"], job["subject"]))
            return True
        payload = self.store.result_payload(submit["operation_id"])
        if payload is None:
            observed = self.provider.poll(str(submit["remote_handle"]), job["subject"])
            if observed.get("state") != "completed":
                return False
            if self.faults.trip("before-result-persist"):
                return True
            self.store.capture_result(submit["operation_id"], observed)
            payload = observed
        if not self.store.evidence(job["jobId"]):
            promoted = False
            for requirement in self.profile["completion"]["obligations"]:
                criterion = self._criterion(requirement["id"])
                producer = self._producer(self.provider.producer_id)
                if producer is None:
                    continue
                if self.store.persist_evidence(
                    job["jobId"], requirement, criterion, self.provider.producer_id, payload, self.recipe_id, submit, producer
                ):
                    promoted = True
            if not promoted:
                self.store.block(job["jobId"], "terminal-observation-insufficient-authority")
            return True
        if self.store.job(job["jobId"])["status"] == "finalizing":
            self.finalize_with_gate(job["jobId"])
            return True
        return False

    def recover_until_idle(self, max_steps: int = 100) -> None:
        for _ in range(max_steps):
            progressed = self.run_once()
            if not progressed:
                return
            if self.store.next_job() is None and self.store.next_stale_operation() is None:
                return
        raise RuntimeError("recovery supervisor exceeded bounded step budget")

    def start_background(self, interval_seconds: float = 0.05) -> None:
        if self._thread is not None and self._thread.is_alive():
            return
        self._stop.clear()
        def worker() -> None:
            failure_count = 0
            while not self._stop.is_set():
                try:
                    self.run_once()
                    failure_count = 0
                except Exception as exception:
                    failure_count = min(failure_count + 1, 7)
                    try:
                        self.store.record_recovery_failure(exception)
                    except Exception:
                        _LOGGER.exception("Steward recovery failure could not be persisted")
                delay = min(interval_seconds * (2 ** failure_count), 5.0)
                self._stop.wait(delay)
        self._thread = threading.Thread(target=worker, name="steward-recovery", daemon=True)
        self._thread.start()

    def stop_background(self) -> None:
        self._stop.set()
        if self._thread is not None:
            self._thread.join(timeout=2)
            self._thread = None


_DEFAULT_RUNTIME: StewardRuntime | None = None
_DEFAULT_LOCK = threading.Lock()


def default_runtime() -> StewardRuntime:
    global _DEFAULT_RUNTIME
    with _DEFAULT_LOCK:
        if _DEFAULT_RUNTIME is None:
            package = files(__package__)
            profile = json.loads(package.joinpath("steward_profile.json").read_text(encoding="utf-8"))
            proof = json.loads(package.joinpath("steward_proof_recipe.json").read_text(encoding="utf-8"))
            mutation = json.loads(package.joinpath("steward_mutation_policy.json").read_text(encoding="utf-8"))
            upstream = json.loads(package.joinpath("steward_upstream_capability.json").read_text(encoding="utf-8"))
            _DEFAULT_RUNTIME = StewardRuntime(
                StewardStore(Path(os.environ.get("STEWARD_STATE_PATH", "steward-state.db"))), profile, proof, mutation, upstream=upstream
            )
        return _DEFAULT_RUNTIME
