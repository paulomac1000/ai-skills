name: Python MCP contract

on:
  pull_request:
  push:
    branches: [<DEFAULT_BRANCH>]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: python-mcp-${{ github.ref }}
  cancel-in-progress: true

jobs:
  mcp-contract:
    runs-on: ubuntu-latest
    timeout-minutes: <TIMEOUT_MINUTES>
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97
        with:
          python-version: "<PYTHON_VERSION>"
          cache: pip
          cache-dependency-path: <DEPENDENCY_FILE>
      - run: <INSTALL_COMMAND>
      - name: Registration and schema contract
        run: <MCP_REGISTRATION_TEST_COMMAND>
      - name: Representative real-client workflow
        run: <MCP_CLIENT_TEST_COMMAND>
      - name: Cancellation and error contract
        run: <MCP_FAILURE_TEST_COMMAND>
