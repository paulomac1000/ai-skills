# Render this template with the solution path and supported SDK version.
name: .NET CI

on:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

concurrency:
  group: dotnet-ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build-test:
    runs-on: ubuntu-latest
    timeout-minutes: <TIMEOUT_MINUTES>
    steps:
      - uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4.3.1
        with:
          persist-credentials: false
      - uses: actions/setup-dotnet@9a946fdbd5fb07b82b2f5a4466058b876ab72bb2 # v5
        with:
          dotnet-version: "<DOTNET_VERSION>"
      - name: Restore
        run: dotnet restore <SOLUTION_PATH>
      - name: Verify formatting
        run: dotnet format <SOLUTION_PATH> --no-restore --verify-no-changes
      - name: Build
        run: dotnet build <SOLUTION_PATH> --no-restore --configuration Release
      - name: Test
        run: dotnet test <SOLUTION_PATH> --no-build --configuration Release --logger trx
