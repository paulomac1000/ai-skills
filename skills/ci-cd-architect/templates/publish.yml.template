# ai-skills-policy-profile: protected-release
# Build and test in an unprivileged candidate job, quarantine by exact registry digest,
# prove release-deliverable closure on that exact digest, then promote it in a protected
# job that never executes candidate source.
name: Publish container

on:
  push:
    tags: ["v*"]
  workflow_dispatch:
    inputs:
      release_ref:
        description: Existing v* tag or full 40-character commit SHA reachable from the default branch
        required: true
        type: string

permissions:
  contents: read

concurrency:
  group: publish-${{ github.event_name == 'workflow_dispatch' && inputs.release_ref || github.ref }}
  cancel-in-progress: false

jobs:
  validate-build:
    runs-on: ubuntu-24.04
    timeout-minutes: <TIMEOUT_MINUTES>
    outputs:
      release_sha: ${{ steps.revision.outputs.sha }}
      release_tag: ${{ steps.revision.outputs.tag }}
      quarantine_ref: ${{ steps.quarantine.outputs.ref }}
      quarantine_digest: ${{ steps.quarantine.outputs.digest }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          fetch-depth: 0
          persist-credentials: false
      - name: Resolve and constrain release identity
        id: revision
        shell: bash
        env:
          DEFAULT_BRANCH: ${{ github.event.repository.default_branch }}
          EVENT_NAME: ${{ github.event_name }}
          EVENT_REF_NAME: ${{ github.ref_name }}
          REQUESTED_REF: ${{ github.event_name == 'workflow_dispatch' && inputs.release_ref || github.ref }}
        run: |
          set -euo pipefail
          requested="$REQUESTED_REF"
          release_tag=""
          if [[ "$EVENT_NAME" == "push" ]]; then
            release_tag="$EVENT_REF_NAME"
            requested="refs/tags/$release_tag"
          fi
          if [[ "$requested" =~ ^[0-9a-f]{40}$ ]]; then
            release_sha="$requested"
          else
            case "$requested" in
              refs/tags/v*) release_tag="${requested#refs/tags/}" ;;
              v*) release_tag="$requested" ;;
              *) echo "release_ref must be an existing v* tag or full commit SHA" >&2; exit 1 ;;
            esac
            git show-ref --verify --quiet "refs/tags/$release_tag" || {
              echo "Tag not found: $release_tag" >&2
              exit 1
            }
            release_sha="$(git rev-parse "refs/tags/$release_tag^{commit}")"
          fi
          [[ "$release_sha" =~ ^[0-9a-f]{40}$ ]]
          git cat-file -e "$release_sha^{commit}"
          git merge-base --is-ancestor "$release_sha" "origin/$DEFAULT_BRANCH" || {
            echo "Selected revision is not reachable from origin/$DEFAULT_BRANCH" >&2
            exit 1
          }
          git checkout --detach "$release_sha"
          test "$(git rev-parse HEAD)" = "$release_sha"
          if [[ -n "$release_tag" ]]; then
            test "$(git rev-parse "refs/tags/$release_tag^{commit}")" = "$release_sha"
          fi
          echo "sha=$release_sha" >> "$GITHUB_OUTPUT"
          echo "tag=$release_tag" >> "$GITHUB_OUTPUT"
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97
        with:
          python-version: "<PYTHON_VERSION>"
          cache: pip
          cache-dependency-path: <DEPENDENCY_FILE>
      - run: <INSTALL_COMMAND>
      - run: <TEST_COMMAND>
      - name: Verify revision remained unchanged
        shell: bash
        env:
          EXPECTED_SHA: ${{ steps.revision.outputs.sha }}
        run: test "$(git rev-parse HEAD)" = "$EXPECTED_SHA"
      - uses: docker/setup-buildx-action@d7f5e7f509e45cec5c76c4d5afdd7de93d0b3df5
      - name: Build release image once
        id: build
        shell: bash
        env:
          RELEASE_SHA: ${{ steps.revision.outputs.sha }}
        run: |
          set -euo pipefail
          local_ref="ai-skills-release:sha-$RELEASE_SHA"
          docker buildx build --load --label "org.opencontainers.image.revision=$RELEASE_SHA" --tag "$local_ref" .
          echo "ref=$local_ref" >> "$GITHUB_OUTPUT"
      - name: Smoke-test local release image
        env:
          IMAGE_REF: ${{ steps.build.outputs.ref }}
        run: <CONTAINER_SMOKE_COMMAND>
      - uses: docker/login-action@650006c6eb7dba73a995cc03b0b2d7f5ca915bee
        with:
          registry: <QUARANTINE_REGISTRY>
          username: ${{ secrets.<QUARANTINE_USERNAME_SECRET> }}
          password: ${{ secrets.<QUARANTINE_PASSWORD_SECRET> }}
      - name: Push only to isolated quarantine registry
        id: quarantine
        shell: bash
        env:
          LOCAL_REF: ${{ steps.build.outputs.ref }}
          RELEASE_SHA: ${{ steps.revision.outputs.sha }}
        run: |
          set -euo pipefail
          quarantine_ref="<QUARANTINE_REGISTRY>/<QUARANTINE_REPOSITORY>:sha-$RELEASE_SHA"
          docker tag "$LOCAL_REF" "$quarantine_ref"
          docker push "$quarantine_ref"
          digest="$(docker buildx imagetools inspect "$quarantine_ref" --format '{{.Manifest.Digest}}')"
          [[ "$digest" =~ ^sha256:[0-9a-f]{64}$ ]]
          echo "ref=$quarantine_ref" >> "$GITHUB_OUTPUT"
          echo "digest=$digest" >> "$GITHUB_OUTPUT"
      - name: Smoke-test exact quarantined digest
        shell: bash
        env:
          QUARANTINE_REF: ${{ steps.quarantine.outputs.ref }}
          QUARANTINE_DIGEST: ${{ steps.quarantine.outputs.digest }}
        run: |
          set -euo pipefail
          IMAGE_REF="${QUARANTINE_REF%:*}@$QUARANTINE_DIGEST"
          export IMAGE_REF
          <CONTAINER_SMOKE_COMMAND>
      - name: Verify exact artifact deliverable closure
        shell: bash
        env:
          SOURCE_REVISION: ${{ steps.revision.outputs.sha }}
          QUARANTINE_REF: ${{ steps.quarantine.outputs.ref }}
          ARTIFACT_DIGEST: ${{ steps.quarantine.outputs.digest }}
          DELIVERABLE_MANIFEST_PATH: <DELIVERABLE_MANIFEST_PATH>
          ARTIFACT_CLOSURE_RECEIPT_PATH: <ARTIFACT_CLOSURE_RECEIPT_PATH>
        run: |
          set -euo pipefail
          ARTIFACT_REF="${QUARANTINE_REF%:*}@$ARTIFACT_DIGEST"
          export ARTIFACT_REF
          MANIFEST_FILE_SHA256="$(python -c 'import hashlib, pathlib, sys; print(hashlib.sha256(pathlib.Path(sys.argv[1]).read_bytes()).hexdigest())' "$DELIVERABLE_MANIFEST_PATH")"
          export MANIFEST_FILE_SHA256
          (
            <ARTIFACT_CLOSURE_COMMAND>
          )
          python - <<'PY'
          import hashlib
          import json
          import os
          import stat
          from pathlib import Path

          MAX_DOCUMENT_BYTES = 1024 * 1024

          def fail(message: str) -> None:
              raise SystemExit(message)

          def require(condition: bool, message: str) -> None:
              if not condition:
                  fail(message)

          def load_document(path_text: str, label: str) -> tuple[dict[str, object], bytes]:
              path = Path(path_text)
              try:
                  metadata = path.lstat()
              except OSError as error:
                  fail(f"{label} is unreadable: {error}")
              require(stat.S_ISREG(metadata.st_mode), f"{label} must be a regular non-symlink file")
              require(0 < metadata.st_size <= MAX_DOCUMENT_BYTES, f"{label} exceeds bounded size")
              try:
                  payload = path.read_bytes()
                  value = json.loads(payload.decode("utf-8"))
              except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
                  fail(f"{label} is invalid JSON: {error}")
              require(isinstance(value, dict), f"{label} must be a JSON object")
              return value, payload

          manifest, manifest_bytes = load_document(
              os.environ["DELIVERABLE_MANIFEST_PATH"],
              "deliverable manifest",
          )
          receipt, _ = load_document(
              os.environ["ARTIFACT_CLOSURE_RECEIPT_PATH"],
              "artifact closure receipt",
          )
          require(
              hashlib.sha256(manifest_bytes).hexdigest() == os.environ["MANIFEST_FILE_SHA256"],
              "deliverable manifest changed during artifact closure",
          )

          require(type(manifest.get("schema_version")) is int and manifest["schema_version"] == 1, "manifest schema")
          deliverables = manifest.get("deliverables")
          dispositions = manifest.get("unexpected_component_dispositions")
          require(isinstance(deliverables, dict) and deliverables, "manifest deliverables")
          require(isinstance(dispositions, dict), "manifest unexpected-component dispositions")

          try:
              manifest_payload = json.dumps(
                  manifest,
                  sort_keys=True,
                  separators=(",", ":"),
                  ensure_ascii=False,
              ).encode("utf-8")
          except UnicodeEncodeError as error:
              fail(f"deliverable manifest is not Unicode-scalar text: {error}")
          manifest_digest = "sha256:" + hashlib.sha256(manifest_payload).hexdigest()

          expected_source = os.environ["SOURCE_REVISION"]
          expected_ref = os.environ["ARTIFACT_REF"]
          expected_digest = os.environ["ARTIFACT_DIGEST"]
          require(type(receipt.get("schema_version")) is int and receipt["schema_version"] == 1, "receipt schema")
          require(receipt.get("receipt_kind") == "artifact_closure", "receipt kind")
          require(receipt.get("source_revision") == expected_source, "closure source revision mismatch")
          require(receipt.get("artifact_ref") == expected_ref, "closure artifact ref mismatch")
          require(receipt.get("artifact_digest") == expected_digest, "closure artifact digest mismatch")

          receipt_manifest = receipt.get("manifest")
          require(isinstance(receipt_manifest, dict), "receipt manifest identity")
          for field in ("manifest_id", "revision", "policy_ref"):
              require(receipt_manifest.get(field) == manifest.get(field), f"closure manifest {field} mismatch")
          require(receipt_manifest.get("digest") == manifest_digest, "closure manifest digest mismatch")

          observed = receipt.get("observed")
          require(isinstance(observed, dict), "closure observations")
          require(set(observed) == set(deliverables), "closure observations must cover the manifest exactly")
          for deliverable_id, requirement in deliverables.items():
              require(isinstance(requirement, dict), f"manifest deliverable {deliverable_id}")
              observation = observed[deliverable_id]
              require(isinstance(observation, dict), f"closure observation {deliverable_id}")
              required = requirement.get("required")
              smoke_required = requirement.get("smoke_required")
              require(type(required) is bool and type(smoke_required) is bool, f"manifest flags {deliverable_id}")
              presence = observation.get("presence")
              require(presence in {"PRESENT", "MISSING", "UNKNOWN"}, f"closure presence {deliverable_id}")
              if presence != "PRESENT":
                  require(not required, f"required deliverable is not present: {deliverable_id}")
                  continue
              expected_identity = requirement.get("expected_identity_ref")
              if expected_identity is not None:
                  require(
                      observation.get("identity_ref") == expected_identity,
                      f"deliverable identity mismatch: {deliverable_id}",
                  )
              if smoke_required:
                  require(observation.get("smoke_status") == "PASS", f"deliverable smoke failed: {deliverable_id}")
                  require(
                      observation.get("smoke_profile_ref") == requirement.get("smoke_profile_ref"),
                      f"deliverable smoke profile mismatch: {deliverable_id}",
                  )
                  require(
                      observation.get("smoke_profile_digest") == requirement.get("smoke_profile_digest"),
                      f"deliverable smoke profile digest mismatch: {deliverable_id}",
                  )

          unexpected = receipt.get("unexpected_components")
          require(isinstance(unexpected, dict), "unexpected component observations")
          for component_ref in unexpected:
              require(
                  dispositions.get(component_ref) == "allowed",
                  f"unexpected component lacks allowed policy disposition: {component_ref}",
              )

          require(receipt.get("missing_required") == [], "closure reports missing required deliverables")
          require(receipt.get("unknown_required") == [], "closure reports unknown required deliverables")
          require(receipt.get("identity_mismatches") == {}, "closure reports identity mismatches")
          require(receipt.get("smoke_failures") == {}, "closure reports smoke failures")
          require(receipt.get("blocking_unexpected") == [], "closure reports blocking unexpected components")
          require(receipt.get("verdict") == "COMPLETE", "artifact closure is not COMPLETE")
          PY

  publish:
    needs: validate-build
    environment: <RELEASE_ENVIRONMENT>
    runs-on: ubuntu-24.04
    timeout-minutes: <TIMEOUT_MINUTES>
    permissions:
      contents: read
      packages: write
      id-token: write
      attestations: write
    steps:
      - uses: docker/setup-buildx-action@d7f5e7f509e45cec5c76c4d5afdd7de93d0b3df5
      - uses: docker/login-action@650006c6eb7dba73a995cc03b0b2d7f5ca915bee
        with:
          registry: <QUARANTINE_REGISTRY>
          username: ${{ secrets.<QUARANTINE_READ_USERNAME_SECRET> }}
          password: ${{ secrets.<QUARANTINE_READ_PASSWORD_SECRET> }}
      - uses: docker/login-action@650006c6eb7dba73a995cc03b0b2d7f5ca915bee
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      - name: Promote exact tested digest without loading candidate image
        id: promote
        shell: bash
        env:
          QUARANTINE_REF: ${{ needs.validate-build.outputs.quarantine_ref }}
          EXPECTED_DIGEST: ${{ needs.validate-build.outputs.quarantine_digest }}
          RELEASE_SHA: ${{ needs.validate-build.outputs.release_sha }}
          RELEASE_TAG: ${{ needs.validate-build.outputs.release_tag }}
        run: |
          set -euo pipefail
          [[ "$EXPECTED_DIGEST" =~ ^sha256:[0-9a-f]{64}$ ]]
          repository="ghcr.io/${GITHUB_REPOSITORY,,}"
          immutable_ref="$repository:sha-$RELEASE_SHA"
          source_ref="${QUARANTINE_REF%:*}@$EXPECTED_DIGEST"
          docker buildx imagetools create --tag "$immutable_ref" "$source_ref"
          promoted="$(docker buildx imagetools inspect "$immutable_ref" --format '{{.Manifest.Digest}}')"
          test "$promoted" = "$EXPECTED_DIGEST"
          if [[ -n "$RELEASE_TAG" ]]; then
            docker buildx imagetools create --tag "$repository:$RELEASE_TAG" "$source_ref"
            tagged="$(docker buildx imagetools inspect "$repository:$RELEASE_TAG" --format '{{.Manifest.Digest}}')"
            test "$tagged" = "$EXPECTED_DIGEST"
          fi
          echo "digest=$EXPECTED_DIGEST" >> "$GITHUB_OUTPUT"
          echo "subject_name=$repository" >> "$GITHUB_OUTPUT"
      - uses: actions/attest-build-provenance@96b4a1ef7235a096b17240c259729fdd70c83d45
        with:
          subject-name: ${{ steps.promote.outputs.subject_name }}
          subject-digest: ${{ steps.promote.outputs.digest }}
          push-to-registry: true
