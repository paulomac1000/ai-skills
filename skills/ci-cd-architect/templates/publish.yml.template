# Validate the selected revision, build once, smoke-test locally, and push the same image.
name: Publish container

on:
  push:
    tags: ["v*"]
  workflow_dispatch:
    inputs:
      release_ref:
        description: Commit SHA or tag to validate and publish
        required: true
        type: string

permissions:
  contents: read

concurrency:
  group: publish-${{ github.event_name == 'workflow_dispatch' && inputs.release_ref || github.ref }}
  cancel-in-progress: false

jobs:
  validate:
    runs-on: ubuntu-latest
    timeout-minutes: <TIMEOUT_MINUTES>
    outputs:
      release_sha: ${{ steps.revision.outputs.sha }}
      release_short_sha: ${{ steps.revision.outputs.short_sha }}
      release_tag: ${{ steps.revision.outputs.tag }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: ${{ github.event_name == 'workflow_dispatch' && inputs.release_ref || github.sha }}
          fetch-depth: 0
          persist-credentials: false
      - id: revision
        shell: bash
        env:
          EVENT_NAME: ${{ github.event_name }}
          EVENT_REF_NAME: ${{ github.ref_name }}
          REQUESTED_REF: ${{ github.event_name == 'workflow_dispatch' && inputs.release_ref || github.ref }}
        run: |
          set -euo pipefail
          release_sha="$(git rev-parse HEAD)"
          release_short_sha="$(git rev-parse --short=12 HEAD)"
          release_tag=""
          if [[ "$EVENT_NAME" == "push" ]]; then
            release_tag="$EVENT_REF_NAME"
          elif [[ "$REQUESTED_REF" == refs/tags/* ]]; then
            release_tag="${REQUESTED_REF#refs/tags/}"
          elif git show-ref --verify --quiet "refs/tags/$REQUESTED_REF"; then
            release_tag="$REQUESTED_REF"
          fi
          if [[ -n "$release_tag" ]]; then
            test "$(git rev-parse "refs/tags/$release_tag^{commit}")" = "$release_sha"
          fi
          echo "sha=$release_sha" >> "$GITHUB_OUTPUT"
          echo "short_sha=$release_short_sha" >> "$GITHUB_OUTPUT"
          echo "tag=$release_tag" >> "$GITHUB_OUTPUT"
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97
        with:
          python-version: "<PYTHON_VERSION>"
          cache: pip
          cache-dependency-path: <DEPENDENCY_FILE>
      - run: <INSTALL_COMMAND>
      - run: <TEST_COMMAND>
      - name: Verify revision was not changed
        shell: bash
        env:
          EXPECTED_SHA: ${{ steps.revision.outputs.sha }}
        run: test "$(git rev-parse HEAD)" = "$EXPECTED_SHA"

  publish:
    needs: validate
    environment: <RELEASE_ENVIRONMENT>
    runs-on: ubuntu-latest
    timeout-minutes: <TIMEOUT_MINUTES>
    permissions:
      contents: read
      packages: write
      id-token: write
      attestations: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: ${{ needs.validate.outputs.release_sha }}
          persist-credentials: false
      - uses: docker/setup-buildx-action@d7f5e7f509e45cec5c76c4d5afdd7de93d0b3df5
      - uses: docker/login-action@650006c6eb7dba73a995cc03b0b2d7f5ca915bee
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      - id: meta
        uses: docker/metadata-action@80c7e94dd9b9319bd5eb7a0e0fe9291e23a2a2e9
        with:
          images: ghcr.io/${{ github.repository }}
          tags: |
            type=raw,value=${{ needs.validate.outputs.release_tag }},enable=${{ needs.validate.outputs.release_tag != '' }}
            type=raw,value=sha-${{ needs.validate.outputs.release_short_sha }}
      - name: Build release image once
        id: build
        uses: docker/build-push-action@f9f3042f7e2789586610d6e8b85c8f03e5195baf
        with:
          context: .
          load: true
          push: false
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
      - name: Smoke-test exact release image
        env:
          IMAGE_REF: ghcr.io/${{ github.repository }}:sha-${{ needs.validate.outputs.release_short_sha }}
        run: <CONTAINER_SMOKE_COMMAND>
      - name: Push smoke-tested image tags
        id: push
        shell: bash
        env:
          IMAGE_REPOSITORY: ghcr.io/${{ github.repository }}
          IMMUTABLE_TAG: sha-${{ needs.validate.outputs.release_short_sha }}
        run: |
          set -euo pipefail
          docker push --all-tags "$IMAGE_REPOSITORY"
          digest="$(docker inspect --format='{{index .RepoDigests 0}}' "$IMAGE_REPOSITORY:$IMMUTABLE_TAG" | cut -d@ -f2)"
          test -n "$digest"
          echo "digest=$digest" >> "$GITHUB_OUTPUT"
      - uses: actions/attest-build-provenance@96b4a1ef7235a096b17240c259729fdd70c83d45
        with:
          subject-name: ghcr.io/${{ github.repository }}
          subject-digest: ${{ steps.push.outputs.digest }}
          push-to-registry: true
