name: .NET CI
on:
  pull_request:
  push:
    branches: [{{ default_branch }}]
permissions:
  contents: read
jobs:
  test:
    runs-on: {{ runner }}
    timeout-minutes: {{ timeout_minutes }}
    steps:
      - uses: {{ checkout_ref }}
      - uses: {{ setup_dotnet_ref }}
        with:
          dotnet-version: {{ dotnet_version }}
          cache: true
      - run: dotnet restore {{ solution }} --locked-mode
      - run: dotnet test {{ solution }} --no-restore --configuration Release
