repos:
  - repo: local
    hooks:
      - id: dotnet-format
        name: .NET format verification
        entry: dotnet format <SOLUTION_PATH> --verify-no-changes --no-restore
        language: system
        pass_filenames: false
      - id: dotnet-tests
        name: .NET bounded test gate
        entry: dotnet test <SOLUTION_PATH> --configuration Release --no-restore
        language: system
        pass_filenames: false
        stages: [pre-push]
