name: Documentation validation
on:
  pull_request:
    paths: ['**/*.md', 'skills/afds-doc-writer/**']
permissions:
  contents: read
jobs:
  validate:
    runs-on: {{ runner }}
    steps:
      - uses: {{ checkout_ref }}
      - uses: {{ setup_python_ref }}
        with:
          python-version: {{ python_version }}
      - run: python -m pip install pyyaml
      - run: {{ validation_command }}
