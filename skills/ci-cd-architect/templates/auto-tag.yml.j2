# Optional compatibility template. Prefer a repository's package/release tool as version authority.
name: Tag release
on:
  workflow_dispatch:
    inputs:
      version:
        required: true
permissions:
  contents: write
jobs:
  tag:
    runs-on: {{ runner }}
    steps:
      - uses: {{ checkout_ref }}
      - run: {{ validate_version_command }}
      - run: git tag "v${{ inputs.version }}" "$GITHUB_SHA" && git push origin "v${{ inputs.version }}"
