name: Static security analysis
on:
  pull_request:
  push:
    branches: [{{ default_branch }}]
permissions:
  contents: read
  security-events: write
jobs:
  scan:
    runs-on: {{ runner }}
    steps:
      - uses: {{ checkout_ref }}
      - uses: {{ semgrep_ref }}
        with:
          config: {{ semgrep_config }}
