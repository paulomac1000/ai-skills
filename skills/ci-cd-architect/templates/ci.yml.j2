# Compatibility template: render project-specific values from repository facts.
name: CI
on:
  pull_request:
  push:
    branches: [{{ default_branch }}]
permissions:
  contents: read
concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true
jobs:
  validate:
    runs-on: {{ runner }}
    timeout-minutes: {{ timeout_minutes }}
    steps:
      - uses: {{ checkout_ref }}
      {{ language_setup_steps | indent(6) }}
      - name: Validate
        run: {{ validation_command }}
