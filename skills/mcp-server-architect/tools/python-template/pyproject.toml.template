[build-system]
requires = ["setuptools==83.0.0", "wheel==0.47.0"]
build-backend = "setuptools.build_meta"

[project]
name = "__DISTRIBUTION__"
version = "0.1.0"
description = "MCP server generated from the ai-skills canonical Python template"
readme = "README.md"
requires-python = ">=3.12,<3.15"
dependencies = [
  "httpx2==2.9.1",
  "jsonschema==4.26.0",
  "mcp==2.0.0",
  "starlette==1.3.1",
  "uvicorn==0.51.0",
]

[project.scripts]
__DISTRIBUTION__ = "__PACKAGE__.server:main"

[tool.setuptools.packages.find]
where = ["src"]

[tool.setuptools.package-data]
__PACKAGE__ = ["capabilities/*.json", "contracts/*.json"]

[tool.pytest.ini_options]
addopts = "-q --strict-markers"
testpaths = ["tests"]
python_files = ["test_*.py"]
markers = ["container: requires a local Docker daemon"]

[tool.ruff]
target-version = "py312"
line-length = 120

[tool.ruff.lint]
select = ["E4", "E7", "E9", "F", "I", "B", "UP"]

[tool.mypy]
python_version = "3.12"
check_untyped_defs = true
disallow_any_generics = true
no_implicit_optional = true
warn_redundant_casts = true
warn_unused_ignores = true
warn_unreachable = true
