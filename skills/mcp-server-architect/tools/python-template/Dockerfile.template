FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7

ARG WHEEL
WORKDIR /app
RUN useradd --create-home --uid 10001 appuser \
 && install -d -o appuser -g appuser /var/lib/__DISTRIBUTION__
COPY locks/runtime-linux-x64-py312.lock /tmp/runtime.lock
COPY ${WHEEL} /tmp/application.whl
RUN python -m pip install --no-cache-dir --require-hashes -r /tmp/runtime.lock \
 && python -m pip install --no-cache-dir --no-deps /tmp/application.whl \
 && rm -f /tmp/runtime.lock /tmp/application.whl
USER appuser
ENV MCP_STATE_ROOT=/var/lib/__DISTRIBUTION__
ENTRYPOINT ["__DISTRIBUTION__"]
