FROM python:3.12.11-slim-bookworm@sha256:8d8d1a11f5f2e7879d4b9be3ec040b1f48d99b5284942230ca11843bb65c2d4a

ARG WHEEL
ARG WHEEL_SHA256
WORKDIR /app

RUN useradd --create-home --uid 10001 app
COPY locks/runtime-linux-x64-py312.lock /tmp/runtime.lock
COPY ${WHEEL} /tmp/wheels/
RUN set -eu; \
    wheel="$(find /tmp/wheels -maxdepth 1 -type f -name '*.whl' -print -quit)"; \
    test -n "$wheel"; \
    test "$(find /tmp/wheels -maxdepth 1 -type f -name '*.whl' | wc -l)" -eq 1; \
    test -n "$WHEEL_SHA256"; \
    test "$(sha256sum "$wheel" | cut -d' ' -f1)" = "$WHEEL_SHA256"; \
    python -m pip install --no-cache-dir --require-hashes -r /tmp/runtime.lock; \
    python -m pip install --no-cache-dir --no-deps "$wheel"; \
    python -m pip check; \
    rm -rf /tmp/wheels /tmp/runtime.lock

USER app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENTRYPOINT ["__DISTRIBUTION__"]
