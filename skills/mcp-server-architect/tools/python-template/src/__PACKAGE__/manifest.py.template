"""Load and validate application-owned capability manifests."""

from __future__ import annotations

import json
from collections.abc import Mapping
from importlib.resources import files
from typing import Any

from jsonschema import Draft202012Validator

_MAX_MANIFEST_BYTES = 256 * 1024


def _load_json(resource: Any, label: str) -> Mapping[str, Any]:
    raw = resource.read_bytes()
    if len(raw) > _MAX_MANIFEST_BYTES:
        raise RuntimeError(f"{label}: exceeds {_MAX_MANIFEST_BYTES} bytes")
    try:
        value = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise RuntimeError(f"{label}: invalid UTF-8 JSON") from exc
    if not isinstance(value, Mapping):
        raise RuntimeError(f"{label}: root must be an object")
    return value


def _semantic_findings(manifest: Mapping[str, Any]) -> list[str]:
    findings: list[str] = []
    operation = manifest.get("operation_kind")
    extensions = manifest.get("extensions")
    rationales = extensions if isinstance(extensions, Mapping) else {}
    if operation in {"write", "destructive"}:
        for flag in ("retryable", "idempotent", "reversible"):
            if manifest.get(flag) is True and f"{flag}_rationale" not in rationales:
                findings.append(f"extensions.{flag}_rationale is required")
    if manifest.get("requires_confirmation") is True:
        approval = manifest.get("approval")
        if not isinstance(approval, Mapping):
            findings.append("approval policy is required")
        else:
            binds = approval.get("binds")
            observed = set(binds) if isinstance(binds, list) else set()
            required = {"principal", "capability", "target", "arguments-digest"}
            if missing := sorted(required - observed):
                findings.append(f"approval.binds is missing {missing}")
    return findings


def load_manifests() -> dict[str, Mapping[str, Any]]:
    """Return every validated manifest keyed by immutable capability ID."""
    package = files(__package__)
    schema = _load_json(package.joinpath("contracts/capability-manifest.schema.json"), "schema")
    Draft202012Validator.check_schema(schema)
    validator = Draft202012Validator(schema)

    result: dict[str, Mapping[str, Any]] = {}
    capability_root = package.joinpath("capabilities")
    for resource in sorted(capability_root.iterdir(), key=lambda item: item.name):
        if not resource.name.endswith(".json"):
            continue
        manifest = _load_json(resource, resource.name)
        findings = [
            f"{'.'.join(str(part) for part in error.absolute_path) or '$'}: {error.message}"
            for error in sorted(
                validator.iter_errors(manifest),
                key=lambda item: tuple(str(part) for part in item.absolute_path),
            )
        ]
        findings.extend(_semantic_findings(manifest))
        if findings:
            raise RuntimeError(f"{resource.name}: {'; '.join(findings)}")
        capability_id = manifest.get("id")
        if not isinstance(capability_id, str):
            raise RuntimeError(f"{resource.name}: id must be a string")
        if capability_id in result:
            raise RuntimeError(f"duplicate capability id: {capability_id}")
        result[capability_id] = manifest
    if not result:
        raise RuntimeError("no capability manifests found")
    return result


MANIFESTS = load_manifests()
