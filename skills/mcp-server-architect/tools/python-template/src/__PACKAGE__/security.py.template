"""Fail-closed local and HTTP identity boundaries."""

from __future__ import annotations

import contextvars
import hashlib
import hmac
import os
from collections.abc import Awaitable, Callable
from typing import Any

_MAX_AUTHORIZATION_BYTES = 8192
_MIN_TOKEN_BYTES = 32
_MAX_TOKEN_BYTES = 4096


def _process_principal() -> str:
    if hasattr(os, "getuid"):
        return f"os:uid:{os.getuid()}"
    return f"os:user:{os.environ.get('USERNAME', 'unknown')}"


_current_principal: contextvars.ContextVar[str] = contextvars.ContextVar(
    "mcp_current_principal",
    default=_process_principal(),
)


def current_principal() -> str:
    """Return the explicit request or process-boundary principal."""
    return _current_principal.get()


def require_http_token() -> bytes:
    """Load one bounded development bearer token for loopback HTTP only."""
    raw = os.environ.get("MCP_HTTP_BEARER_TOKEN")
    if raw is None:
        raise RuntimeError("MCP_HTTP_BEARER_TOKEN is required for Streamable HTTP")
    try:
        token = raw.encode("ascii")
    except UnicodeEncodeError as exc:
        raise RuntimeError("MCP_HTTP_BEARER_TOKEN must be ASCII") from exc
    if not _MIN_TOKEN_BYTES <= len(token) <= _MAX_TOKEN_BYTES or any(byte <= 0x20 for byte in token):
        raise RuntimeError("MCP_HTTP_BEARER_TOKEN must be 32-4096 visible ASCII bytes")
    return token


def _extract_bearer(headers: list[tuple[bytes, bytes]]) -> bytes | None:
    authorization_values = [value for name, value in headers if name.lower() == b"authorization"]
    if len(authorization_values) != 1:
        return None
    value = authorization_values[0]
    if len(value) > _MAX_AUTHORIZATION_BYTES:
        return None
    try:
        scheme, token = value.split(b" ", 1)
    except ValueError:
        return None
    if scheme.lower() != b"bearer" or not _MIN_TOKEN_BYTES <= len(token) <= _MAX_TOKEN_BYTES:
        return None
    if any(byte <= 0x20 or byte > 0x7E for byte in token):
        return None
    return token


def _principal_for_token(token: bytes) -> str:
    return f"http:bearer-sha256:{hashlib.sha256(token).hexdigest()}"


class BearerAuthMiddleware:
    """Authenticate MCP requests before transport parsing or application resolution."""

    def __init__(self, app: Callable[..., Awaitable[Any]], expected_token: bytes) -> None:
        self._app = app
        self._expected_token = expected_token

    async def __call__(self, scope: dict[str, Any], receive: Any, send: Any) -> None:
        if scope.get("type") != "http" or scope.get("path") in {"/health/live", "/health/ready"}:
            await self._app(scope, receive, send)
            return
        headers = scope.get("headers")
        token = _extract_bearer(headers if isinstance(headers, list) else [])
        if token is None or not hmac.compare_digest(token, self._expected_token):
            await send(
                {
                    "type": "http.response.start",
                    "status": 401,
                    "headers": [(b"content-type", b"application/json")],
                }
            )
            await send({"type": "http.response.body", "body": b'{"error":"unauthorized"}'})
            return
        principal_token = _current_principal.set(_principal_for_token(token))
        try:
            await self._app(scope, receive, send)
        finally:
            _current_principal.reset(principal_token)
