#!/usr/bin/env python3
"""Fail when a JUnit report proves too few tests or too many skips."""

from __future__ import annotations

import argparse
import xml.etree.ElementTree as ET
from pathlib import Path


def _count(root: ET.Element, field: str) -> int:
    if root.tag == "testsuite":
        return int(root.attrib.get(field, "0"))
    return sum(int(suite.attrib.get(field, "0")) for suite in root.findall(".//testsuite"))


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("report", type=Path)
    parser.add_argument("--minimum-tests", type=int, default=1)
    parser.add_argument("--maximum-skips", type=int, default=0)
    args = parser.parse_args()
    root = ET.parse(args.report).getroot()
    tests = _count(root, "tests")
    skipped = _count(root, "skipped")
    failures = _count(root, "failures") + _count(root, "errors")
    print(f"junit tests={tests} skipped={skipped} failures={failures}")
    if tests < args.minimum_tests or skipped > args.maximum_skips or failures:
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
