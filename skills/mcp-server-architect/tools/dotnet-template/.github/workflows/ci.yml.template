name: CI

on:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  verify:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5
        with:
          persist-credentials: false
      - uses: actions/setup-dotnet@9a946fdbd5fb07b82b2f5a4466058b876ab72bb2
        with:
          dotnet-version: 10.0.302
      - run: dotnet restore tests/__NAMESPACE__.Mcp.Smoke/__NAMESPACE__.Mcp.Smoke.csproj --locked-mode
      - run: dotnet build tests/__NAMESPACE__.Mcp.Smoke/__NAMESPACE__.Mcp.Smoke.csproj --configuration Release --no-restore
      - name: Official-client stdio smoke
        run: >-
          dotnet run --project tests/__NAMESPACE__.Mcp.Smoke/__NAMESPACE__.Mcp.Smoke.csproj
          --configuration Release --no-build --
          src/__NAMESPACE__.Mcp.Server/bin/Release/net10.0/__NAMESPACE__.Mcp.Server.dll
      - name: Official-client Streamable HTTP smoke
        run: >-
          dotnet run --project tests/__NAMESPACE__.Mcp.Smoke/__NAMESPACE__.Mcp.Smoke.csproj
          --configuration Release --no-build --
          src/__NAMESPACE__.Mcp.Server/bin/Release/net10.0/__NAMESPACE__.Mcp.Server.dll --http
      - name: Publish exact artifact
        run: >-
          dotnet publish src/__NAMESPACE__.Mcp.Server/__NAMESPACE__.Mcp.Server.csproj
          --configuration Release --no-build --output publish
      - name: Smoke exact artifact over stdio
        run: >-
          dotnet tests/__NAMESPACE__.Mcp.Smoke/bin/Release/net10.0/__NAMESPACE__.Mcp.Smoke.dll
          publish/__NAMESPACE__.Mcp.Server.dll
      - name: Smoke exact artifact over Streamable HTTP
        run: >-
          dotnet tests/__NAMESPACE__.Mcp.Smoke/bin/Release/net10.0/__NAMESPACE__.Mcp.Smoke.dll
          publish/__NAMESPACE__.Mcp.Server.dll --http
