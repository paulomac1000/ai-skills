using ModelContextProtocol;
using System.Security.Claims;
using __NAMESPACE__.Mcp.Domain;

namespace __NAMESPACE__.Mcp.Server;

public sealed class InvocationKernel(
    IInventoryService inventory,
    CapabilityRegistry capabilities,
    ApprovalRegistry approvals,
    KeyedOperationGate operationGate,
    ServerSettings settings)
{
    private const string Target = "inventory";

    public async ValueTask<IReadOnlyList<CapabilityManifest>> DescribeAsync(
        ClaimsPrincipal? principal,
        CancellationToken cancellationToken)
    {
        var caller = Caller(principal);
        var manifest = RequireActive(CapabilityNames.DescribeCapabilities);
        RequireScope(caller, manifest.RequiredScope);
        return await ExecuteAsync(
            manifest,
            caller.Principal,
            Target,
            _ => ValueTask.FromResult(capabilities.ForScopes(caller.Scopes)),
            cancellationToken);
    }

    public ValueTask<ListItemsResult> ListAsync(
        ClaimsPrincipal? principal,
        int limit,
        CancellationToken cancellationToken)
    {
        var caller = Caller(principal);
        var manifest = RequireActive(CapabilityNames.ListItems);
        RequireScope(caller, manifest.RequiredScope);
        if (limit is < 1 or > 100)
            throw new McpException("VALIDATION_FAILED: limit must be from 1 to 100.");
        return ExecuteAsync(
            manifest,
            caller.Principal,
            Target,
            token => inventory.ListAsync(limit, token),
            cancellationToken);
    }

    public async ValueTask<InventoryItem> PutAsync(
        ClaimsPrincipal? principal,
        string itemId,
        string name,
        int expectedVersion,
        string approvalToken,
        CancellationToken cancellationToken)
    {
        var caller = Caller(principal);
        var manifest = RequireActive(CapabilityNames.PutItem);
        RequireScope(caller, manifest.RequiredScope);
        if (!settings.WritesEnabled)
            throw new McpException("WRITE_DISABLED: writes are disabled by operator policy.");
        if (string.IsNullOrWhiteSpace(itemId) || itemId.Length > 64)
            throw new McpException("VALIDATION_FAILED: itemId must contain 1-64 characters.");
        if (string.IsNullOrWhiteSpace(name) || name.Length > 200)
            throw new McpException("VALIDATION_FAILED: name must contain 1-200 characters.");
        if (expectedVersion < 0)
            throw new McpException("VALIDATION_FAILED: expectedVersion is mandatory and non-negative.");

        var argumentsDigest = ApprovalArguments.PutItemDigest(itemId, name, expectedVersion);
        Action? approvalGate = null;
        if (manifest.RequiresApproval)
        {
            if (string.IsNullOrWhiteSpace(approvalToken))
                throw new McpException("APPROVAL_REQUIRED: a trusted approval token is required.");
            approvalGate = () =>
            {
                if (!approvals.Consume(
                    approvalToken,
                    caller.Principal,
                    manifest.Name,
                    Target,
                    itemId,
                    argumentsDigest))
                    throw new McpException(
                        "APPROVAL_INVALID: approval is expired, used, or bound to another principal, resource, or argument set.");
            };
        }

        try
        {
            return await ExecuteAsync(
                manifest,
                caller.Principal,
                itemId,
                token => inventory.PutAsync(new(itemId, name, expectedVersion), token),
                cancellationToken,
                beforeExecution: approvalGate);
        }
        catch (InventoryConflictException exception)
        {
            throw new McpException($"CONFLICT: {exception.Message}", exception);
        }
    }

    private CapabilityManifest RequireActive(string name)
    {
        var manifest = capabilities.Require(name);
        if (manifest.ActiveState is not CapabilityActiveState.Active)
            throw new McpException($"CAPABILITY_INACTIVE: {name} is {manifest.ActiveState}.");
        return manifest;
    }

    private async ValueTask<T> ExecuteAsync<T>(
        CapabilityManifest manifest,
        string principal,
        string resourceKey,
        Func<CancellationToken, ValueTask<T>> operation,
        CancellationToken cancellationToken,
        Action? beforeExecution = null)
    {
        using var timeout = new CancellationTokenSource();
        timeout.CancelAfter(TimeSpan.FromMilliseconds(manifest.TimeoutMilliseconds));
        using var linked = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken, timeout.Token);
        IAsyncDisposable? lease = null;
        try
        {
            var concurrency = ConcurrencyFor(manifest, principal, resourceKey);
            lease = await operationGate.EnterAsync(
                concurrency.Key,
                concurrency.Limit,
                concurrency.QueueLimit,
                linked.Token);
            linked.Token.ThrowIfCancellationRequested();
            beforeExecution?.Invoke();
            return await operation(linked.Token);
        }
        catch (OperationCanceledException exception) when (timeout.IsCancellationRequested && !cancellationToken.IsCancellationRequested)
        {
            throw new McpException($"TIMEOUT: {manifest.Name} exceeded {manifest.TimeoutMilliseconds} ms.", exception);
        }
        catch (McpOperationException exception)
        {
            throw new McpException($"{exception.Code}: {exception.Message}", exception);
        }
        finally
        {
            if (lease is not null) await lease.DisposeAsync();
        }
    }

    private static RuntimeConcurrency ConcurrencyFor(
        CapabilityManifest manifest,
        string principal,
        string resourceKey)
    {
        var scope = manifest.ConcurrencyScope switch
        {
            "none" => "global",
            var value when value.Contains("principal", StringComparison.Ordinal)
                && value.Contains("target", StringComparison.Ordinal) =>
                "principal-target",
            var value when value.Contains("principal", StringComparison.Ordinal) =>
                "principal",
            var value when value.Contains("target", StringComparison.Ordinal) =>
                "target",
            _ => "capability",
        };
        var limit = manifest.ConcurrentSafe ? 32 : 1;
        var queueLimit = manifest.ConcurrentSafe ? 64 : 0;
        var key = scope switch
        {
            "global" => "global",
            "principal-target" => $"{manifest.Name}:{principal}:{resourceKey}",
            "principal" => $"{manifest.Name}:{principal}",
            "target" => $"{manifest.Name}:{resourceKey}",
            _ => manifest.Name,
        };
        return new(key, limit, queueLimit);
    }

    private static CallerContext Caller(ClaimsPrincipal? principal)
    {
        if (principal?.Identity?.IsAuthenticated is not true)
            throw new McpException("AUTHENTICATION_FAILED: an authenticated principal is required.");
        var id = principal.FindFirstValue(ClaimTypes.NameIdentifier)
            ?? principal.Identity.Name
            ?? throw new McpException("AUTHENTICATION_FAILED: principal identifier is missing.");
        var scopes = principal.FindAll("scope")
            .SelectMany(claim => claim.Value.Split(' ', StringSplitOptions.RemoveEmptyEntries))
            .ToHashSet(StringComparer.Ordinal);
        return new(id, scopes);
    }

    private static void RequireScope(CallerContext caller, string scope)
    {
        if (!caller.Scopes.Contains(scope))
            throw new McpException($"AUTHORIZATION_FAILED: missing scope {scope}.");
    }

    private sealed record RuntimeConcurrency(string Key, int Limit, int QueueLimit);
    private sealed record CallerContext(string Principal, IReadOnlySet<string> Scopes);
}
