namespace __NAMESPACE__.Mcp.Server;

public sealed class KeyedOperationGate(int maximumKeys = 1_024)
{
    private sealed class Entry(int limit, int queueLimit)
    {
        public SemaphoreSlim Semaphore { get; } = new(limit, limit);
        public int Limit { get; } = limit;
        public int QueueLimit { get; } = queueLimit;
        public int References { get; set; }
        public int Waiting { get; set; }
    }

    private readonly object _sync = new();
    private readonly Dictionary<string, Entry> _entries = new(StringComparer.Ordinal);

    public ValueTask<IAsyncDisposable> EnterAsync(string key, CancellationToken cancellationToken) =>
        EnterAsync(key, limit: 1, queueLimit: 0, cancellationToken);

    public async ValueTask<IAsyncDisposable> EnterAsync(
        string key,
        int limit,
        int queueLimit,
        CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(key))
            throw new ArgumentException("A non-empty concurrency key is required.", nameof(key));
        if (limit is < 1 or > 10_000)
            throw new ArgumentOutOfRangeException(nameof(limit));
        if (queueLimit is < 0 or > 100_000)
            throw new ArgumentOutOfRangeException(nameof(queueLimit));

        Entry entry;
        var acquired = false;
        lock (_sync)
        {
            if (!_entries.TryGetValue(key, out entry!))
            {
                if (_entries.Count >= maximumKeys)
                    throw new McpOperationException("CONCURRENCY_CAPACITY", "The keyed operation gate is at capacity.");
                entry = new Entry(limit, queueLimit);
                _entries.Add(key, entry);
            }
            else if (entry.Limit != limit || entry.QueueLimit != queueLimit)
            {
                throw new McpOperationException(
                    "CONCURRENCY_POLICY_MISMATCH",
                    "The runtime concurrency policy changed while the key was active.");
            }

            entry.References++;
            acquired = entry.Semaphore.Wait(0);
            if (!acquired)
            {
                if (entry.Waiting >= entry.QueueLimit)
                {
                    entry.References--;
                    RemoveIfUnused(key, entry);
                    throw new McpOperationException(
                        "CONCURRENCY_QUEUE_FULL",
                        "The operation concurrency queue is full.");
                }
                entry.Waiting++;
            }
        }

        if (!acquired)
        {
            try
            {
                await entry.Semaphore.WaitAsync(cancellationToken);
            }
            catch
            {
                lock (_sync)
                {
                    entry.Waiting--;
                    entry.References--;
                    RemoveIfUnused(key, entry);
                }
                throw;
            }
            lock (_sync)
            {
                entry.Waiting--;
            }
        }

        return new Lease(this, key, entry);
    }

    private void Exit(string key, Entry entry)
    {
        entry.Semaphore.Release();
        lock (_sync)
        {
            entry.References--;
            RemoveIfUnused(key, entry);
        }
    }

    private void RemoveIfUnused(string key, Entry entry)
    {
        if (entry.References != 0 ||
            !_entries.TryGetValue(key, out var current) ||
            !ReferenceEquals(current, entry))
            return;
        _entries.Remove(key);
        entry.Semaphore.Dispose();
    }

    private sealed class Lease(KeyedOperationGate owner, string key, Entry entry) : IAsyncDisposable
    {
        private KeyedOperationGate? _owner = owner;

        public ValueTask DisposeAsync()
        {
            var current = Interlocked.Exchange(ref _owner, null);
            current?.Exit(key, entry);
            return ValueTask.CompletedTask;
        }
    }
}

public sealed class McpOperationException(string code, string message) : Exception(message)
{
    public string Code { get; } = code;
}
