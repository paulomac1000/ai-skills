namespace __NAMESPACE__.Mcp.Server;

public static class CapabilityNames
{
    public const string DescribeCapabilities = "describe_capabilities";
    public const string ListItems = "list_items";
    public const string PutItem = "put_item";

    public static IReadOnlySet<string> Registered { get; } = new HashSet<string>(StringComparer.Ordinal)
    {
        DescribeCapabilities,
        ListItems,
        PutItem,
    };
}

public sealed record CapabilityManifest(
    string Name,
    bool ReadOnly,
    bool Destructive,
    bool Idempotent,
    bool OpenWorld,
    string RequiredScope,
    bool RequiresApproval,
    string TargetBinding);

public sealed class CapabilityRegistry
{
    private static readonly IReadOnlyDictionary<string, CapabilityManifest> Manifests =
        new Dictionary<string, CapabilityManifest>(StringComparer.Ordinal)
        {
            [CapabilityNames.DescribeCapabilities] = new(
                CapabilityNames.DescribeCapabilities, true, false, true, false,
                "inventory.read", false, "process"),
            [CapabilityNames.ListItems] = new(
                CapabilityNames.ListItems, true, false, true, false,
                "inventory.read", false, "inventory"),
            [CapabilityNames.PutItem] = new(
                CapabilityNames.PutItem, false, false, false, false,
                "inventory.write", true, "inventory:itemId"),
        };

    public CapabilityRegistry()
    {
        if (!Manifests.Keys.ToHashSet(StringComparer.Ordinal).SetEquals(CapabilityNames.Registered))
            throw new InvalidOperationException("Capability manifests do not cover the declared registered tool catalog.");
    }

    public IReadOnlyList<CapabilityManifest> ForScopes(IReadOnlySet<string> scopes) =>
        Manifests.Values
            .Where(manifest => scopes.Contains(manifest.RequiredScope))
            .OrderBy(manifest => manifest.Name, StringComparer.Ordinal)
            .ToArray();
}
