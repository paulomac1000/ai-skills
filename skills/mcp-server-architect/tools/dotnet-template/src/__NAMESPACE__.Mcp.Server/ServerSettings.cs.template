namespace __NAMESPACE__.Mcp.Server;

public sealed record ServerSettings(
    bool Http,
    int HttpPort,
    int MaxRequestBodyBytes,
    bool WritesEnabled)
{
    public static ServerSettings Load(string[] args)
    {
        var http = args.Contains("--http", StringComparer.Ordinal);
        var port = ParseInt("MCP_HTTP_PORT", 8000, 1, 65535);
        var maxBody = ParseInt("MCP_MAX_REQUEST_BODY_BYTES", 1_048_576, 1_024, 16_777_216);
        var writes = ParseBool("MCP_WRITES_ENABLED", false);
        return new(http, port, maxBody, writes);
    }

    private static int ParseInt(string name, int fallback, int minimum, int maximum)
    {
        var raw = Environment.GetEnvironmentVariable(name);
        if (raw is null) return fallback;
        if (!int.TryParse(raw, out var value) || value < minimum || value > maximum)
            throw new InvalidOperationException($"{name} must be from {minimum} to {maximum}.");
        return value;
    }

    private static bool ParseBool(string name, bool fallback)
    {
        var raw = Environment.GetEnvironmentVariable(name);
        if (raw is null) return fallback;
        if (bool.TryParse(raw, out var value)) return value;
        throw new InvalidOperationException($"{name} must be true or false.");
    }
}
