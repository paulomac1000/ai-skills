# pre-commit-config.yaml — MCP server configuration
#
# Template: pre-commit-mcp.j2
# MCP variant — adds tool count and manifest validation
#
# Substitution variables:
#   {{ python_version }}  — Python version string, e.g. "3.14"
#   {{ src_dir }}         — Source directory for mypy/bandit scoping, e.g. "src"
#   {{ src_dirs }}         — List of source directories, e.g. ["src", "tests"]
#   {{ has_docs }}         — Boolean, include AFDS documentation validation
#   {{ mypy_additional_deps }} — Optional: extra mypy type stubs, e.g. "types-requests"
#   {{ expected_tools }}   — Integer, expected number of MCP tools
#   {{ has_manifests }}    — Boolean, validate .mcp/manifest.json

# Canonical pre-commit docs: https://pre-commit.com/
# Discover additional hooks: https://pre-commit.com/hooks.html

fail_fast: false

repos:
  # ── Remote: basic file hygiene ──
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: cef0300fd0fc4d2a87a85fa2093c6b283ea36f4b  # v5.0.0
    hooks:
      - id: trailing-whitespace
      - id: check-yaml
      - id: check-toml
      - id: check-json
      - id: end-of-file-fixer
      - id: check-merge-conflict
      - id: detect-private-key

  # ── Local: formatting, linting, types, security, tests ──
  - repo: local
    hooks:
      - id: ruff-check
        name: ruff check
        entry: python3 -m ruff check --target-version py{{ python_version | replace('.', '') }} .
        language: python
        additional_dependencies: ["ruff>=0.11.0"]
        pass_filenames: true

      - id: ruff-format
        name: ruff format --check
        entry: python3 -m ruff format --check .
        language: python
        additional_dependencies: ["ruff>=0.11.0"]
        pass_filenames: true

      - id: mypy
        name: mypy
        entry: python3 -m mypy --python-version "{{ python_version }}" {{ src_dir }} --strict
        language: python
        additional_dependencies: ["mypy>=1.0", "types-PyYAML"{% if mypy_additional_deps %}, {{ mypy_additional_deps }}{% endif %}]
        pass_filenames: false

      - id: bandit
        name: bandit
        entry: python3 -m bandit -r {{ src_dir }} -ll
        language: python
        additional_dependencies: ["bandit[toml]>=1.7"]
        pass_filenames: false

      - id: pytest
        name: pytest
        entry: bash -c 'python3 -m pytest --collect-only -q tests/ 2>&1 | tail -n +3 | grep -q "ERROR\|errors" && { echo "Test collection FAILED"; exit 1; }; python3 -m pytest tests/ -q 2>&1; if [ ${PIPESTATUS[0]} -ne 0 ]; then exit 1; fi'
        language: system
        pass_filenames: false

{% if has_docs %}
      - id: docs-validate
        name: docs validate
        entry: bash -c 'curl -sS https://raw.githubusercontent.com/paulomac1000/ai-skills/a1b15016df18479027b2064949a3cba1658b6c63/skills/afds-doc-writer/docs_validate.py | python3 - --config afds_config.yaml --strict .'
        language: system
        pass_filenames: false
{% endif %}

  # ── Local: MCP-specific hooks ──
  - repo: local
    hooks:
{% if expected_tools is defined %}
      - id: tool-count-validate
        name: tool count validate
        entry: |
          python3 -c "
          import subprocess
          result = subprocess.run(['grep', '-rh', '@mcp.tool', 'src/'], capture_output=True, text=True)
          count = len([l for l in result.stdout.split('\n') if l.strip()])
          assert count == {{ expected_tools }}, f'Expected {{ expected_tools }} tools, got {count}'
          print(f'Tool count OK: {count}')
          "
        language: python
        pass_filenames: false
{% endif %}
{% if has_manifests %}
      - id: manifest-validate
        name: manifest validate
        entry: |
          python3 -c "
          import json, sys
          with open('.mcp/manifest.json') as f:
              m = json.load(f)
          assert 'tools' in m, 'manifest missing tools array'
          assert len(m['tools']) > 0, 'manifest has zero tools'
          for t in m['tools']:
              assert 'name' in t, f'tool missing name: {t}'
              assert 'description' in t, f'tool {t[\"name\"]} missing description'
          print(f'Manifest valid: {len(m[\"tools\"])} tools, all with name/description')
          "
        language: python
        pass_filenames: false
{% endif %}
