# pre-commit-config.yaml — Base Python configuration
#
# Template: pre-commit-python.j2
# Generated from pre-commit-architect skill
#
# Substitution variables:
#   {{ python_version }}  — Python version string, e.g. "3.14"
#   {{ src_dir }}          — Source directory for mypy/bandit scoping, e.g. "src"
#   {{ src_dirs }}         — List of source directories, e.g. ["src", "tests"]
#   {{ mypy_additional_deps }} — Optional: extra mypy type stubs, e.g. "types-requests"
#   {{ has_docs }}         — Boolean, include AFDS documentation validation

# Canonical pre-commit docs: https://pre-commit.com/
# Discover additional hooks: https://pre-commit.com/hooks.html

fail_fast: false

repos:
  # ── Remote: basic file hygiene ──
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: cef0300fd0fc4d2a87a85fa2093c6b283ea36f4b  # v5.0.0
    hooks:
      - id: trailing-whitespace
      - id: check-yaml
      - id: end-of-file-fixer
      - id: check-merge-conflict
      - id: detect-private-key

  # ── Local: formatting, linting, types, security, tests ──
  - repo: local
    hooks:
      - id: ruff-check
        name: ruff check
        entry: python3 -m ruff check --target-version py{{ python_version | replace('.', '') }} .
        language: python
        additional_dependencies: ["ruff>=0.11.0"]
        pass_filenames: true

      - id: ruff-format
        name: ruff format --check
        entry: python3 -m ruff format --check .
        language: python
        additional_dependencies: ["ruff>=0.11.0"]
        pass_filenames: true

      - id: mypy
        name: mypy
        entry: python3 -m mypy --python-version "{{ python_version }}" {{ src_dir }} --strict
        language: python
        additional_dependencies: ["mypy>=1.0", "types-PyYAML"{% if mypy_additional_deps %}, {{ mypy_additional_deps }}{% endif %}]
        pass_filenames: false

      - id: bandit
        name: bandit
        entry: python3 -m bandit -r {{ src_dir }} -ll
        language: python
        additional_dependencies: ["bandit[toml]>=1.7"]
        pass_filenames: false

      - id: pytest
        name: pytest
        entry: bash -c 'python3 -m pytest tests/ --collect-only -q 2>&1 && python3 -m pytest tests/ -q 2>&1'
        language: system
        pass_filenames: false

{% if has_docs %}
      - id: docs-validate
        name: docs validate
        entry: bash -c 'curl -sS https://raw.githubusercontent.com/paulomac1000/ai-skills/a1b15016df18479027b2064949a3cba1658b6c63/skills/afds-doc-writer/docs_validate.py | python3 - --config afds_config.yaml --strict .'
        language: system
        pass_filenames: false
{% endif %}
