#!/usr/bin/env bash
# .githooks/pre-commit — native git hook (no pre-commit framework)
#
# Template: pre-commit-shell.j2
# Generated from pre-commit-architect skill
# Language: {{ language | default('python') }}
# Source dir: {{ src_dir | default('src/') }}
#
# Runs the same checks CI runs, locally, before the commit lands.
# Install:
#   git config --local core.hooksPath .githooks
#   chmod +x .githooks/pre-commit
#
# Bypass (NOT RECOMMENDED — fix the issues instead):
#   git commit --no-verify

set -u  # Treat unset variables as errors. Do NOT use `set -e` — we want to
        # collect ALL failures and report them in one pass (cf. PRECOMMIT-06).

# ── Configuration ─────────────────────────────────────────────────────────
LANGUAGE="{{ language | default('python') }}"
LINT_COMMAND="{{ lint_command | default('') }}"
SRC_DIR="{{ src_dir | default('src/') }}"

# Color codes (auto-disabled when stdout is not a TTY)
if [ -t 1 ]; then
    RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[0;33m'
    BLUE='\033[0;34m'; BOLD='\033[1m'; RESET='\033[0m'
else
    RED=''; GREEN=''; YELLOW=''; BLUE=''; BOLD=''; RESET=''
fi

# Track failures across all checks
FAILED=0
PASSED=0

# ── Helpers ────────────────────────────────────────────────────────────────
log_header() {
    printf "\n${BOLD}${BLUE}== %s ==${RESET}\n" "$1"
}
log_pass() {
    printf "  ${GREEN}✓${RESET} %s\n" "$1"
    PASSED=$((PASSED + 1))
}
log_fail() {
    printf "  ${RED}✗${RESET} %s\n" "$1"
    if [ -n "${2:-}" ]; then
        printf "    ${RED}%s${RESET}\n" "$2"
    fi
    FAILED=$((FAILED + 1))
}
log_skip() {
    printf "  ${YELLOW}○${RESET} %s (skipped: %s)\n" "$1" "$2"
}

# ── Stage detection ───────────────────────────────────────────────────────
# Get the list of staged files. Empty output means nothing to check
# (e.g., a merge commit or a chmod-only change).
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)
STAGED_COUNT=$(printf '%s' "$STAGED_FILES" | grep -c . 2>/dev/null) || STAGED_COUNT=0

if [ "$STAGED_COUNT" -eq 0 ]; then
    log_skip "pre-commit" "no staged files (merge, partial, or chmod-only commit)"
    exit 0
fi

printf "${BOLD}pre-commit:${RESET} checking %d staged file(s) [language=%s]\n" \
    "$STAGED_COUNT" "$LANGUAGE"

# ── Resolve format command ────────────────────────────────────────────────
# {{ lint_command }} overrides auto-detection. Otherwise pick a default
# per language. Missing tools cause that check to fail loudly — we never
# silently skip (cf. PRECOMMIT-04: no error masking).
#
# Each default restricts the check to STAGED files only (where the tool
# supports per-file invocation). Project-wide tools (cargo, go build) are
# intentionally not used here — the compile-check section handles them.
LANG_FILES=$(printf '%s' "$STAGED_FILES" \
    | grep -E '\.([^/]+)$' -o 2>/dev/null \
    | sort -u || true)

if [ -z "$LINT_COMMAND" ]; then
    case "$LANGUAGE" in
        dotnet)
            LINT_COMMAND="dotnet format --verify-no-changes --include $SRC_DIR"
            ;;
        rust)
            # cargo fmt operates on the whole crate, not individual files.
            LINT_COMMAND="cargo fmt --all -- --check"
            ;;
        go)
            LINT_COMMAND="gofmt -l $SRC_DIR"
            ;;
        python)
            # Restrict to staged .py files (if any)
            PY_FILES=$(printf '%s\n' "$STAGED_FILES" | grep '\.py$' || true)
            if [ -n "$PY_FILES" ]; then
                LINT_COMMAND="python3 -m ruff format --check $PY_FILES"
            else
                LINT_COMMAND=""
            fi
            ;;
        *)
            log_skip "format check" "no default formatter for language '$LANGUAGE'; set lint_command"
            LINT_COMMAND=""
            ;;
    esac
fi

# ── Check 1: Format ───────────────────────────────────────────────────────
log_header "Format"
if [ -n "$LINT_COMMAND" ]; then
    # Capture both stdout and stderr; do NOT mask failures with `|| true`.
    if eval "$LINT_COMMAND" >/tmp/.precommit-format.log 2>&1; then
        log_pass "format check ($LANGUAGE)"
    else
        log_fail "format check ($LANGUAGE)" "$(tail -20 /tmp/.precommit-format.log)"
    fi
    rm -f /tmp/.precommit-format.log
else
    log_skip "format check" "no command resolved"
fi

# ── Check 2: Compile / syntax ─────────────────────────────────────────────
log_header "Compile / syntax"
case "$LANGUAGE" in
    dotnet)
        if command -v dotnet >/dev/null 2>&1; then
            if dotnet build --nologo -clp:NoSummary -v:q >/tmp/.precommit-build.log 2>&1; then
                log_pass "dotnet build"
            else
                log_fail "dotnet build" "$(tail -30 /tmp/.precommit-build.log)"
            fi
            rm -f /tmp/.precommit-build.log
        else
            log_fail "dotnet build" "dotnet not found on PATH"
        fi
        ;;
    rust)
        if command -v cargo >/dev/null 2>&1; then
            # `cargo check` is faster than `cargo build` and sufficient for
            # pre-commit — it does not produce binaries.
            if cargo check --all-targets --message-format=short >/tmp/.precommit-build.log 2>&1; then
                log_pass "cargo check"
            else
                log_fail "cargo check" "$(tail -30 /tmp/.precommit-build.log)"
            fi
            rm -f /tmp/.precommit-build.log
        else
            log_fail "cargo check" "cargo not found on PATH"
        fi
        ;;
    go)
        if command -v go >/dev/null 2>&1; then
            if go build ./... >/tmp/.precommit-build.log 2>&1; then
                log_pass "go build"
            else
                log_fail "go build" "$(tail -30 /tmp/.precommit-build.log)"
            fi
            rm -f /tmp/.precommit-build.log
        else
            log_fail "go build" "go not found on PATH"
        fi
        ;;
    python)
        if command -v python3 >/dev/null 2>&1; then
            if python3 -m compileall -q "$SRC_DIR" >/tmp/.precommit-syntax.log 2>&1; then
                log_pass "python compileall"
            else
                log_fail "python compileall" "$(cat /tmp/.precommit-syntax.log)"
            fi
            rm -f /tmp/.precommit-syntax.log
        else
            log_fail "python compileall" "python3 not found on PATH"
        fi
        ;;
    *)
        log_skip "compile check" "no default compiler for language '$LANGUAGE'"
        ;;
esac

# ── Check 3: Merge conflict markers ───────────────────────────────────────
# Detect unresolved conflict markers in any staged text file. Mirrors the
# pre-commit-hooks `check-merge-conflict` hook.
log_header "Merge conflict markers"
MERGE_CONFLICT_PATTERN='^<<<<<<< |^=======$|^>>>>>>> '
CONFLICT_FILES=$(printf '%s\n' "$STAGED_FILES" \
    | xargs -r grep -lE "$MERGE_CONFLICT_PATTERN" 2>/dev/null || true)
if [ -z "$CONFLICT_FILES" ]; then
    log_pass "no merge conflict markers"
else
    log_fail "merge conflict markers found in:" "$CONFLICT_FILES"
fi

# ── Check 4: Private key / secret material ────────────────────────────────
# Catches PEM/SSH private key blocks. Mirrors the pre-commit-hooks
# `detect-private-key` hook (cf. PRECOMMIT-14: secret scanning is required).
# The `(?-i)` is implicit — we deliberately match only uppercase BEGIN.
log_header "Private key / secret scan"
# `--` ends option parsing (the pattern starts with `-----`).
# The pattern matches `-----BEGIN <KIND> PRIVATE KEY-----` anywhere on a line.
KEY_FILES=$(printf '%s\n' "$STAGED_FILES" \
    | xargs -r grep -lE -- '-----BEGIN[[:space:]]+(RSA|DSA|EC|OPENSSH|PGP|ENCRYPTED)[[:space:]]+PRIVATE[[:space:]]+KEY-----' 2>/dev/null || true)
if [ -z "$KEY_FILES" ]; then
    log_pass "no private key material"
else
    log_fail "private key material found in:" "$KEY_FILES"
fi

# ── Summary ───────────────────────────────────────────────────────────────
log_header "Summary"
if [ "$FAILED" -eq 0 ]; then
    printf "${GREEN}${BOLD}All %d check(s) passed.${RESET}\n" "$PASSED"
    exit 0
else
    printf "${RED}${BOLD}%d of %d check(s) failed.${RESET}\n" \
        "$FAILED" "$((PASSED + FAILED))"
    printf "${YELLOW}Commit blocked. Fix the issues above, then retry.${RESET}\n"
    exit 1
fi
