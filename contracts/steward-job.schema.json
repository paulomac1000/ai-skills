{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paulomac1000.github.io/ai-skills/contracts/steward-job.schema.json",
  "title": "StewardJob",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "jobId",
    "lineageId",
    "generation",
    "attemptId",
    "version",
    "subject",
    "candidate",
    "requestDigest",
    "status",
    "stage",
    "createdAt",
    "updatedAt",
    "heartbeatAt",
    "progressAt",
    "progressRevision",
    "deadlineAt",
    "cancellation",
    "externalOperationRefs",
    "evidenceRefs",
    "artifactRefs"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "jobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "lineageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "attemptId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "subject": {
      "$ref": "#/$defs/identity"
    },
    "candidate": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/candidate"
        }
      ]
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "waiting-external",
        "waiting-retry",
        "reconciling",
        "cancelling",
        "blocked",
        "finalizing",
        "completed",
        "completed-with-gaps",
        "failed",
        "cancelled",
        "superseded"
      ]
    },
    "stage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "domainOutcome": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "heartbeatAt": {
      "type": "string",
      "format": "date-time"
    },
    "progressAt": {
      "type": "string",
      "format": "date-time"
    },
    "progressRevision": {
      "type": "integer",
      "minimum": 0
    },
    "progressMarker": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "deadlineAt": {
      "type": "string",
      "format": "date-time"
    },
    "finalizationStartsAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "lease": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/lease"
        }
      ]
    },
    "cancellation": {
      "enum": [
        "none",
        "requested",
        "fenced",
        "reconciling",
        "completed"
      ]
    },
    "blockedReason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "externalOperationRefs": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifactRefs": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "failure": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/failure"
        }
      ]
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "parentContract": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/parentContract"
        }
      ]
    },
    "obligationSet": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/obligationSet"
        }
      ]
    },
    "obligationSetDigest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "parentContractDigest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "cancellationCause": {
      "enum": [
        "caller_cancel",
        "parent_superseded",
        "service_shutdown",
        "application_deadline",
        "transport_timeout",
        "provider_cancel",
        "unknown",
        null
      ]
    }
  },
  "$defs": {
    "parentContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "supervisor",
        "work",
        "contract",
        "authority",
        "policy",
        "budget",
        "completion",
        "digest"
      ],
      "properties": {
        "mode": {
          "enum": [
            "standalone",
            "supervised"
          ]
        },
        "supervisor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "systemId",
            "principalOrInstance"
          ],
          "properties": {
            "systemId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "principalOrInstance": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 200
            }
          }
        },
        "work": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "parentWorkId",
            "parentRunId",
            "generation"
          ],
          "properties": {
            "parentWorkId": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 200
            },
            "parentRunId": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 200
            },
            "generation": {
              "type": "integer",
              "minimum": 1
            },
            "attempt": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 200
            }
          }
        },
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "revision",
            "digest"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "delegatedCapabilities",
            "forbiddenCapabilities",
            "parentCompletionAuthority",
            "authorityCeiling"
          ],
          "properties": {
            "delegatedCapabilities": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "forbiddenCapabilities": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "parentCompletionAuthority": {
              "enum": [
                "none",
                "report_only",
                "explicit_mutation"
              ]
            },
            "authorityCeiling": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "revisionOrDigest"
          ],
          "properties": {
            "revisionOrDigest": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 200
            }
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "absoluteDeadline",
            "retryOrResourceBudgetRef"
          ],
          "properties": {
            "absoluteDeadline": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "retryOrResourceBudgetRef": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 200
            }
          }
        },
        "completion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "obligationsRef",
            "terminalBoundary",
            "handoffContract"
          ],
          "properties": {
            "obligationsRef": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 200
            },
            "terminalBoundary": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 200
            },
            "handoffContract": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "obligationSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "digest",
        "proofRecipeDigest",
        "obligations"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "proofRecipeDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "obligations": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "required",
              "evidenceClass",
              "criterionDigest"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "required": {
                "type": "boolean"
              },
              "evidenceClass": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "criterionDigest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "revision"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "digest": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "revision",
        "digest"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "fencingToken",
        "expiresAt"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "fencingToken": {
          "type": "integer",
          "minimum": 1
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "phase",
        "completionKnown",
        "sideEffectsKnown"
      ],
      "properties": {
        "class": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "completionKnown": {
          "type": "boolean"
        },
        "sideEffectsKnown": {
          "type": "boolean"
        },
        "diagnosticRef": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
