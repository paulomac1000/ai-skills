{
  "$defs": {
    "exposure": {
      "additionalProperties": false,
      "properties": {
        "affected_sinks": {
          "items": {
            "$ref": "#/$defs/sink"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "exposure_state": {
          "const": "externally_exposed"
        },
        "opaque_ref": {
          "minLength": 1,
          "type": "string"
        },
        "remediation": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "sensitivity": {
          "$ref": "#/$defs/sensitivity"
        },
        "source_boundary": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "opaque_ref",
        "sensitivity",
        "source_boundary",
        "affected_sinks",
        "exposure_state",
        "remediation"
      ],
      "type": "object"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "allowed_sinks": {
          "items": {
            "$ref": "#/$defs/sink"
          },
          "type": "array",
          "uniqueItems": true
        },
        "exposure_state": {
          "enum": [
            "not_model_visible",
            "model_visible",
            "externally_exposed"
          ]
        },
        "opaque_ref": {
          "minLength": 1,
          "type": "string"
        },
        "sensitivity": {
          "$ref": "#/$defs/sensitivity"
        },
        "source_boundary": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "sensitivity",
        "source_boundary",
        "allowed_sinks",
        "opaque_ref",
        "exposure_state"
      ],
      "type": "object"
    },
    "sensitivity": {
      "enum": [
        "credential",
        "secret",
        "personal",
        "sensitive",
        "public",
        "unknown"
      ]
    },
    "sink": {
      "enum": [
        "delegated_prompt",
        "external_model_prompt",
        "tool_argument",
        "argv",
        "temporary_script",
        "github_output",
        "durable_evidence",
        "log",
        "memory",
        "screenshot",
        "protected_runtime_channel"
      ]
    }
  },
  "$id": "https://example.invalid/ai-skills/secret-taint.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/metadata"
    },
    {
      "$ref": "#/$defs/exposure"
    }
  ],
  "title": "Secret taint metadata and exposure records"
}
