{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/paulomac1000/ai-skills/blob/main/contracts/runtime-acceptance-receipt.schema.json",
  "title": "Runtime Acceptance Receipt v1",
  "description": "Provider-neutral acceptance receipt binding expected deployment identity to independently observed RuntimeIdentity, proof obligations, evidence inputs, and currentness dependencies.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "receipt_kind",
    "acceptance_id",
    "acceptance_profile",
    "policy_revision",
    "target",
    "expected",
    "observed",
    "proofs",
    "inputs",
    "dependency_snapshot",
    "verdict",
    "currentness_at_issue",
    "payload_digest"
  ],
  "properties": {
    "format": {"const": "ai-skills-runtime-acceptance"},
    "schema_version": {"const": 1},
    "receipt_kind": {"const": "runtime_acceptance"},
    "acceptance_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "acceptance_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 256},
        "revision": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "policy_revision": {"type": "string", "minLength": 1, "maxLength": 256},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_class", "deployment_identity"],
      "properties": {
        "environment_class": {"type": "string", "minLength": 1, "maxLength": 128},
        "deployment_identity": {"type": "string", "minLength": 1, "maxLength": 256},
        "target_identity": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_digest"],
      "properties": {
        "source_revision": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40}$"},
        "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
        "artifact_identity": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
        "config_revision": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "deployment_operation_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 2048}
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_identity_ref", "runtime_id", "instance_generation", "observed_at"],
      "properties": {
        "runtime_identity_ref": {"type": "string", "minLength": 1, "maxLength": 2048},
        "runtime_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "source_revision": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40}$"},
        "artifact_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-fA-F]{64}$"},
        "artifact_version": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "config_revision": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "instance_generation": {"type": "string", "minLength": 1, "maxLength": 256},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    },
    "proofs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "required", "status", "authority", "evidence_ref"],
        "properties": {
          "kind": {"type": "string", "minLength": 1, "maxLength": 256},
          "required": {"type": "boolean"},
          "status": {"enum": ["proven", "failed", "unknown", "unsupported"]},
          "authority": {"type": "string", "minLength": 1, "maxLength": 256},
          "evidence_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 2048}
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_refs", "evidence_set_digest"],
      "properties": {
        "evidence_refs": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 2048}
        },
        "evidence_set_digest": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"}
      }
    },
    "dependency_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_digest",
        "source_revision",
        "config_revision",
        "instance_generation",
        "acceptance_profile_revision",
        "policy_revision"
      ],
      "properties": {
        "artifact_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-fA-F]{64}$"},
        "source_revision": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40}$"},
        "config_revision": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "instance_generation": {"type": "string", "minLength": 1, "maxLength": 256},
        "acceptance_profile_revision": {"type": "string", "minLength": 1, "maxLength": 256},
        "policy_revision": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "verdict": {"enum": ["accepted", "rejected", "inconclusive"]},
    "currentness_at_issue": {"const": "CURRENT"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "payload_digest": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"}
  }
}
