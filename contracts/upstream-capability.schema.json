{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paulomac1000.github.io/ai-skills/contracts/upstream-capability.schema.json",
  "title": "StewardUpstreamCapability",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capability_id", "contract", "subject_types", "target_types", "identity_dimensions_observed", "evidence_classes_produced", "interaction", "delivery", "idempotency", "recovery", "cancellation", "progress", "reconciliation", "deadline", "credential_affinity", "bounds", "confidentiality"],
  "properties": {
    "schema_version": {"const": 2},
    "capability_id": {"type": "string", "minLength": 1, "maxLength": 300},
    "contract": {"type": "object", "additionalProperties": false, "required": ["source", "id", "revision", "digest"], "properties": {"source": {"enum": ["negotiated-trusted", "discovered-trusted", "pinned-trusted", "operator-config"]}, "id": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "subject_types": {"$ref": "#/$defs/stringSet"},
    "target_types": {"$ref": "#/$defs/stringSet"},
    "identity_dimensions_observed": {"$ref": "#/$defs/stringSet"},
    "evidence_classes_produced": {"$ref": "#/$defs/stringSet"},
    "interaction": {"enum": ["stateless", "stateful"]},
    "delivery": {"enum": ["synchronous", "durable-async"]},
    "idempotency": {"enum": ["none", "caller-key", "provider-key"]},
    "recovery": {"enum": ["none", "replay-safe", "status-by-handle", "resume-by-handle"]},
    "cancellation": {"type": "object", "additionalProperties": false, "required": ["mode", "delivery_model", "idempotency", "reconciliation", "handle_affinity", "local_terminal_requires_remote_resolution"], "properties": {"mode": {"enum": ["none", "best-effort", "confirmed"]}, "delivery_model": {"enum": ["none", "synchronous", "stateful"]}, "idempotency": {"enum": ["none", "intrinsic", "caller-key", "provider-key"]}, "reconciliation": {"enum": ["unsupported", "lookup-by-idempotency-key", "status-by-handle", "independent-read-back"]}, "handle_affinity": {"enum": ["none", "operation", "job"]}, "local_terminal_requires_remote_resolution": {"type": "boolean"}}},
    "progress": {"type": "object", "additionalProperties": false, "required": ["kind", "stable_revision", "wait_hint", "worker_wait_policy"], "properties": {"kind": {"enum": ["none", "heartbeat", "sequence", "percent", "state-revision"]}, "stable_revision": {"type": "boolean"}, "wait_hint": {"enum": ["none", "server-side-wait", "retry-after", "next-poll-at"]}, "worker_wait_policy": {"enum": ["inline-bounded", "external-maintenance"]}}},
    "reconciliation": {"type": "object", "additionalProperties": false, "required": ["ambiguous_delivery"], "properties": {"ambiguous_delivery": {"enum": ["unsupported", "lookup-by-idempotency-key", "status-by-handle", "independent-read-back"]}}},
    "deadline": {"type": "object", "additionalProperties": false, "required": ["application_owned", "transport_may_shorten"], "properties": {"application_owned": {"const": true}, "transport_may_shorten": {"type": "boolean"}}},
    "credential_affinity": {"enum": ["none", "operation", "job"]},
    "bounds": {"type": "object", "additionalProperties": false, "required": ["max_request_bytes", "max_result_bytes", "concurrency_scope", "rate_limit_scope"], "properties": {"max_request_bytes": {"type": ["integer", "null"], "minimum": 1}, "max_result_bytes": {"type": ["integer", "null"], "minimum": 1}, "concurrency_scope": {"type": "string", "minLength": 1}, "rate_limit_scope": {"type": "string", "minLength": 1}}},
    "confidentiality": {"type": "object", "additionalProperties": false, "required": ["egress_class"], "properties": {"egress_class": {"enum": ["local", "private-network", "approved-external", "public"]}}}
  },
  "$defs": {"stringSet": {"type": "array", "uniqueItems": true, "maxItems": 256, "items": {"type": "string", "minLength": 1}}}
}
