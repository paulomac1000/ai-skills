{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/paulomac1000/ai-skills/blob/main/contracts/verification-receipt.schema.json",
  "title": "Verification receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate",
    "bootstrap",
    "test_corpus",
    "execution_integrity",
    "isolation",
    "verdict"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_revision"
      ],
      "properties": {
        "source_revision": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "artifact_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "runtime_identity": {
          "anyOf": [
            {
              "$ref": "runtime-identity.schema.json"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_revision",
        "declared_dependencies_only"
      ],
      "properties": {
        "policy_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "declared_dependencies_only": {
          "type": "boolean"
        },
        "resolved_dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "resolved_version",
              "kind",
              "source",
              "source_digest"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "resolved_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "kind": {
                "enum": [
                  "lockfile",
                  "manifest",
                  "tool-version-file",
                  "bootstrap-script",
                  "immutable-image"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "source_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        },
        "hosted_only": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "test_corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_revision",
        "discovered_files",
        "executed_files",
        "excluded_files",
        "accounted_files",
        "discovery_drift",
        "execution_evidence",
        "completeness"
      ],
      "properties": {
        "policy_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "discovered_files": {
          "type": "integer",
          "minimum": 0
        },
        "executed_files": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "reason"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "owner": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 256
              },
              "expires_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            }
          }
        },
        "accounted_files": {
          "description": "Producer-computed executed plus valid excluded file count; canonical semantic validation recomputes this value.",
          "type": "integer",
          "minimum": 0
        },
        "discovery_drift": {
          "type": "integer",
          "minimum": 0
        },
        "execution_evidence": {
          "enum": [
            "observed",
            "unknown"
          ]
        },
        "completeness": {
          "enum": [
            "complete",
            "unknown",
            "drift"
          ]
        }
      }
    },
    "execution_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cancelled",
        "pending",
        "unhandled_exceptions",
        "unraisable",
        "blocking_warnings",
        "leaked_async_work"
      ],
      "properties": {
        "cancelled": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        },
        "unhandled_exceptions": {
          "type": "integer",
          "minimum": 0
        },
        "unraisable": {
          "type": "integer",
          "minimum": 0
        },
        "blocking_warnings": {
          "type": "integer",
          "minimum": 0
        },
        "leaked_async_work": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "const": "unknown"
            }
          ]
        },
        "allowed_warnings": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_effective_state_touched"
      ],
      "properties": {
        "production_effective_state_touched": {
          "type": "boolean"
        },
        "writable_resources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "protected_resources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      }
    },
    "hosted_parity": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "required_gates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "executed_gates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hosted_only": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "incomplete",
        "degraded",
        "blocked"
      ]
    },
    "known_gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "pass"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "required": [
          "evidence_refs"
        ],
        "properties": {
          "evidence_refs": {
            "minItems": 1
          },
          "bootstrap": {
            "properties": {
              "declared_dependencies_only": {
                "const": true
              }
            }
          },
          "test_corpus": {
            "properties": {
              "discovery_drift": {
                "const": 0
              },
              "execution_evidence": {
                "const": "observed"
              },
              "completeness": {
                "const": "complete"
              }
            }
          },
          "execution_integrity": {
            "properties": {
              "cancelled": {
                "const": 0
              },
              "pending": {
                "const": 0
              },
              "unhandled_exceptions": {
                "const": 0
              },
              "unraisable": {
                "const": 0
              },
              "blocking_warnings": {
                "const": 0
              },
              "leaked_async_work": {
                "enum": [
                  0
                ]
              }
            }
          },
          "isolation": {
            "properties": {
              "production_effective_state_touched": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "pass"
          },
          "test_corpus": {
            "properties": {
              "executed_files": {
                "const": 0
              },
              "excluded_files": {
                "maxItems": 0
              }
            },
            "required": [
              "executed_files",
              "excluded_files"
            ]
          }
        },
        "required": [
          "verdict",
          "test_corpus"
        ]
      },
      "then": {
        "properties": {
          "test_corpus": {
            "properties": {
              "discovered_files": {
                "const": 0
              }
            }
          }
        }
      }
    }
  ]
}
