{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/paulomac1000/ai-skills/blob/main/contracts/atomic-claim-report.schema.json",
  "title": "AI Skills atomic child-control report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "repository", "skill", "context", "checks", "residual_risks"],
  "properties": {
    "schema_version": {"const": 1},
    "report_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "revision"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "skill": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_level", "profiles", "capabilities"],
      "properties": {
        "target_level": {"enum": ["L1", "L2", "L3", "L4"]},
        "profiles": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_id",
          "status",
          "implementation",
          "command",
          "result",
          "evidence_types",
          "evidence_paths"
        ],
        "properties": {
          "control_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
          "status": {"const": "passed"},
          "implementation": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "symbol"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "symbol": {"type": "string", "minLength": 1}
              }
            }
          },
          "command": {"type": "string", "minLength": 1},
          "result": {"const": "passed"},
          "evidence_types": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": ["unit", "integration", "official-client", "artifact", "security", "review"]
            },
            "uniqueItems": true
          },
          "evidence_paths": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    },
    "residual_risks": {"type": "array"}
  }
}
