{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/paulomac1000/ai-skills/blob/main/contracts/runtime-identity.schema.json",
  "title": "Runtime identity",
  "description": "Identity reported by a running instance; artifact identity is stable across restarts while instance_generation changes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtime_id", "instance_generation"],
  "properties": {
    "schema_version": {"const": 1},
    "runtime_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_revision": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40}$"},
    "artifact_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-fA-F]{64}$"},
    "artifact_version": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
    "config_revision": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "instance_generation": {"type": "string", "minLength": 1, "maxLength": 256},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "owner": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "provenance_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2048}, "uniqueItems": true}
  }
}
