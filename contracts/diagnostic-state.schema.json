{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/paulomac1000/ai-skills/blob/main/contracts/diagnostic-state.schema.json",
  "title": "Diagnostic reasoning state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observations", "hypotheses", "causal_assessment"],
  "properties": {
    "schema_version": {"const": 1},
    "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
    "hypotheses": {"type": "array", "items": {"$ref": "#/$defs/hypothesis"}},
    "probes": {"type": "array", "items": {"$ref": "#/$defs/probe"}},
    "causal_assessment": {"$ref": "#/$defs/causalAssessment"},
    "effective_config_provenance": {"type": "array", "items": {"$ref": "#/$defs/configSource"}},
    "remediation_attempts": {"type": "array", "items": {"$ref": "#/$defs/remediationAttempt"}},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2048}, "uniqueItems": true}
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claim", "evidence_ref", "classification"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "claim": {"type": "string", "minLength": 1, "maxLength": 4096},
        "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 2048},
        "observed_at": {"type": ["string", "null"], "format": "date-time"},
        "runtime_identity": {"anyOf": [{"$ref": "runtime-identity.schema.json"}, {"type": "null"}]},
        "classification": {"enum": ["FACT", "OBSERVATION"]},
        "scope": {"enum": ["process", "capability", "dependency", "configuration", "external", "unknown"]},
        "source_group": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "source_group", "predictions", "observed_outcome", "evidence_ref"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "description": {"type": "string", "minLength": 1, "maxLength": 4096},
        "source_group": {"type": "string", "minLength": 1, "maxLength": 256},
        "predictions": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 64,
          "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 2048}
        },
        "observed_outcome": {"type": ["string", "null"], "minLength": 1, "maxLength": 2048},
        "evidence_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 2048}
      },
      "oneOf": [
        {
          "properties": {
            "observed_outcome": {"type": "null"},
            "evidence_ref": {"type": "null"}
          }
        },
        {
          "properties": {
            "observed_outcome": {"type": "string", "minLength": 1},
            "evidence_ref": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claim", "status", "supporting_evidence", "contradicting_evidence", "next_discriminating_probe"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "claim": {"type": "string", "minLength": 1, "maxLength": 4096},
        "status": {"enum": ["active", "supported", "disproven", "unknown"]},
        "supporting_evidence": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2048}, "uniqueItems": true},
        "contradicting_evidence": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2048}, "uniqueItems": true},
        "next_discriminating_probe": {"type": ["string", "null"], "maxLength": 4096},
        "revision": {"type": "integer", "minimum": 1},
        "reopen": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from_revision", "evidence_ref"],
          "properties": {
            "from_revision": {"type": "integer", "minimum": 1},
            "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 2048}
          }
        },
        "config_source_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2048}, "uniqueItems": true}
      }
    },
    "causalAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "causes", "unresolved_alternatives"],
      "properties": {
        "status": {"enum": ["proven", "partial", "suspected", "unknown"]},
        "causes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hypothesis_id", "role", "support", "evidence_refs"],
            "properties": {
              "hypothesis_id": {"type": "string", "minLength": 1, "maxLength": 128},
              "role": {"enum": ["primary", "contributing", "necessary_precondition", "alternative"]},
              "support": {"enum": ["proven", "supported", "possible"]},
              "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2048}, "uniqueItems": true}
            }
          }
        },
        "unresolved_alternatives": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 128}, "uniqueItems": true}
      }
    },
    "configSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "source", "status"],
      "properties": {
        "component": {"type": "string", "minLength": 1, "maxLength": 512},
        "source": {"type": "string", "minLength": 1, "maxLength": 2048},
        "status": {"enum": ["candidate", "runtime-proven", "contradicted", "unknown"]},
        "evidence_ref": {"type": ["string", "null"], "maxLength": 2048}
      }
    },
    "remediationAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothesis_id", "evidence_ref", "predicted_postcondition", "status"],
      "properties": {
        "hypothesis_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 2048},
        "predicted_postcondition": {"type": "string", "minLength": 1, "maxLength": 4096},
        "observed_postcondition": {"type": ["string", "null"], "maxLength": 4096},
        "status": {"enum": ["verified", "failed", "partial", "unknown"]}
      }
    }
  }
}
