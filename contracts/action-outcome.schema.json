{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/paulomac1000/ai-skills/contracts/action-outcome.schema.json",
  "title": "Agentic Action Outcome",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transport",
    "execution",
    "side_effect",
    "artifact_publication",
    "verification",
    "disposition",
    "safe_to_retry"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "transport": {
      "enum": ["succeeded", "failed", "timed_out", "unknown"]
    },
    "execution": {
      "enum": ["not_started", "running", "succeeded", "failed", "unknown"]
    },
    "side_effect": {
      "enum": ["none", "published", "confirmed", "disproven", "unknown"]
    },
    "artifact_publication": {
      "enum": ["not_applicable", "not_published", "published", "unknown"]
    },
    "verification": {
      "enum": ["not_run", "passed", "failed", "partial", "stale", "unknown"]
    },
    "disposition": {
      "enum": ["completed", "pending", "reconcile_required", "failed", "blocked"]
    },
    "safe_to_retry": {
      "enum": ["yes", "no", "unknown"]
    },
    "result_ref": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 512
    },
    "reconciliation_ref": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 512
    },
    "details": {
      "type": "object",
      "additionalProperties": true,
      "maxProperties": 32
    }
  },
  "allOf": [
    {
      "if": {"properties": {"execution": {"const": "running"}}, "required": ["execution"]},
      "then": {
        "properties": {
          "disposition": {"enum": ["pending", "reconcile_required"]}
        }
      }
    },
    {
      "if": {"properties": {"side_effect": {"const": "unknown"}}, "required": ["side_effect"]},
      "then": {
        "properties": {
          "disposition": {"enum": ["reconcile_required", "pending"]},
          "safe_to_retry": {"enum": ["no", "unknown"]}
        }
      }
    },
    {
      "if": {
        "properties": {"artifact_publication": {"const": "published"}},
        "required": ["artifact_publication"]
      },
      "then": {
        "required": ["result_ref"]
      }
    },
    {
      "if": {
        "properties": {"verification": {"const": "stale"}},
        "required": ["verification"]
      },
      "then": {
        "not": {"properties": {"disposition": {"const": "completed"}}, "required": ["disposition"]}
      }
    },
    {
      "if": {
        "properties": {"disposition": {"const": "completed"}},
        "required": ["disposition"]
      },
      "then": {
        "properties": {
          "execution": {"const": "succeeded"},
          "side_effect": {"enum": ["none", "confirmed", "published"]}
        }
      }
    }
  ]
}
