{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ai-skills consumer feedback registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "incidents"],
  "properties": {
    "schema_version": {"const": 1},
    "incidents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source_kind", "failure_mode", "generalized_invariant", "canonical_owner", "regression_selectors", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,95}$"},
          "source_kind": {"enum": ["external-consumer", "field-report"]},
          "source_canaries": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}},
          "failure_mode": {"type": "string", "minLength": 20},
          "generalized_invariant": {"type": "string", "minLength": 20},
          "canonical_owner": {"type": "string", "pattern": "^[A-Za-z0-9_.\\-/]+\\.md#[a-z0-9][a-z0-9-]*$"},
          "regression_selectors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^tests/[A-Za-z0-9_.\\-/]+\\.py::test_[A-Za-z0-9_]+$"}},
          "status": {"enum": ["implemented", "deferred"]},
          "deferred_reason": {"type": "string", "minLength": 20}
        },
        "allOf": [
          {"if": {"properties": {"source_kind": {"const": "external-consumer"}}, "required": ["source_kind"]}, "then": {"required": ["source_canaries"], "properties": {"source_canaries": {"minItems": 1}}}},
          {"if": {"properties": {"status": {"const": "deferred"}}, "required": ["status"]}, "then": {"required": ["deferred_reason"]}}
        ]
      }
    }
  }
}
