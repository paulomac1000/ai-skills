{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/paulomac1000/ai-skills/blob/main/contracts/agentic-governance.schema.json",
  "title": "AI Skills agentic governance contracts",
  "description": "Repository-level semantic contracts shared by CI, MCP, delegation, research, QA and diagnostic skills. Consumers reference named definitions rather than defining private variants.",
  "$defs": {
    "runtime_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "runtime_id", "instance_generation"],
      "properties": {
        "schema_version": {"const": 1},
        "runtime_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "source_revision": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40}$"},
        "artifact_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-fA-F]{64}$"},
        "artifact_version": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "config_revision": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "instance_generation": {"type": "string", "minLength": 1, "maxLength": 256},
        "started_at": {"type": ["string", "null"], "format": "date-time"},
        "owner": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "provenance_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2048}, "uniqueItems": true}
      }
    },
    "action_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "transport", "execution", "side_effect", "artifact", "verification", "disposition", "safe_to_retry"],
      "properties": {
        "schema_version": {"const": 1},
        "transport": {"enum": ["not_attempted", "accepted", "succeeded", "failed", "timed_out", "unknown"]},
        "execution": {"enum": ["not_started", "accepted", "running", "succeeded", "failed", "cancelled", "unknown"]},
        "side_effect": {"enum": ["none", "not_started", "published", "confirmed", "disproven", "partial", "unknown"]},
        "artifact": {"enum": ["none", "expected", "published", "missing", "unknown"]},
        "verification": {"enum": ["not_run", "passed", "failed", "partial", "stale", "unknown"]},
        "disposition": {"enum": ["completed", "pending", "reconcile_required", "failed", "blocked", "cancelled"]},
        "safe_to_retry": {"enum": ["yes", "no", "unknown"]},
        "operation_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "artifact_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2048}, "uniqueItems": true},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2048}, "uniqueItems": true},
        "notes": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2048}}
      },
      "allOf": [
        {
          "if": {"properties": {"disposition": {"const": "completed"}}, "required": ["disposition"]},
          "then": {"properties": {"execution": {"const": "succeeded"}, "verification": {"enum": ["passed", "not_run"]}}}
        },
        {
          "if": {"properties": {"side_effect": {"const": "unknown"}}, "required": ["side_effect"]},
          "then": {"properties": {"disposition": {"enum": ["reconcile_required", "pending", "failed"]}, "safe_to_retry": {"enum": ["no", "unknown"]}}}
        },
        {
          "if": {"properties": {"verification": {"const": "stale"}}, "required": ["verification"]},
          "then": {"properties": {"disposition": {"not": {"const": "completed"}}}}
        },
        {
          "if": {"properties": {"artifact": {"const": "missing"}}, "required": ["artifact"]},
          "then": {"properties": {"disposition": {"not": {"const": "completed"}}}}
        }
      ]
    },
    "audit_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "event_id", "correlation_id", "timestamp", "actor", "action", "outcome"],
      "properties": {
        "schema_version": {"const": 1},
        "event_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "correlation_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "timestamp": {"type": "string", "format": "date-time"},
        "actor": {
          "type": "object", "additionalProperties": false, "required": ["principal"],
          "properties": {"principal": {"type": "string", "minLength": 1, "maxLength": 256}, "session": {"type": ["string", "null"], "maxLength": 256}}
        },
        "action": {
          "type": "object", "additionalProperties": false, "required": ["capability", "operation", "target"],
          "properties": {
            "capability": {"type": "string", "minLength": 1, "maxLength": 256},
            "operation": {"type": "string", "minLength": 1, "maxLength": 256},
            "target": {"type": "string", "minLength": 1, "maxLength": 2048},
            "normalized_args_digest": {"type": ["string", "null"], "pattern": "^(hmac-)?sha256:[0-9a-fA-F]{64}$"}
          }
        },
        "runtime": {"$ref": "#/$defs/runtime_identity"},
        "outcome": {"$ref": "#/$defs/action_outcome"},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2048}, "uniqueItems": true},
        "policy_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2048}, "uniqueItems": true},
        "approval_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2048}, "uniqueItems": true},
        "retention_class": {"type": ["string", "null"], "maxLength": 128},
        "extensions": {"type": "object"}
      }
    },
    "deployment_lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "lease_id", "principal", "target", "artifact_digest", "action", "normalized_args_digest", "policy_revision", "issued_at", "expires_at", "state"],
      "properties": {
        "schema_version": {"const": 1},
        "lease_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "principal": {"type": "string", "minLength": 1, "maxLength": 256},
        "session": {"type": ["string", "null"], "maxLength": 256},
        "target": {"type": "string", "minLength": 1, "maxLength": 2048},
        "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
        "source_revision": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40}$"},
        "action": {"enum": ["deploy", "rollback", "restart", "promote", "migrate"]},
        "normalized_args_digest": {"type": "string", "pattern": "^(hmac-)?sha256:[0-9a-fA-F]{64}$"},
        "policy_revision": {"type": "string", "minLength": 1, "maxLength": 256},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "state": {"enum": ["active", "used", "revoked", "expired"]},
        "parent_lease_id": {"type": ["string", "null"], "maxLength": 256},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2048}, "uniqueItems": true}
      }
    },
    "tool_result_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "data", "provenance", "annotations"],
      "properties": {
        "schema_version": {"const": 1},
        "data": {},
        "data_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"},
        "provenance": {
          "type": "object", "additionalProperties": false, "required": ["data_source"],
          "properties": {
            "data_source": {"enum": ["tool", "provider", "runtime", "synthetic", "user"]},
            "source_id": {"type": ["string", "null"], "maxLength": 512},
            "runtime_identity": {"anyOf": [{"$ref": "#/$defs/runtime_identity"}, {"type": "null"}]},
            "fetched_at": {"type": ["string", "null"], "format": "date-time"},
            "content_type": {"type": ["string", "null"], "maxLength": 256},
            "extraction": {"type": ["object", "null"]}
          }
        },
        "annotations": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["source", "kind", "text"],
            "properties": {
              "source": {"const": "runtime"},
              "kind": {"enum": ["reminder", "policy", "routing", "warning", "degradation"]},
              "text": {"type": "string", "minLength": 1, "maxLength": 4096}
            }
          }
        }
      }
    },
    "verification_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "candidate", "bootstrap", "test_corpus", "execution_integrity", "isolation", "verdict"],
      "properties": {
        "schema_version": {"const": 1},
        "candidate": {
          "type": "object", "additionalProperties": false, "required": ["source_revision"],
          "properties": {
            "source_revision": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
            "artifact_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-fA-F]{64}$"},
            "runtime_identity": {"anyOf": [{"$ref": "#/$defs/runtime_identity"}, {"type": "null"}]}
          }
        },
        "bootstrap": {
          "type": "object", "additionalProperties": false, "required": ["policy_revision", "declared_dependencies_only"],
          "properties": {
            "policy_revision": {"type": "string", "minLength": 1, "maxLength": 256},
            "declared_dependencies_only": {"type": "boolean"},
            "resolved_dependencies": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 512}},
            "hosted_only": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 512}}
          }
        },
        "test_corpus": {
          "type": "object", "additionalProperties": false,
          "required": ["policy_revision", "discovered_files", "executed_files", "excluded_files", "discovery_drift"],
          "properties": {
            "policy_revision": {"type": "string", "minLength": 1, "maxLength": 256},
            "discovered_files": {"type": "integer", "minimum": 0},
            "executed_files": {"type": "integer", "minimum": 0},
            "excluded_files": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false, "required": ["path", "reason"],
                "properties": {
                  "path": {"type": "string", "minLength": 1, "maxLength": 2048},
                  "reason": {"type": "string", "minLength": 1, "maxLength": 2048},
                  "owner": {"type": ["string", "null"], "maxLength": 256},
                  "expires_at": {"type": ["string", "null"], "format": "date-time"}
                }
              }
            },
            "discovery_drift": {"type": "integer", "minimum": 0}
          }
        },
        "execution_integrity": {
          "type": "object", "additionalProperties": false,
          "required": ["cancelled", "pending", "unhandled_exceptions", "unraisable", "blocking_warnings"],
          "properties": {
            "cancelled": {"type": "integer", "minimum": 0},
            "pending": {"type": "integer", "minimum": 0},
            "unhandled_exceptions": {"type": "integer", "minimum": 0},
            "unraisable": {"type": "integer", "minimum": 0},
            "blocking_warnings": {"type": "integer", "minimum": 0},
            "leaked_async_work": {"oneOf": [{"type": "integer", "minimum": 0}, {"const": "unknown"}]},
            "allowed_warnings": {"type": "integer", "minimum": 0}
          }
        },
        "isolation": {
          "type": "object", "additionalProperties": false, "required": ["production_effective_state_touched"],
          "properties": {
            "production_effective_state_touched": {"type": "boolean"},
            "writable_resources": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
            "protected_resources": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2048}}
          }
        },
        "hosted_parity": {
          "type": ["object", "null"], "additionalProperties": false,
          "properties": {
            "required_gates": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "executed_gates": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "hosted_only": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "verdict": {"enum": ["pass", "fail", "incomplete", "degraded", "blocked"]},
        "known_gaps": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2048}, "uniqueItems": true}
      },
      "allOf": [
        {
          "if": {"properties": {"verdict": {"const": "pass"}}, "required": ["verdict"]},
          "then": {
            "properties": {
              "bootstrap": {"properties": {"declared_dependencies_only": {"const": true}}},
              "test_corpus": {"properties": {"discovery_drift": {"const": 0}}},
              "execution_integrity": {"properties": {"cancelled": {"const": 0}, "pending": {"const": 0}, "unhandled_exceptions": {"const": 0}, "unraisable": {"const": 0}, "blocking_warnings": {"const": 0}, "leaked_async_work": {"enum": [0]}}},
              "isolation": {"properties": {"production_effective_state_touched": {"const": false}}}
            }
          }
        }
      ]
    },
    "skill_installation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "skill_id", "source", "source_revision", "distribution_mode", "install_scope", "managed_by", "update_policy", "cleanup_policy"],
      "properties": {
        "schema_version": {"const": 1},
        "skill_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "source": {"type": "string", "minLength": 1, "maxLength": 2048},
        "source_revision": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "source_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-fA-F]{64}$"},
        "distribution_mode": {"enum": ["GLOBAL", "VENDORED", "EPHEMERAL"]},
        "install_scope": {"type": "string", "minLength": 1, "maxLength": 2048},
        "installed_at": {"type": ["string", "null"], "format": "date-time"},
        "managed_by": {"type": "string", "minLength": 1, "maxLength": 256},
        "update_policy": {"enum": ["pinned", "manual", "managed"]},
        "cleanup_policy": {"enum": ["none", "explicit-uninstall", "session-end", "ttl"]},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "owned_paths": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2048}, "uniqueItems": true},
        "owned_digests": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}}
      },
      "allOf": [
        {"if": {"properties": {"distribution_mode": {"const": "VENDORED"}}, "required": ["distribution_mode"]}, "then": {"properties": {"cleanup_policy": {"enum": ["none", "explicit-uninstall"]}}}},
        {"if": {"properties": {"distribution_mode": {"const": "EPHEMERAL"}}, "required": ["distribution_mode"]}, "then": {"properties": {"cleanup_policy": {"enum": ["session-end", "ttl"]}}}}
      ]
    },
    "delegation_base": {
      "type": "object", "additionalProperties": false, "required": ["repository", "ref", "revision"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
        "ref": {"type": "string", "minLength": 1, "maxLength": 512},
        "revision": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}
      }
    },
    "delegation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "task_id", "planning_base", "execution_base", "base_relationship", "plan_revision", "required_capabilities", "expected_outputs", "authority"],
      "properties": {
        "schema_version": {"const": 1},
        "task_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "attempt_id": {"type": ["string", "null"], "maxLength": 256},
        "planning_base": {"$ref": "#/$defs/delegation_base"},
        "execution_base": {"$ref": "#/$defs/delegation_base"},
        "base_relationship": {"enum": ["identical", "descendant", "rebased", "diverged", "unknown"]},
        "admission": {"enum": ["BASE_UNCHANGED", "BASE_ADVANCED_COMPATIBLE", "BASE_TOPOLOGY_CHANGED", "BASE_UNKNOWN"]},
        "plan_revision": {"type": "string", "minLength": 1, "maxLength": 256},
        "required_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 256}, "uniqueItems": true},
        "expected_outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
        "authority": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 512}, "uniqueItems": true},
        "child_job_id": {"type": ["string", "null"], "maxLength": 256},
        "continuation_of": {"type": ["string", "null"], "maxLength": 256},
        "continuation_delta": {"type": ["object", "null"]},
        "published_revision": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40}$"},
        "result": {"anyOf": [{"$ref": "#/$defs/action_outcome"}, {"type": "null"}]}
      }
    },
    "intent_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "ledger_id", "task_id", "revision", "requirements"],
      "properties": {
        "schema_version": {"const": 1},
        "ledger_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "task_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "revision": {"type": "integer", "minimum": 1},
        "requirements": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "statement", "origin", "kind", "state"],
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
              "statement": {"type": "string", "minLength": 1, "maxLength": 4096},
              "origin": {"enum": ["user_explicit", "user_attachment", "repository_contract", "derived", "clarified"]},
              "kind": {"enum": ["goal", "constraint", "acceptance", "scope", "safety", "preference", "non_goal"]},
              "state": {"enum": ["active", "satisfied", "superseded", "rejected", "blocked", "unknown"]},
              "superseded_by": {"type": ["string", "null"], "maxLength": 128},
              "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2048}, "uniqueItems": true}
            }
          }
        },
        "unresolved_conflicts": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
        "last_updated_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "diagnostic_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "observations", "hypotheses", "root_cause"],
      "properties": {
        "schema_version": {"const": 1},
        "observations": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "claim", "evidence_ref"],
            "properties": {
              "id": {"type": "string", "minLength": 1, "maxLength": 128},
              "claim": {"type": "string", "minLength": 1, "maxLength": 4096},
              "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 2048},
              "observed_at": {"type": ["string", "null"], "format": "date-time"},
              "runtime_identity": {"anyOf": [{"$ref": "#/$defs/runtime_identity"}, {"type": "null"}]},
              "classification": {"enum": ["FACT", "OBSERVATION"]}
            }
          }
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "claim", "status", "supporting_evidence", "contradicting_evidence", "next_discriminating_probe"],
            "properties": {
              "id": {"type": "string", "minLength": 1, "maxLength": 128},
              "claim": {"type": "string", "minLength": 1, "maxLength": 4096},
              "status": {"enum": ["active", "supported", "disproven", "unknown"]},
              "supporting_evidence": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2048}, "uniqueItems": true},
              "contradicting_evidence": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2048}, "uniqueItems": true},
              "next_discriminating_probe": {"type": ["string", "null"], "maxLength": 4096}
            }
          }
        },
        "root_cause": {
          "type": "object", "additionalProperties": false, "required": ["status", "hypothesis_id"],
          "properties": {"status": {"enum": ["proven", "suspected", "unknown"]}, "hypothesis_id": {"type": ["string", "null"], "maxLength": 128}}
        },
        "effective_config_provenance": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["component", "source", "status"],
            "properties": {
              "component": {"type": "string", "minLength": 1, "maxLength": 512},
              "source": {"type": "string", "minLength": 1, "maxLength": 2048},
              "status": {"enum": ["candidate", "runtime-proven", "contradicted", "unknown"]},
              "evidence_ref": {"type": ["string", "null"], "maxLength": 2048}
            }
          }
        }
      }
    }
  }
}
