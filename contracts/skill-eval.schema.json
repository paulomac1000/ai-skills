{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-skills:skill-eval:v1",
  "title": "AI Skills behavioral evaluation suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill", "suite", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "skill": {"type": "string", "minLength": 1},
    "suite": {"enum": ["routing", "behavior"]},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "prompt"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {
            "enum": [
              "positive",
              "negative",
              "collision",
              "representative",
              "regression"
            ]
          },
          "prompt": {"type": "string", "minLength": 1},
          "selected_skills": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "rejected_skills": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "baseline": {
            "enum": ["required", "optional", "not-applicable"]
          },
          "assertions": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1
          }
        }
      }
    }
  }
}
