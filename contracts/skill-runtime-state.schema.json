{
  "$id": "https://example.invalid/ai-skills/skill-runtime-state.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "observed_at": {"format": "date-time", "type": "string"},
    "runtime_id": {"minLength": 1, "type": "string"},
    "schema_version": {"const": 1},
    "skills": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "compatible": {"type": "boolean"},
          "distribution_mode": {"enum": ["GLOBAL", "VENDORED", "EPHEMERAL"]},
          "installed": {"type": "boolean"},
          "installed_artifact_digest": {"pattern": "^[a-f0-9]{64}$", "type": ["string", "null"]},
          "installed_revision": {"type": ["string", "null"]},
          "loaded_artifact_digest": {"pattern": "^[a-f0-9]{64}$", "type": ["string", "null"]},
          "loaded_revision": {"type": ["string", "null"]},
          "runtime_visible": {"type": "boolean"},
          "skill_id": {"minLength": 1, "type": "string"},
          "supported_load_modes": {"items": {"enum": ["runtime_tool", "preload", "vendored"]}, "type": "array", "uniqueItems": true}
        },
        "required": ["skill_id", "installed", "runtime_visible", "compatible", "supported_load_modes"],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": ["schema_version", "runtime_id", "observed_at", "skills"],
  "title": "Live skill runtime visibility state",
  "type": "object"
}
