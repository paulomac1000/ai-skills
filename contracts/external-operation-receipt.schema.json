{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paulomac1000.github.io/ai-skills/contracts/external-operation-receipt.schema.json",
  "title": "ExternalOperationReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operationId",
    "operationKind",
    "jobId",
    "lineageId",
    "generation",
    "attemptId",
    "jobVersion",
    "capabilityIdentity",
    "capabilityContractDigest",
    "targetIdentity",
    "candidateDigest",
    "requestDigest",
    "state",
    "delivery",
    "retryDisposition",
    "credentialSlotId",
    "createdAt",
    "observedAt",
    "retryCount",
    "reconcileCount"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "operationId": {
      "type": "string",
      "minLength": 1
    },
    "operationKind": {
      "enum": [
        "submit",
        "cancel",
        "mutation",
        "readback"
      ]
    },
    "jobId": {
      "type": "string",
      "minLength": 1
    },
    "lineageId": {
      "type": "string",
      "minLength": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "attemptId": {
      "type": "string",
      "minLength": 1
    },
    "capabilityIdentity": {
      "type": "string",
      "minLength": 1
    },
    "capabilityContractDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "targetIdentity": {
      "type": "string",
      "minLength": 1
    },
    "candidateDigest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "idempotencyKeyDigest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "mutationDecisionRef": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "state": {
      "enum": [
        "reserved",
        "dispatching",
        "dispatched",
        "running",
        "result-ready",
        "captured",
        "reconciled",
        "failed",
        "abandoned",
        "expired"
      ]
    },
    "delivery": {
      "enum": [
        "not-delivered",
        "delivered",
        "delivery-unknown",
        "provider-rejected"
      ]
    },
    "retryDisposition": {
      "enum": [
        "forbidden",
        "eligible",
        "reconcile-first"
      ]
    },
    "remoteHandle": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000
    },
    "credentialSlotId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "providerIdentity": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "retryCount": {
      "type": "integer",
      "minimum": 0
    },
    "reconcileCount": {
      "type": "integer",
      "minimum": 0
    },
    "nextRetryAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "nextReconcileAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "failureClass": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120
    },
    "jobVersion": {
      "type": "integer",
      "minimum": 0
    },
    "semanticSlot": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200,
      "description": "Semantic work-slot identity (stage/criterion/work item) this operation fulfils; two distinct slots with byte-identical payloads remain distinct operations."
    },
    "operationDeadlineAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Durable absolute operation deadline; nested bounds must be clamped to the remaining time and restart must not reset it."
    },
    "cancellationCause": {
      "enum": [
        "caller_cancel",
        "parent_superseded",
        "service_shutdown",
        "application_deadline",
        "transport_timeout",
        "provider_cancel",
        "unknown",
        null
      ],
      "description": "Why the operation stopped or was stopped; a mechanism is not provenance."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operationKind": {"enum": ["submit", "cancel", "mutation"]},
          "state": {"enum": ["dispatching", "dispatched", "running", "result-ready", "captured", "reconciled"]}
        },
        "required": ["operationKind", "state"]
      },
      "then": {
        "required": ["mutationDecisionRef", "semanticSlot", "operationDeadlineAt"],
        "properties": {
          "mutationDecisionRef": {"type": "string", "minLength": 1},
          "semanticSlot": {"type": "string", "minLength": 1},
          "operationDeadlineAt": {"type": "string", "format": "date-time"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "operationKind": {"enum": ["submit", "cancel", "mutation"]},
          "state": {"enum": ["reserved"]}
        },
        "required": ["operationKind", "state"]
      },
      "then": {
        "required": ["semanticSlot", "operationDeadlineAt"],
        "properties": {
          "semanticSlot": {"type": "string", "minLength": 1},
          "operationDeadlineAt": {"type": "string", "format": "date-time"}
        }
      }
    }
  ]
}
