{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/paulomac1000/ai-skills/raw/main/contracts/adoption-assessment.schema.json",
  "title": "AI Skills adoption assessment",
  "type": "object",
  "$defs": {
    "identity": {
      "type": "object",
      "required": [
        "provider",
        "login",
        "id"
      ],
      "properties": {
        "provider": {
          "const": "github"
        },
        "login": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
        },
        "id": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "fullSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "actionEvidence": {
      "type": "object",
      "required": [
        "provider",
        "repository",
        "run_id",
        "job_id",
        "revision"
      ],
      "properties": {
        "provider": {
          "const": "github-actions"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "run_id": {
          "type": "integer",
          "minimum": 1
        },
        "job_id": {
          "type": "integer",
          "minimum": 1
        },
        "artifact_id": {
          "type": "integer",
          "minimum": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "provider_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "combination": {
      "type": "object",
      "required": [
        "operating_system",
        "architecture",
        "runtime",
        "version",
        "lane"
      ],
      "properties": {
        "operating_system": {
          "enum": [
            "linux",
            "macos",
            "windows"
          ]
        },
        "architecture": {
          "enum": [
            "x64",
            "arm64"
          ]
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "lane": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      },
      "additionalProperties": false
    },
    "implementation": {
      "type": "object",
      "required": [
        "path",
        "symbol"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": [
        "command",
        "evidence",
        "result"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/actionEvidence"
        },
        "result": {
          "enum": [
            "passed",
            "failed",
            "not-run"
          ]
        }
      },
      "additionalProperties": false
    },
    "transportCheck": {
      "type": "object",
      "required": [
        "result",
        "evidence"
      ],
      "properties": {
        "result": {
          "enum": [
            "passed",
            "not-applicable",
            "failed",
            "not-run"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/actionEvidence"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "verification_mode",
    "assessment_id",
    "generated_at",
    "prepared_by",
    "repository",
    "skill",
    "scope",
    "compatibility_claims",
    "applicability",
    "behavior",
    "waivers",
    "artifact_verification",
    "compatibility_results",
    "extensions",
    "rollback",
    "residual_risks",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "verification_mode": {
      "enum": [
        "structural-attestation",
        "provider-backed"
      ]
    },
    "assessment_id": {
      "type": "string",
      "minLength": 3
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "prepared_by": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identity"
      }
    },
    "repository": {
      "type": "object",
      "required": [
        "name",
        "revision",
        "source_branch"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "revision": {
          "$ref": "#/$defs/fullSha"
        },
        "source_branch": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "skill": {
      "type": "object",
      "required": [
        "name",
        "version",
        "maturity"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "maturity": {
          "enum": [
            "experimental",
            "release-candidate",
            "stable",
            "deprecated"
          ]
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": [
        "included",
        "excluded",
        "exclusion_rationale"
      ],
      "properties": {
        "included": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclusion_rationale": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "compatibility_claims": {
      "type": "object",
      "required": [
        "combinations"
      ],
      "properties": {
        "combinations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/combination"
          }
        }
      },
      "additionalProperties": false
    },
    "applicability": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "status",
          "rationale",
          "implementation",
          "verification",
          "waiver_id"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
          },
          "status": {
            "enum": [
              "applicable",
              "not-applicable",
              "deferred"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "implementation": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/implementation"
            }
          },
          "verification": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/verification"
            }
          },
          "waiver_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "applicable"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "implementation": {
                  "minItems": 1
                },
                "verification": {
                  "minItems": 1
                },
                "waiver_id": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "deferred"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "waiver_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "behavior": {
      "type": "object",
      "required": [
        "preserved",
        "intentionally_changed",
        "removed_legacy"
      ],
      "properties": {
        "preserved": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "intentionally_changed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "removed_legacy": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "waiver_id",
          "rule_id",
          "owner",
          "rationale",
          "compensating_controls",
          "expires_at"
        ],
        "properties": {
          "waiver_id": {
            "type": "string",
            "minLength": 1
          },
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "compensating_controls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expires_at": {
            "type": "string",
            "format": "date"
          }
        },
        "additionalProperties": false
      }
    },
    "artifact_verification": {
      "type": "object",
      "required": [
        "exact_revision",
        "artifacts"
      ],
      "properties": {
        "exact_revision": {
          "$ref": "#/$defs/fullSha"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "identity",
              "path",
              "digest",
              "commands",
              "evidence",
              "result"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "identity": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "commands": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "evidence": {
                "allOf": [
                  {
                    "$ref": "#/$defs/actionEvidence"
                  },
                  {
                    "required": [
                      "artifact_id",
                      "provider_digest"
                    ]
                  }
                ]
              },
              "result": {
                "enum": [
                  "passed",
                  "failed",
                  "not-run"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "compatibility_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "operating_system",
          "architecture",
          "runtime",
          "version",
          "lane",
          "command",
          "evidence",
          "result"
        ],
        "properties": {
          "operating_system": {
            "enum": [
              "linux",
              "macos",
              "windows"
            ]
          },
          "architecture": {
            "enum": [
              "x64",
              "arm64"
            ]
          },
          "runtime": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "lane": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "$ref": "#/$defs/actionEvidence"
          },
          "result": {
            "enum": [
              "passed",
              "failed",
              "not-run"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object",
      "properties": {
        "mcp": {
          "type": "object",
          "required": [
            "target_level",
            "profiles",
            "advertised_transports",
            "official_client_commands",
            "transport_results"
          ],
          "properties": {
            "target_level": {
              "enum": [
                "L1",
                "L2",
                "L3",
                "L4"
              ]
            },
            "profiles": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "advertised_transports": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "stdio",
                  "streamable_http"
                ]
              }
            },
            "official_client_commands": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "transport_results": {
              "type": "object",
              "properties": {
                "stdio": {
                  "type": "object",
                  "required": [
                    "capability_listing",
                    "representative_read",
                    "failure_path",
                    "write_boundary"
                  ],
                  "properties": {
                    "capability_listing": {
                      "$ref": "#/$defs/transportCheck"
                    },
                    "representative_read": {
                      "$ref": "#/$defs/transportCheck"
                    },
                    "failure_path": {
                      "$ref": "#/$defs/transportCheck"
                    },
                    "write_boundary": {
                      "$ref": "#/$defs/transportCheck"
                    }
                  },
                  "additionalProperties": false
                },
                "streamable_http": {
                  "type": "object",
                  "required": [
                    "capability_listing",
                    "representative_read",
                    "failure_path",
                    "write_boundary"
                  ],
                  "properties": {
                    "capability_listing": {
                      "$ref": "#/$defs/transportCheck"
                    },
                    "representative_read": {
                      "$ref": "#/$defs/transportCheck"
                    },
                    "failure_path": {
                      "$ref": "#/$defs/transportCheck"
                    },
                    "write_boundary": {
                      "$ref": "#/$defs/transportCheck"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "rollback": {
      "type": "object",
      "required": [
        "trigger_conditions",
        "procedure",
        "data_recovery"
      ],
      "properties": {
        "trigger_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "procedure": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "data_recovery": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "risk",
          "owner",
          "mitigation",
          "blocking"
        ],
        "properties": {
          "risk": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "mitigation": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "status",
        "rationale",
        "reviewer"
      ],
      "properties": {
        "status": {
          "enum": [
            "approve",
            "request-changes",
            "rejected"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "object",
          "required": [
            "provider",
            "repository",
            "pull_request",
            "review_id",
            "login",
            "id",
            "revision",
            "state"
          ],
          "properties": {
            "provider": {
              "const": "github"
            },
            "repository": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "pull_request": {
              "type": "integer",
              "minimum": 1
            },
            "review_id": {
              "type": "integer",
              "minimum": 1
            },
            "login": {
              "type": "string",
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
            },
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "revision": {
              "$ref": "#/$defs/fullSha"
            },
            "state": {
              "enum": [
                "APPROVED",
                "CHANGES_REQUESTED",
                "COMMENTED",
                "DISMISSED"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
