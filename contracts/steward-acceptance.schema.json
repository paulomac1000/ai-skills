{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paulomac1000.github.io/ai-skills/contracts/steward-acceptance.schema.json",
  "title": "StewardAcceptancePlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "acceptance_id",
    "revision",
    "claim_class",
    "required_lanes",
    "independent_required",
    "live_full_path_required",
    "exact_artifact"
  ],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "acceptance_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "claim_class": {"enum": ["structural", "production-workflow"]},
    "required_lanes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "implementer",
          "canonical-full",
          "fault-restart",
          "inherited-mcp",
          "independent-delta",
          "exact-artifact",
          "live-full-path"
        ]
      }
    },
    "independent_required": {"type": "boolean"},
    "live_full_path_required": {"type": "boolean"},
    "exact_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_path_required",
        "runtime_prerequisites_declared",
        "restart_boundary_required"
      ],
      "properties": {
        "full_path_required": {"type": "boolean"},
        "runtime_prerequisites_declared": {"type": "boolean"},
        "restart_boundary_required": {"type": "boolean"}
      }
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_reachability_required",
        "liveness_closure_required",
        "real_producer_success_and_rejection_required",
        "canonical_checkpoint_reuse_required",
        "minimum_recomputation_required",
        "transcript_independent_restart_required"
      ],
      "properties": {
        "producer_reachability_required": {"const": true},
        "liveness_closure_required": {"const": true},
        "real_producer_success_and_rejection_required": {"const": true},
        "canonical_checkpoint_reuse_required": {"const": true},
        "minimum_recomputation_required": {"const": true},
        "transcript_independent_restart_required": {"const": true}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": 2}}, "required": ["schema_version"]},
      "then": {"required": ["closure"]}
    }
  ]
}
