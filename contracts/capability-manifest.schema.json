{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/paulomac1000/ai-skills/blob/main/contracts/capability-manifest.schema.json",
  "title": "MCP capability manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_revision",
    "id",
    "name",
    "description",
    "operation_kind",
    "risk",
    "determinism",
    "latency",
    "impact",
    "active_state",
    "retryable",
    "idempotent",
    "reversible",
    "requires_confirmation",
    "idempotency_key_required",
    "idempotency",
    "async_model",
    "outcome_contract",
    "reconciliation",
    "publication",
    "result_bounded",
    "runtime_identity",
    "authorization_scopes",
    "concurrency",
    "max_response_bytes"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "contract_revision": {"type": "integer", "minimum": 2},
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "name": {"type": "string", "minLength": 1, "maxLength": 256},
    "description": {"type": "string", "minLength": 1, "maxLength": 4096},
    "operation_kind": {"enum": ["read", "write", "destructive"]},
    "risk": {"enum": ["low", "medium", "high", "critical"]},
    "determinism": {"enum": ["deterministic", "environment-dependent", "nondeterministic"]},
    "latency": {"enum": ["interactive", "bounded-long", "background"]},
    "impact": {"enum": ["none", "local", "external"]},
    "active_state": {"enum": ["active", "inactive", "deprecated"]},
    "retryable": {"type": "boolean"},
    "idempotent": {"type": "boolean"},
    "reversible": {"type": "boolean"},
    "requires_confirmation": {"type": "boolean"},
    "idempotency_key_required": {"type": "boolean"},
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "scope"],
      "properties": {
        "mode": {"enum": ["none", "intrinsic", "keyed"]},
        "scope": {"enum": ["invocation", "target", "resource", "principal-target", "custom"]}
      }
    },
    "async_model": {"enum": ["synchronous", "task", "stream", "external-job"]},
    "outcome_contract": {"enum": ["simple", "layered"]},
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "required_after_ambiguous_dispatch", "method"],
      "properties": {
        "supported": {"type": "boolean"},
        "required_after_ambiguous_dispatch": {"type": "boolean"},
        "method": {"enum": ["none", "operation-status", "authoritative-read", "external-state", "custom"]}
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "implies_verification"],
      "properties": {
        "model": {"enum": ["none", "inline", "artifact", "external"]},
        "implies_verification": {"type": "boolean"}
      }
    },
    "result_bounded": {"const": true},
    "runtime_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "level"],
      "properties": {
        "supported": {"type": "boolean"},
        "level": {"enum": ["none", "artifact", "artifact-and-generation"]}
      }
    },
    "authorization_scopes": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 256}, "uniqueItems": true},
    "concurrency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "limit", "queue_limit"],
      "properties": {
        "scope": {"enum": ["global", "capability", "principal", "target", "principal-target"]},
        "limit": {"type": "integer", "minimum": 1, "maximum": 10000},
        "queue_limit": {"type": "integer", "minimum": 0, "maximum": 100000}
      }
    },
    "max_response_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enforcement", "record_required", "record_ttl_seconds", "binds"],
      "properties": {
        "enforcement": {"const": "server-side"},
        "record_required": {"const": true},
        "record_ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "binds": {
          "type": "array",
          "items": {"enum": ["principal", "capability", "target", "arguments-digest", "expires-at"]},
          "uniqueItems": true,
          "allOf": [
            {"contains": {"const": "principal"}},
            {"contains": {"const": "capability"}},
            {"contains": {"const": "target"}},
            {"contains": {"const": "arguments-digest"}},
            {"contains": {"const": "expires-at"}}
          ]
        }
      }
    },
    "protocol_revisions": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 128}, "uniqueItems": true},
    "extensions": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"operation_kind": {"enum": ["write", "destructive"]}}, "required": ["operation_kind"]},
      "then": {"properties": {"authorization_scopes": {"minItems": 1}, "impact": {"enum": ["local", "external"]}}}
    },
    {
      "if": {"properties": {"operation_kind": {"const": "destructive"}}, "required": ["operation_kind"]},
      "then": {"properties": {"requires_confirmation": {"const": true}, "risk": {"enum": ["high", "critical"]}}}
    },
    {
      "if": {"properties": {"retryable": {"const": true}}, "required": ["retryable"]},
      "then": {"properties": {"idempotent": {"const": true}}}
    },
    {
      "if": {"properties": {"retryable": {"const": true}, "operation_kind": {"enum": ["write", "destructive"]}}, "required": ["retryable", "operation_kind"]},
      "then": {"properties": {"idempotency_key_required": {"const": true}}}
    },
    {
      "if": {"properties": {"requires_confirmation": {"const": true}}, "required": ["requires_confirmation"]},
      "then": {"required": ["approval"]}
    },
    {
      "if": {"properties": {"idempotent": {"const": true}}, "required": ["idempotent"]},
      "then": {"properties": {"idempotency": {"properties": {"mode": {"enum": ["intrinsic", "keyed"]}}}}}
    },
    {
      "if": {"properties": {"idempotent": {"const": false}}, "required": ["idempotent"]},
      "then": {"properties": {"idempotency": {"properties": {"mode": {"const": "none"}}}}}
    },
    {
      "if": {"properties": {"idempotency_key_required": {"const": true}}, "required": ["idempotency_key_required"]},
      "then": {"properties": {"idempotency": {"properties": {"mode": {"const": "keyed"}}}}}
    },
    {
      "if": {"properties": {"reconciliation": {"properties": {"supported": {"const": false}}, "required": ["supported"]}}, "required": ["reconciliation"]},
      "then": {"properties": {"reconciliation": {"properties": {"method": {"const": "none"}}}}}
    },
    {
      "if": {"properties": {"reconciliation": {"properties": {"supported": {"const": true}}, "required": ["supported"]}}, "required": ["reconciliation"]},
      "then": {"properties": {"reconciliation": {"properties": {"method": {"enum": ["operation-status", "authoritative-read", "external-state", "custom"]}}}}}
    },
    {
      "if": {"properties": {"operation_kind": {"enum": ["write", "destructive"]}, "idempotent": {"const": false}}, "required": ["operation_kind", "idempotent"]},
      "then": {"properties": {"reconciliation": {"properties": {"required_after_ambiguous_dispatch": {"const": true}}}}}
    },
    {
      "if": {"properties": {"runtime_identity": {"properties": {"supported": {"const": false}}, "required": ["supported"]}}, "required": ["runtime_identity"]},
      "then": {"properties": {"runtime_identity": {"properties": {"level": {"const": "none"}}}}}
    },
    {
      "if": {"properties": {"runtime_identity": {"properties": {"supported": {"const": true}}, "required": ["supported"]}}, "required": ["runtime_identity"]},
      "then": {"properties": {"runtime_identity": {"properties": {"level": {"enum": ["artifact", "artifact-and-generation"]}}}}}
    },
    {
      "if": {"properties": {"operation_kind": {"const": "read"}}, "required": ["operation_kind"]},
      "then": {"properties": {"impact": {"const": "none"}, "idempotent": {"const": true}, "reversible": {"const": false}, "requires_confirmation": {"const": false}, "idempotency_key_required": {"const": false}, "idempotency": {"properties": {"mode": {"const": "intrinsic"}}}}}
    },
    {
      "if": {"properties": {"active_state": {"enum": ["inactive", "deprecated"]}}, "required": ["active_state"]},
      "then": {"properties": {"retryable": {"const": false}}}
    }
  ]
}
