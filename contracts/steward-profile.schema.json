{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paulomac1000.github.io/ai-skills/contracts/steward-profile.schema.json",
  "title": "StewardProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "steward", "contracts", "features", "authority", "subject_identity", "durability", "external_operations", "mutation_admission", "credentials", "model", "completion", "observability"],
  "properties": {
    "schema_version": {"const": 2},
    "steward": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "contract_revision"], "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"enum": ["generic", "diagnostic", "verification", "research-evidence", "release-ops", "change-manager"]}, "contract_revision": {"type": "integer", "minimum": 1}}},
    "contracts": {"type": "object", "additionalProperties": false, "required": ["state_machine", "mutation_policy", "proof_recipe", "acceptance"], "properties": {"state_machine": {"type": "string", "minLength": 1}, "mutation_policy": {"type": "string", "minLength": 1}, "proof_recipe": {"type": "string", "minLength": 1}, "acceptance": {"type": "string", "minLength": 1}}},
    "features": {"type": "object", "additionalProperties": false, "required": ["durable_external_async", "causal_claims", "external_cancellation", "negative_aggregate_claims", "proof_producers", "runtime_binding_required", "exact_candidate_binding"], "properties": {"durable_external_async": {"type": "boolean"}, "causal_claims": {"type": "boolean"}, "external_cancellation": {"type": "boolean"}, "negative_aggregate_claims": {"type": "boolean"}, "proof_producers": {"type": "boolean"}, "runtime_binding_required": {"type": "boolean"}, "exact_candidate_binding": {"type": "boolean"}}},
    "authority": {"type": "object", "additionalProperties": false, "required": ["owns", "observes", "may_mutate", "verifies", "parent_completion", "never_claims"], "properties": {"owns": {"$ref": "#/$defs/stringSet"}, "observes": {"$ref": "#/$defs/stringSet"}, "may_mutate": {"$ref": "#/$defs/stringSet"}, "verifies": {"$ref": "#/$defs/stringSet"}, "parent_completion": {"enum": ["none", "explicit-contract-only"]}, "never_claims": {"$ref": "#/$defs/stringSet"}}},
    "subject_identity": {"type": "object", "additionalProperties": false, "required": ["required_dimensions", "freshness_dimensions", "candidate_dimensions", "candidate_required_for_publication"], "properties": {"required_dimensions": {"$ref": "#/$defs/nonEmptyStringSet"}, "freshness_dimensions": {"$ref": "#/$defs/stringSet"}, "candidate_dimensions": {"$ref": "#/$defs/stringSet"}, "candidate_required_for_publication": {"type": "boolean"}}},
    "durability": {"type": "object", "additionalProperties": false, "required": ["profile", "crash_model", "transactional_store_required", "lineage_fencing", "attempt_fencing", "recovery_equivalence_required"], "properties": {"profile": {"enum": ["constrained-file", "single-node-durable", "multi-worker-durable"]}, "crash_model": {"$ref": "#/$defs/nonEmptyStringSet"}, "transactional_store_required": {"type": "boolean"}, "lineage_fencing": {"const": true}, "attempt_fencing": {"const": true}, "recovery_equivalence_required": {"const": true}}},
    "external_operations": {"type": "object", "additionalProperties": false, "required": ["receipt_before_stateful_dispatch", "ambiguous_delivery", "cancellation_reconciliation_required", "worker_wait_policy"], "properties": {"receipt_before_stateful_dispatch": {"const": true}, "ambiguous_delivery": {"const": "reconcile-before-retry"}, "cancellation_reconciliation_required": {"type": "boolean"}, "worker_wait_policy": {"enum": ["inline-bounded", "external-maintenance"]}}},
    "mutation_admission": {"type": "object", "additionalProperties": false, "required": ["authority_values_non_defaultable", "durable_pre_dispatch_commit", "budget_reservation_required"], "properties": {"authority_values_non_defaultable": {"const": true}, "durable_pre_dispatch_commit": {"const": true}, "budget_reservation_required": {"const": true}}},
    "credentials": {"type": "object", "additionalProperties": false, "required": ["secret_source", "persist_secret", "fallback"], "properties": {"secret_source": {"type": "string", "minLength": 1}, "persist_secret": {"const": false}, "fallback": {"type": "object", "additionalProperties": false, "required": ["enabled", "preserve_principal_scope", "preserve_target"], "properties": {"enabled": {"type": "boolean"}, "preserve_principal_scope": {"const": true}, "preserve_target": {"const": true}}}}},
    "model": {"type": "object", "additionalProperties": false, "required": ["authority_ceiling"], "properties": {"authority_ceiling": {"enum": ["none", "advisory"]}}},
    "completion": {"type": "object", "additionalProperties": false, "required": ["obligations", "handoff_digest"], "properties": {"obligations": {"type": "array", "maxItems": 256, "items": {"type": "object", "additionalProperties": false, "required": ["id", "required", "evidence_class"], "properties": {"id": {"type": "string", "minLength": 1}, "required": {"type": "boolean"}, "evidence_class": {"type": "string", "minLength": 1}}}}, "handoff_digest": {"const": "sha256"}}},
    "observability": {"type": "object", "additionalProperties": false, "required": ["durable_timeline", "doctor"], "properties": {"durable_timeline": {"const": true}, "doctor": {"type": "boolean"}}}
  },
  "$defs": {
    "stringSet": {"type": "array", "uniqueItems": true, "maxItems": 256, "items": {"type": "string", "minLength": 1}},
    "nonEmptyStringSet": {"type": "array", "uniqueItems": true, "minItems": 1, "maxItems": 256, "items": {"type": "string", "minLength": 1}}
  }
}
