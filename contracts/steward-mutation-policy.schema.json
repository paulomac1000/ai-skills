{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paulomac1000.github.io/ai-skills/contracts/steward-mutation-policy.schema.json",
  "title": "StewardMutationPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "revision",
    "effects"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/effect"
      }
    }
  },
  "$defs": {
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operation_kind",
        "transition",
        "authority_source",
        "lease_required",
        "subject_dimensions",
        "candidate_required",
        "capability_ref",
        "capability_contract",
        "durable_operation_required",
        "pre_dispatch_commit_required",
        "budget_reservation_required",
        "minimum_budget_ms",
        "finalization_reserve_ms",
        "ambiguity_disposition",
        "typed_outcomes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "transition": {
          "type": "string",
          "minLength": 1
        },
        "authority_source": {
          "type": "string",
          "minLength": 1
        },
        "lease_required": {
          "type": "boolean"
        },
        "subject_dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "candidate_required": {
          "type": "boolean"
        },
        "capability_ref": {
          "type": "string",
          "minLength": 1
        },
        "durable_operation_required": {
          "type": "boolean"
        },
        "pre_dispatch_commit_required": {
          "type": "boolean"
        },
        "budget_reservation_required": {
          "type": "boolean"
        },
        "minimum_budget_ms": {
          "type": "integer",
          "minimum": 0
        },
        "ambiguity_disposition": {
          "enum": [
            "block",
            "reconcile",
            "compensate",
            "none"
          ]
        },
        "typed_outcomes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "operation_kind": {
          "enum": [
            "submit",
            "cancel",
            "publication",
            "mutation"
          ]
        },
        "capability_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "id",
            "revision",
            "digest_semantics",
            "digest"
          ],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "digest_semantics": {
              "const": "capability-semantic-v1"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "finalization_reserve_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
